{
  "activity": "InsertColumnX",
  "package": "UiPath.Excel.Activities",
  "coded": [
    {
      "call": "{Range}.InsertColumn",
      "args": {
        "columnName": "{RelativeColumnName}",
        "position": "UiPath.Excel.ColumnRelativePosition.{RelativePosition:-Before}",
        "hasHeaders": "{HasHeaders:-true}",
        "newColumnHeader": "{NewColumnName:-null}",
        "columnFormat": "{ColumnFormat:-null}"
      },
      "usings": [
        "UiPath.Excel.Activities.API"
      ]
    }
  ],
  "notes": "ColumnFormat（ICellFormat）は IR の objs で書く（$type で実装を選ぶ。FormatRangeX.Format と同じ。例 InsertColumnX.format.json）。IR に無いときは null"
}
