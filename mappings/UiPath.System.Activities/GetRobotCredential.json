{
  "activity": "GetRobotCredential",
  "package": "UiPath.System.Activities",
  "coded": [
    {
      "when": [
        "AssetName",
        "FolderPath",
        "CacheStrategy",
        "TimeoutMS",
        "Username",
        "Password"
      ],
      "usings": [
        "System.Security"
      ],
      "code": "({Username}, {Password}) = system.GetCredential(assetName: {AssetName}, folderPath: {FolderPath}, timeoutMS: {TimeoutMS}, cacheStrategy: UiPath.Core.Activities.CacheStrategyEnum.{CacheStrategy});"
    },
    {
      "when": [
        "AssetName",
        "Username",
        "Password"
      ],
      "usings": [
        "System.Security"
      ],
      "code": "({Username}, {Password}) = system.GetCredential(assetName: {AssetName});"
    }
  ],
  "ignore": [
    "BindingsKey"
  ],
  "notes": "ISystemService.GetCredential は (string, SecureString) のタプルを返す（out 引数の形は Coded で使えない）ので、分解代入で Username と Password に入れる。"
}
