{
  "activity": "GetRobotCredential",
  "package": "UiPath.System.Activities",
  "coded": [
    {
      "when": [
        "AssetName",
        "FolderPath",
        "CacheStrategy",
        "TimeoutMS",
        "Username",
        "Password"
      ],
      "usings": [
        "System.Security"
      ],
      "code": "({Username}, {Password}) = system.GetCredential(assetName: {AssetName}, folderPath: {FolderPath}, timeoutMS: {TimeoutMS}, cacheStrategy: UiPath.Core.Activities.CacheStrategyEnum.{CacheStrategy});"
    },
    {
      "when": [
        "AssetName",
        "FolderPath",
        "Username",
        "Password"
      ],
      "usings": [
        "System.Security"
      ],
      "code": "({Username}, {Password}) = system.GetCredential(assetName: {AssetName}, folderPath: {FolderPath}, timeoutMS: {TimeoutMS:-30000}, cacheStrategy: UiPath.Core.Activities.CacheStrategyEnum.{CacheStrategy:-None});"
    },
    {
      "when": [
        "AssetName",
        "Username",
        "Password"
      ],
      "usings": [
        "System.Security"
      ],
      "code": "({Username}, {Password}) = system.GetCredential(assetName: {AssetName});"
    }
  ],
  "ignore": [
    "BindingsKey"
  ],
  "notes": "ISystemService.GetCredential は (string, SecureString) のタプルを返す（out 引数の形は Coded で使えない）ので、分解代入で Username と Password に入れる。 Studio は TimeoutMS を書かない（{x:Null}）。そのときアクティビティは 30 秒待つが、ISystemService.GetCredential の timeoutMS の既定は 1000 ミリ秒で、Orchestrator からの取得が間に合わず TimeoutException になった（moneyforward_cs の Login で確かめた）。TimeoutMS が無いときは 30000 を渡す。"
}
