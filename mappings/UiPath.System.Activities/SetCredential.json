{
  "activity": "SetCredential",
  "package": "UiPath.System.Activities",
  "coded": [
    {
      "when": [
        "SecurePassword",
        "FolderPath",
        "TimeoutMS"
      ],
      "usings": [
        "System.Net",
        "System.Security"
      ],
      "call": "system.SetCredential",
      "args": {
        "userName": "{UserName}",
        "password": "new NetworkCredential(string.Empty, {SecurePassword}).Password",
        "credentialName": "{CredentialName}",
        "folderPath": "{FolderPath}",
        "timeoutMS": "{TimeoutMS}"
      }
    },
    {
      "when": [
        "SecurePassword"
      ],
      "usings": [
        "System.Net",
        "System.Security"
      ],
      "call": "system.SetCredential",
      "args": {
        "userName": "{UserName}",
        "password": "new NetworkCredential(string.Empty, {SecurePassword}).Password",
        "credentialName": "{CredentialName}"
      }
    },
    {
      "when": [
        "Password",
        "FolderPath",
        "TimeoutMS"
      ],
      "call": "system.SetCredential",
      "args": {
        "userName": "{UserName}",
        "password": "{Password}",
        "credentialName": "{CredentialName}",
        "folderPath": "{FolderPath}",
        "timeoutMS": "{TimeoutMS}"
      }
    },
    {
      "when": [
        "Password",
        "FolderPath"
      ],
      "call": "system.SetCredential",
      "args": {
        "userName": "{UserName}",
        "password": "{Password}",
        "credentialName": "{CredentialName}",
        "folderPath": "{FolderPath}"
      }
    },
    {
      "when": [
        "Password"
      ],
      "call": "system.SetCredential",
      "args": {
        "userName": "{UserName}",
        "password": "{Password}",
        "credentialName": "{CredentialName}"
      }
    }
  ],
  "ignore": [
    "BindingsKey"
  ],
  "notes": "Coded の password は string。SecurePassword は NetworkCredential で文字列に戻して渡す。"
}
