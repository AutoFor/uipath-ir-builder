{
  "activity": "NGetClipboard",
  "package": "UiPath.UIAutomation.Activities",
  "coded": [
    {
      "call": "uiAutomation.GetClipboard",
      "usings": [
        "UiPath.UIAutomationNext.API.Models",
        "UiPath.UIAutomationNext.Enums"
      ],
      "returns": "Result",
      "args": {
        "options": {
          "new": "GetClipboardOptions",
          "always": true,
          "set": {
            "Timeout": "{Timeout}",
            "DelayAfter": "{DelayAfter}",
            "DelayBefore": "{DelayBefore}",
            "HealingAgentBehavior": "{HealingAgentBehavior|enum}"
          }
        }
      }
    }
  ],
  "ignore": [
    "ScopeIdentifier",
    "Version",
    "Target"
  ],
  "notes": "クリップボードはターゲットを使わないので Target は捨てる（uiAutomation のサービスを直接呼ぶ）"
}
