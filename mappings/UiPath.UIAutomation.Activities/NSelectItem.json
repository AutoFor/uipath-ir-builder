{
  "activity": "NSelectItem",
  "package": "UiPath.UIAutomation.Activities",
  "coded": [
    {
      "call": "{app}.SelectItem",
      "usings": [
        "UiPath.UIAutomationNext.API.Models",
        "UiPath.UIAutomationNext.Enums"
      ],
      "args": {
        "target": "{Target}",
        "selectItemOptions": {
          "new": "SelectItemOptions",
          "always": true,
          "set": {
            "Item": "{Item}",
            "AlterIfDisabled": "{AlterIfDisabled}",
            "Timeout": "{Timeout}",
            "DelayAfter": "{DelayAfter}",
            "DelayBefore": "{DelayBefore}",
            "HealingAgentBehavior": "{HealingAgentBehavior|enum}"
          }
        }
      }
    }
  ],
  "notes": "OutUiElement と InUiElement はまだ扱わない。Items は Browsable(false) の一覧で、入力は Item。Coded のオプションには Item（単数）しか無いので捨てる",
  "ignore": [
    "ScopeIdentifier",
    "Version",
    "Items"
  ]
}
