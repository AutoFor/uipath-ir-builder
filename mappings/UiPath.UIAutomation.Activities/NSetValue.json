{
  "activity": "NSetValue",
  "package": "UiPath.UIAutomation.Activities",
  "coded": [
    {
      "call": "{app}.SetValue",
      "usings": ["UiPath.UIAutomationNext.API.Models", "UiPath.UIAutomationNext.Enums"],
      "args": {
        "target": "{Target}",
        "setValueOptions": {
          "new": "SetValueOptions",
          "always": true,
          "set": { "Value": "{Value}", "EnableValidation": "{EnableValidation}" }
        }
      }
    }
  ],
  "notes": "UiTargetApp.SetValue(target, SetValueOptions)。セマンティック（クラウドの AI）が要るので run していない（Coded が動くかは未確認）。AgentType / InteractionMode / Timeout / DelayBefore / DelayAfter / HealingAgentBehavior は Coded 未対応",
  "ignore": ["ScopeIdentifier","Version","Timeout","DelayBefore","DelayAfter","HealingAgentBehavior","AgentType","InteractionMode"]
}
