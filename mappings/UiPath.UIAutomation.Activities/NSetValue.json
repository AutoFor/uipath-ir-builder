{
  "activity": "NSetValue",
  "package": "UiPath.UIAutomation.Activities",
  "coded": [
    {
      "call": "{app}.SetValue",
      "usings": [
        "UiPath.UIAutomationNext.API.Models",
        "UiPath.UIAutomationNext.Enums"
      ],
      "args": {
        "target": "{Target}",
        "setValueOptions": {
          "new": "SetValueOptions",
          "always": true,
          "set": {
            "Value": "{Value}",
            "EnableValidation": "{EnableValidation}",
            "Timeout": "{Timeout}",
            "DelayBefore": "{DelayBefore}",
            "DelayAfter": "{DelayAfter}",
            "ContinueOnError": "{ContinueOnError}",
            "HealingAgentBehavior": "{HealingAgentBehavior|enum}"
          }
        }
      }
    }
  ],
  "notes": "UiTargetApp.SetValue(target, SetValueOptions)。Target は TargetType=SemanticBased が要る（XAML で無いと build が「No data is available for the selected targeting methods」で落ちる）。クラウドの AI が要るので run していない（Coded が動くかは未確認）。AgentType / InteractionMode は SetValueOptions に無い",
  "ignore": [
    "ScopeIdentifier",
    "Version",
    "AgentType",
    "InteractionMode"
  ]
}
