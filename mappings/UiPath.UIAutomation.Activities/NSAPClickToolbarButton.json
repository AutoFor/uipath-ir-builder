{
  "activity": "NSAPClickToolbarButton",
  "package": "UiPath.UIAutomation.Activities",
  "coded": [
    {
      "call": "{app}.SAPClickToolbarButton",
      "usings": [
        "UiPath.UIAutomationNext.API.Models",
        "UiPath.UIAutomationNext.Enums"
      ],
      "args": {
        "target": "{Target}",
        "selectItemOptions": {
          "new": "SelectItemOptions",
          "always": true,
          "set": {
            "Item": "{Item}",
            "AlterIfDisabled": "{AlterIfDisabled}",
            "Timeout": "{Timeout}",
            "DelayAfter": "{DelayAfter}",
            "DelayBefore": "{DelayBefore}",
            "HealingAgentBehavior": "UiPath.UIAutomationNext.Enums.NChildHealingAgentBehavior.{HealingAgentBehavior}",
            "Description": "{Description}"
          }
        }
      }
    }
  ],
  "ignore": [
    "ScopeIdentifier",
    "Version",
    "ForceRefreshView",
    "RequiresInitialization",
    "Items"
  ],
  "notes": "SelectItemOptions を使う。OutUiElement は扱わない。Items は Browsable(false) の一覧で、入力は Item。Coded のオプションには Item（単数）しか無いので捨てる"
}
