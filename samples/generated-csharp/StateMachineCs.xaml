  <StateMachine DisplayName="状態遷移" sap2010:WorkflowViewState.IdRef="StateMachine_1">
    <StateMachine.Variables>
      <Variable x:TypeArguments="x:Int32" Name="n">
        <Variable.Default>
          <mca:CSharpValue x:TypeArguments="x:Int32">0</mca:CSharpValue>
        </Variable.Default>
      </Variable>
    </StateMachine.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <av:Point x:Key="ShapeLocation">270,2.5</av:Point>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <StateMachine.InitialState>
      <x:Reference>Init</x:Reference>
    </StateMachine.InitialState>
    <State x:Name="Init" DisplayName="初期化" sap2010:WorkflowViewState.IdRef="State_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <av:Point x:Key="ShapeLocation">100,120</av:Point>
          <av:Size x:Key="ShapeSize">114,61</av:Size>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <State.Entry>
        <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_1">
          <ui:LogMessage.Message>
            <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;init&quot;</mca:CSharpValue></InArgument>
          </ui:LogMessage.Message>
        </ui:LogMessage>
      </State.Entry>
      <State.Exit>
        <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_2">
          <ui:LogMessage.Message>
            <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;exit init&quot;</mca:CSharpValue></InArgument>
          </ui:LogMessage.Message>
        </ui:LogMessage>
      </State.Exit>
      <State.Transitions>
        <Transition DisplayName="開始" sap2010:WorkflowViewState.IdRef="Transition_1">
          <Transition.Trigger>
            <Delay sap2010:WorkflowViewState.IdRef="Delay_1">
              <Delay.Duration>
                <InArgument x:TypeArguments="x:TimeSpan"><mca:CSharpValue x:TypeArguments="x:TimeSpan">TimeSpan.FromMilliseconds(10)</mca:CSharpValue></InArgument>
              </Delay.Duration>
            </Delay>
          </Transition.Trigger>
          <Transition.To>
            <x:Reference>Work</x:Reference>
          </Transition.To>
          <Transition.Action>
            <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_3">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;go&quot;</mca:CSharpValue></InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Transition.Action>
        </Transition>
      </State.Transitions>
    </State>
    <State x:Name="Work" DisplayName="Work" sap2010:WorkflowViewState.IdRef="State_2">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <av:Point x:Key="ShapeLocation">100,280</av:Point>
          <av:Size x:Key="ShapeSize">114,61</av:Size>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <State.Variables>
        <Variable x:TypeArguments="x:String" Name="label">
          <Variable.Default>
            <mca:CSharpValue x:TypeArguments="x:String">&quot;work &quot;</mca:CSharpValue>
          </Variable.Default>
        </Variable>
      </State.Variables>
      <State.Entry>
        <Sequence DisplayName="Entry" sap2010:WorkflowViewState.IdRef="Sequence_1">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32"><mca:CSharpReference x:TypeArguments="x:Int32">n</mca:CSharpReference></OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32"><mca:CSharpValue x:TypeArguments="x:Int32">n + 1</mca:CSharpValue></InArgument>
            </Assign.Value>
          </Assign>
          <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_4">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">label + n.ToString()</mca:CSharpValue></InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </State.Entry>
      <State.Transitions>
        <Transition DisplayName="もう一度" sap2010:WorkflowViewState.IdRef="Transition_2">
          <Transition.To>
            <x:Reference>Work</x:Reference>
          </Transition.To>
          <Transition.Condition><mca:CSharpValue x:TypeArguments="x:Boolean">n &lt; 3</mca:CSharpValue></Transition.Condition>
          <Transition.Action>
            <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_5">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;again&quot;</mca:CSharpValue></InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Transition.Action>
        </Transition>
        <Transition DisplayName="終わる" sap2010:WorkflowViewState.IdRef="Transition_3">
          <Transition.To>
            <x:Reference>Done</x:Reference>
          </Transition.To>
          <Transition.Condition><mca:CSharpValue x:TypeArguments="x:Boolean">n &gt;= 3</mca:CSharpValue></Transition.Condition>
        </Transition>
      </State.Transitions>
    </State>
    <State x:Name="Done" DisplayName="終わり" IsFinal="True" sap2010:WorkflowViewState.IdRef="State_3">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <av:Point x:Key="ShapeLocation">100,440</av:Point>
          <av:Size x:Key="ShapeSize">114,61</av:Size>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <State.Entry>
        <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_6">
          <ui:LogMessage.Message>
            <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;done n=&quot; + n.ToString()</mca:CSharpValue></InArgument>
          </ui:LogMessage.Message>
        </ui:LogMessage>
      </State.Entry>
    </State>
  </StateMachine>
</Activity>
