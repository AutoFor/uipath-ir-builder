<Activity mc:Ignorable="sap sap2010" x:Class="Controls" sap2010:ExpressionActivityEditor.ExpressionActivityEditor="C#"
xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
xmlns:mca="clr-namespace:Microsoft.CSharp.Activities;assembly=System.Activities"
xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
xmlns:sc="clr-namespace:System.Collections;assembly=System.Private.CoreLib"
xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
xmlns:ui="http://schemas.uipath.com/workflow/activities"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.Drawing</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Mail</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Text</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Runtime.Serialization</AssemblyReference>
      <AssemblyReference>System.ServiceModel</AssemblyReference>
      <AssemblyReference>System.ServiceModel.Activities</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Drawing</AssemblyReference>
      <AssemblyReference>System.Drawing.Primitives</AssemblyReference>
      <AssemblyReference>System.Drawing.Common</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
      <AssemblyReference>System.Data.DataSetExtensions</AssemblyReference>
      <AssemblyReference>System.Net.Mail</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Controls" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="i">
        <Variable.Default>
          <mca:CSharpValue x:TypeArguments="x:Int32">0</mca:CSharpValue>
        </Variable.Default>
      </Variable>
      <Variable x:TypeArguments="x:Int32" Name="total">
        <Variable.Default>
          <mca:CSharpValue x:TypeArguments="x:Int32">0</mca:CSharpValue>
        </Variable.Default>
      </Variable>
      <Variable x:TypeArguments="x:String" Name="color">
        <Variable.Default>
          <mca:CSharpValue x:TypeArguments="x:String">&quot;blue&quot;</mca:CSharpValue>
        </Variable.Default>
      </Variable>
      <Variable x:TypeArguments="x:String" Name="label" />
      <Variable x:TypeArguments="x:String" Name="text" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="items">
        <Variable.Default>
          <mca:CSharpValue x:TypeArguments="scg:List(x:String)">new List&lt;String&gt;()</mca:CSharpValue>
        </Variable.Default>
      </Variable>
    </Sequence.Variables>
    <While DisplayName="3回まわす" sap2010:WorkflowViewState.IdRef="While_1">
      <While.Condition>
        <mca:CSharpValue x:TypeArguments="x:Boolean">i &lt; 3</mca:CSharpValue>
      </While.Condition>
      <While.Body>
        <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32"><mca:CSharpReference x:TypeArguments="x:Int32">i</mca:CSharpReference></OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32"><mca:CSharpValue x:TypeArguments="x:Int32">i + 1</mca:CSharpValue></InArgument>
            </Assign.Value>
          </Assign>
          <AddToCollection x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="AddToCollection_1">
            <AddToCollection.Collection>
              <InArgument x:TypeArguments="scg:ICollection(x:String)"><mca:CSharpValue x:TypeArguments="scg:ICollection(x:String)">items</mca:CSharpValue></InArgument>
            </AddToCollection.Collection>
            <AddToCollection.Item>
              <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">&quot;item&quot; + i.ToString()</mca:CSharpValue></InArgument>
            </AddToCollection.Item>
          </AddToCollection>
        </Sequence>
      </While.Body>
    </While>
    <DoWhile DisplayName="2回まわす" sap2010:WorkflowViewState.IdRef="DoWhile_1">
      <DoWhile.Condition>
        <mca:CSharpValue x:TypeArguments="x:Boolean">total &lt; 2</mca:CSharpValue>
      </DoWhile.Condition>
      <DoWhile.Body>
        <Assign sap2010:WorkflowViewState.IdRef="Assign_2">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32"><mca:CSharpReference x:TypeArguments="x:Int32">total</mca:CSharpReference></OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32"><mca:CSharpValue x:TypeArguments="x:Int32">total + 1</mca:CSharpValue></InArgument>
          </Assign.Value>
        </Assign>
      </DoWhile.Body>
    </DoWhile>
    <ui:MultipleAssign DisplayName="まとめて代入" sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String"><mca:CSharpReference x:TypeArguments="x:String">label</mca:CSharpReference></OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">&quot;開始&quot;</mca:CSharpValue></InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String"><mca:CSharpReference x:TypeArguments="x:String">color</mca:CSharpReference></OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">&quot;red&quot;</mca:CSharpValue></InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <Switch x:TypeArguments="x:String" DisplayName="色で分ける" sap2010:WorkflowViewState.IdRef="Switch_1">
      <Switch.Expression>
        <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">color</mca:CSharpValue></InArgument>
      </Switch.Expression>
      <Switch.Default>
        <ui:LogMessage Level="Warn" sap2010:WorkflowViewState.IdRef="LogMessage_1">
          <ui:LogMessage.Message>
            <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;知らない色&quot;</mca:CSharpValue></InArgument>
          </ui:LogMessage.Message>
        </ui:LogMessage>
      </Switch.Default>
      <ui:LogMessage x:Key="red" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_2">
        <ui:LogMessage.Message>
          <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">label + &quot;: 赤&quot;</mca:CSharpValue></InArgument>
        </ui:LogMessage.Message>
      </ui:LogMessage>
      <ui:LogMessage x:Key="blue" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_3">
        <ui:LogMessage.Message>
          <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">label + &quot;: 青&quot;</mca:CSharpValue></InArgument>
        </ui:LogMessage.Message>
      </ui:LogMessage>
    </Switch>
    <TryCatch DisplayName="例外を捕まえる" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Throw sap2010:WorkflowViewState.IdRef="Throw_1">
          <Throw.Exception>
            <InArgument x:TypeArguments="s:Exception"><mca:CSharpValue x:TypeArguments="s:Exception">new InvalidOperationException(&quot;わざと&quot;)</mca:CSharpValue></InArgument>
          </Throw.Exception>
        </Throw>
      </TryCatch.Try>
      <TryCatch.Finally>
        <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_4">
          <ui:LogMessage.Message>
            <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;finally を通った&quot;</mca:CSharpValue></InArgument>
          </ui:LogMessage.Message>
        </ui:LogMessage>
      </TryCatch.Finally>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:InvalidOperationException">
          <ActivityAction x:TypeArguments="s:InvalidOperationException">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:InvalidOperationException" Name="ex" />
            </ActivityAction.Argument>
            <ui:LogMessage Level="Warn" sap2010:WorkflowViewState.IdRef="LogMessage_5">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;捕まえた: &quot; + ex.Message</mca:CSharpValue></InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <ui:WriteTextFile FileName="controls-out.txt" sap2010:WorkflowViewState.IdRef="WriteTextFile_1">
      <ui:WriteTextFile.Text>
        <InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">String.Join(&quot;,&quot;, items)</mca:CSharpValue></InArgument>
      </ui:WriteTextFile.Text>
    </ui:WriteTextFile>
    <ui:ReadTextFile FileName="controls-out.txt" sap2010:WorkflowViewState.IdRef="ReadTextFile_1">
      <ui:ReadTextFile.Content>
        <OutArgument x:TypeArguments="x:String"><mca:CSharpReference x:TypeArguments="x:String">text</mca:CSharpReference></OutArgument>
      </ui:ReadTextFile.Content>
    </ui:ReadTextFile>
    <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_6">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;ファイルの中身: &quot; + text</mca:CSharpValue></InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <ui:RetryScope DisplayName="リトライ" sap2010:WorkflowViewState.IdRef="RetryScope_1">
      <ui:RetryScope.NumberOfRetries>
        <InArgument x:TypeArguments="x:Int32"><mca:CSharpValue x:TypeArguments="x:Int32">2</mca:CSharpValue></InArgument>
      </ui:RetryScope.NumberOfRetries>
      <ui:RetryScope.RetryInterval>
        <InArgument x:TypeArguments="x:TimeSpan"><mca:CSharpValue x:TypeArguments="x:TimeSpan">TimeSpan.FromMilliseconds(100)</mca:CSharpValue></InArgument>
      </ui:RetryScope.RetryInterval>
      <ui:RetryScope.ActivityBody>
        <ActivityAction>
          <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_7">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;リトライの中&quot;</mca:CSharpValue></InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </ActivityAction>
      </ui:RetryScope.ActivityBody>
    </ui:RetryScope>
    <Delay sap2010:WorkflowViewState.IdRef="Delay_1">
      <Delay.Duration>
        <InArgument x:TypeArguments="x:TimeSpan"><mca:CSharpValue x:TypeArguments="x:TimeSpan">TimeSpan.FromMilliseconds(100)</mca:CSharpValue></InArgument>
      </Delay.Duration>
    </Delay>
    <ui:ForEach x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="ForEach_1">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable"><mca:CSharpValue x:TypeArguments="sc:IEnumerable">items</mca:CSharpValue></InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="it" />
          </ActivityAction.Argument>
          <If sap2010:WorkflowViewState.IdRef="If_1">
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean"><mca:CSharpValue x:TypeArguments="x:Boolean">it == &quot;item2&quot;</mca:CSharpValue></InArgument>
            </If.Condition>
            <If.Then>
              <ui:Break sap2010:WorkflowViewState.IdRef="Break_1" />
            </If.Then>
            <If.Else>
              <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_8">
                <ui:LogMessage.Message>
                  <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;要素: &quot; + it</mca:CSharpValue></InArgument>
                </ui:LogMessage.Message>
              </ui:LogMessage>
            </If.Else>
          </If>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_9">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object"><mca:CSharpValue x:TypeArguments="x:Object">&quot;i=&quot; + i.ToString() + &quot;, total=&quot; + total.ToString()</mca:CSharpValue></InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
