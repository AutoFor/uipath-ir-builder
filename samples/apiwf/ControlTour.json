{
  "inputs": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "limit": "number"
  },
  "outputs": {
    "total": "number",
    "tier": "string",
    "loops": "number",
    "caught": "string",
    "picked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "variables": {
    "total": {
      "type": "number",
      "default": 0
    },
    "tier": {
      "type": "string",
      "default": ""
    },
    "n": {
      "type": "number",
      "default": 0
    },
    "caught": {
      "type": "string",
      "default": ""
    }
  },
  "body": [
    {
      "name": "開始のログ",
      "log": "`items=${$workflow.input.items.length} limit=${$workflow.input.limit}`"
    },
    {
      "id": "pick",
      "name": "大きいものを選ぶ",
      "js": "return $workflow.input.items.filter(x => x.price >= 100);"
    },
    {
      "name": "合計を出す",
      "forEach": "@pick",
      "item": "row",
      "body": [
        {
          "if": "$row.price > $workflow.input.limit",
          "then": [
            {
              "break": true
            }
          ],
          "else": [
            {
              "assign": "total",
              "value": "$context.variables.total + $row.price"
            }
          ]
        }
      ]
    },
    {
      "if": "$context.variables.total >= 500",
      "then": [
        {
          "assign": "tier",
          "value": {
            "lit": "GOLD"
          }
        }
      ],
      "else": [
        {
          "assign": "tier",
          "value": {
            "lit": "SILVER"
          }
        }
      ]
    },
    {
      "doWhile": "$context.variables.n < 3",
      "body": [
        {
          "assign": "n",
          "value": "$context.variables.n + 1"
        }
      ]
    },
    {
      "try": [
        {
          "js": "throw new Error('boom');"
        }
      ],
      "as": "err",
      "catch": [
        {
          "assign": "caught",
          "value": "$err.title"
        }
      ]
    },
    {
      "wait": {
        "milliseconds": 200
      }
    },
    {
      "response": {
        "total": "$context.variables.total",
        "tier": "$context.variables.tier",
        "loops": "$context.variables.n",
        "caught": "$context.variables.caught",
        "picked": "@pick.map(x => x.name)"
      }
    }
  ],
  "tests": [
    {
      "name": "上限 500 で Break（GOLD）",
      "inputs": {
        "items": [
          {
            "name": "a",
            "price": 50
          },
          {
            "name": "b",
            "price": 200
          },
          {
            "name": "c",
            "price": 300
          },
          {
            "name": "d",
            "price": 900
          },
          {
            "name": "e",
            "price": 150
          }
        ],
        "limit": 500
      },
      "expected": {
        "total": 500,
        "tier": "GOLD",
        "loops": 3,
        "caught": "Worker operation failed: boom",
        "picked": [
          "b",
          "c",
          "d",
          "e"
        ]
      }
    },
    {
      "name": "上限 1000 で全部足す",
      "inputs": {
        "items": [
          {
            "name": "a",
            "price": 50
          },
          {
            "name": "b",
            "price": 200
          },
          {
            "name": "c",
            "price": 300
          },
          {
            "name": "d",
            "price": 900
          },
          {
            "name": "e",
            "price": 150
          }
        ],
        "limit": 1000
      },
      "expected": {
        "total": 1550,
        "tier": "GOLD",
        "loops": 3,
        "caught": "Worker operation failed: boom",
        "picked": [
          "b",
          "c",
          "d",
          "e"
        ]
      }
    },
    {
      "name": "小さいものだけ（SILVER）",
      "inputs": {
        "items": [
          {
            "name": "x",
            "price": 120
          },
          {
            "name": "y",
            "price": 10
          }
        ],
        "limit": 1000
      },
      "expected": {
        "total": 120,
        "tier": "SILVER",
        "loops": 3,
        "caught": "Worker operation failed: boom",
        "picked": [
          "x"
        ]
      }
    }
  ]
}
