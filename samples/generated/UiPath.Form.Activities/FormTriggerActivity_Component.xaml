        <ufa:FormTriggerActivity x:TypeArguments="ufa:TextTriggerEventArgs" DisplayName="名前が変わった" Enabled="True" Event="changed.name" FormId="6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01" SchedulingMode="Sequential" Tag="部品" TriggerId="f58d92df-8ca6-5b3b-a82a-d0e36a5ebb40" sap2010:WorkflowViewState.IdRef="FormTriggerActivity_1" />
        <ufa:FormTriggerActivity x:TypeArguments="ufa:FormInfoTriggerEventArgs" DisplayName="あいさつするが押された" Enabled="True" Event="click.greet" FormId="6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01" SchedulingMode="Sequential" Tag="部品" TriggerId="a1aac7a3-b08f-5ab1-96e3-e087723d6750" sap2010:WorkflowViewState.IdRef="FormTriggerActivity_2" />
        <ufa:FormTriggerActivity x:TypeArguments="ufa:NumberTriggerEventArgs" DisplayName="年齢が変わった" Enabled="True" Event="changed.age" FormId="6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01" SchedulingMode="Sequential" Tag="部品" TriggerId="0c1f370c-cae2-58fc-8893-66d25d8295e1" sap2010:WorkflowViewState.IdRef="FormTriggerActivity_3" />
        <ui:RepeatTrigger DisplayName="来なかったときに止める" Enabled="True" Interval="[TimeSpan.FromSeconds(20)]" SchedulingMode="Sequential" TriggerId="7e348f67-65b2-54f7-91e8-4d39f9fc2567" sap2010:WorkflowViewState.IdRef="RepeatTrigger_1" />
      </ui:TriggerScope.Triggers>
      <ui:TriggerScope.Action>
