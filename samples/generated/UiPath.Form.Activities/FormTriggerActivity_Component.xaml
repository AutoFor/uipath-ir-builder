    <ufa:ExecuteScriptActivity DisplayName="名前・ボタン・年齢を 1 秒ずつあけて操作する（人の操作の代わり。同じ瞬間に変えると最後の部品の changed しか出ない）" FormId="6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01" InstanceName="部品" Result="[scr]" Source="function sv(k, v) { var i = document.querySelector('input[name=&quot;data[' + k + ']&quot;]'); i.focus(); i.value = v; i.dispatchEvent(new Event('input', { bubbles: true })); i.blur(); } setTimeout(function () { sv('name', '十郎'); }, 3000); setTimeout(function () { document.querySelector('button[name=&quot;data[greet]&quot;]').click(); }, 4000); setTimeout(function () { sv('age', '21'); }, 5000)" sap2010:WorkflowViewState.IdRef="ExecuteScriptActivity_1" />
