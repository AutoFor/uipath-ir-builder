          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <If Condition="[TypeOf args Is UiPath.Forms.Activities.TextTriggerEventArgs]" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <ui:LogMessage Level="Info" Message="[&quot;名前が変わった: &quot; &amp; CType(args, UiPath.Forms.Activities.TextTriggerEventArgs).Text]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
              </If.Then>
              <If.Else>
                <If Condition="[TypeOf args Is UiPath.Forms.Activities.NumberTriggerEventArgs]" sap2010:WorkflowViewState.IdRef="If_2">
                  <If.Then>
                    <ui:LogMessage Level="Info" Message="[&quot;年齢が変わった: &quot; &amp; CType(args, UiPath.Forms.Activities.NumberTriggerEventArgs).Value.ToString()]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
                  </If.Then>
                  <If.Else>
                    <If Condition="[TypeOf args Is UiPath.Forms.Activities.FormInfoTriggerEventArgs]" sap2010:WorkflowViewState.IdRef="If_3">
                      <If.Then>
                        <ui:LogMessage Level="Info" Message="[&quot;押された: &quot; &amp; CType(args, UiPath.Forms.Activities.FormInfoTriggerEventArgs).InstanceName]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
                      </If.Then>
                      <If.Else>
                        <ui:LogMessage Level="Warn" Message="[&quot;部品のイベントが来なかった&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_4" />
                      </If.Else>
                    </If>
                  </If.Else>
                </If>
              </If.Else>
            </If>
            <Assign x:TypeArguments="x:Int32" To="[n]" Value="[n + 1]" sap2010:WorkflowViewState.IdRef="Assign_1" />
            <If Condition="[n &gt;= 3 OrElse TypeOf args Is UiPath.Platform.Triggers.TriggerArgs AndAlso Not TypeOf args Is UiPath.Forms.Activities.FormTriggerArgsWrapper]" sap2010:WorkflowViewState.IdRef="If_4">
              <If.Then>
                <ui:StopTriggers ShouldStop="[stp]" sap2010:WorkflowViewState.IdRef="StopTriggers_1" />
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:TriggerScope.Action>
