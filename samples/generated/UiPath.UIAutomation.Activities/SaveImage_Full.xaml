  <Sequence DisplayName="SaveImage_Full" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="[System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;uia-test-form.html&quot;)]" Name="htmlPath" />
      <Variable x:TypeArguments="ui:Image" Name="img" />
      <Variable x:TypeArguments="x:String" Default="[&quot;output${n}.png&quot;]" Name="imgPath" />
    </Sequence.Variables>
    <ui:WriteTextFile DisplayName="テスト用の HTML を書く" FileName="[htmlPath]" Text="&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;title&gt;UIA Test Form&lt;/title&gt;&lt;/head&gt;&lt;body style='font-family:Arial'&gt;&lt;h1&gt;UIA Test Form&lt;/h1&gt;&lt;input id='name' type='text' value=''&gt;&lt;button id='greet' onclick='document.getElementById(&quot;result&quot;).textContent=&quot;Hello, [&quot;+document.getElementById(&quot;name&quot;).value+&quot;]&quot;'&gt;Greet&lt;/button&gt;&lt;label&gt;&lt;input id='agree' type='checkbox'&gt;agree&lt;/label&gt;&lt;button id='hov' onmousemove='document.getElementById(&quot;result&quot;).textContent=&quot;hov hover&quot;'&gt;HoverMe&lt;/button&gt;&lt;button id='hide' onclick='document.getElementById(&quot;box&quot;).style.visibility=&quot;hidden&quot;'&gt;Hide&lt;/button&gt;&lt;button id='hidelater' onclick='setTimeout(function(){document.getElementById(&quot;box&quot;).style.visibility=&quot;hidden&quot;},1500)'&gt;HideLater&lt;/button&gt;&lt;button id='show' onclick='setTimeout(function(){document.getElementById(&quot;box&quot;).style.visibility=&quot;visible&quot;},1500)'&gt;Show&lt;/button&gt;&lt;div id='result'&gt;ready&lt;/div&gt;&lt;div id='box' onclick='document.getElementById(&quot;result&quot;).textContent=&quot;box clicked&quot;' onmousemove='document.getElementById(&quot;result&quot;).textContent=&quot;box hover&quot;' style='width:240px;height:140px;margin:20px;background:#e00000;border:20px solid #0000e0'&gt;&lt;/div&gt;&lt;div id='ocr' onclick='document.getElementById(&quot;result&quot;).textContent=&quot;ocr clicked&quot;' onmousemove='document.getElementById(&quot;result&quot;).textContent=&quot;ocr hover&quot;' style='font:bold 72px Arial;margin:20px;display:inline-block'&gt;HELLO42&lt;/div&gt;&lt;/body&gt;&lt;/html&gt;" sap2010:WorkflowViewState.IdRef="WriteTextFile_1" />
    <ui:OpenBrowser BrowserType="Edge" DisplayName="UIA Test Form を開く（Classic）" Url="[New Uri(htmlPath).AbsoluteUri]" sap2010:WorkflowViewState.IdRef="OpenBrowser_1">
      <ui:OpenBrowser.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="ContextTarget" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:TakeScreenshot DisplayName="四角を撮る（要素だけ）" Screenshot="[img]" WaitBefore="200" sap2010:WorkflowViewState.IdRef="TakeScreenshot_1">
              <ui:TakeScreenshot.Target>
                <ui:Target Id="e39a85d6-8bd0-5aee-b08a-5ebd44cb5770" Selector="&lt;webctrl id='box' tag='DIV' /&gt;" TimeoutMS="10000" WaitForReady="INTERACTIVE" />
              </ui:TakeScreenshot.Target>
            </ui:TakeScreenshot>
            <ui:SaveImage ContinueOnError="False" DisplayName="画像を output に保存" FileName="[imgPath]" Image="[img]" sap2010:WorkflowViewState.IdRef="SaveImage_1" />
            <ui:CloseTab DisplayName="タブを閉じる" sap2010:WorkflowViewState.IdRef="CloseTab_1" />
          </Sequence>
        </ActivityAction>
      </ui:OpenBrowser.Body>
    </ui:OpenBrowser>
    <ui:LogMessage Level="Info" Message="[&quot;結果: &quot; &amp; (New System.IO.FileInfo(imgPath).Length &gt; 0).ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
