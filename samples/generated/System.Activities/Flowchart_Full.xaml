  <Sequence DisplayName="Flowchart_Full" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Default="[0]" Name="total" />
    </Sequence.Variables>
    <Flowchart DisplayName="数える" ValidateUnconnectedNodes="True" sap2010:WorkflowViewState.IdRef="Flowchart_1">
      <Flowchart.Variables>
        <Variable x:TypeArguments="x:Int32" Default="[0]" Name="count" />
      </Flowchart.Variables>
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <av:Point x:Key="ShapeLocation">270,2.5</av:Point>
          <av:Size x:Key="ShapeSize">60,75</av:Size>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <Flowchart.StartNode>
        <x:Reference>Inc</x:Reference>
      </Flowchart.StartNode>
      <FlowStep x:Name="Inc" sap2010:WorkflowViewState.IdRef="FlowStep_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">200,110</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <Assign DisplayName="1 足す" sap2010:WorkflowViewState.IdRef="Assign_1">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[count]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">[count + 1]</InArgument>
          </Assign.Value>
        </Assign>
        <FlowStep.Next>
          <x:Reference>Check</x:Reference>
        </FlowStep.Next>
      </FlowStep>
      <FlowDecision x:Name="Check" Condition="[count &lt; 3]" DisplayName="3 未満か" sap2010:WorkflowViewState.IdRef="FlowDecision_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">265,220</av:Point>
            <av:Size x:Key="ShapeSize">70,70</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <FlowDecision.True>
          <x:Reference>Show</x:Reference>
        </FlowDecision.True>
        <FlowDecision.False>
          <x:Reference>Kind</x:Reference>
        </FlowDecision.False>
      </FlowDecision>
      <FlowStep x:Name="Show" sap2010:WorkflowViewState.IdRef="FlowStep_2">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">200,330</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <ui:LogMessage Level="Info" Message="[&quot;count=&quot; &amp; count.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
        <FlowStep.Next>
          <x:Reference>Inc</x:Reference>
        </FlowStep.Next>
      </FlowStep>
      <FlowSwitch x:TypeArguments="x:Int32" x:Name="Kind" DisplayName="回数で分ける" Expression="[count]" sap2010:WorkflowViewState.IdRef="FlowSwitch`1_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">525,330</av:Point>
            <av:Size x:Key="ShapeSize">70,70</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <FlowSwitch.Default>
          <x:Reference>Other</x:Reference>
        </FlowSwitch.Default>
        <x:Reference x:Key="3">Three</x:Reference>
        <x:Reference x:Key="4">Four</x:Reference>
      </FlowSwitch>
      <FlowStep x:Name="Three" sap2010:WorkflowViewState.IdRef="FlowStep_3">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">200,440</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <Assign sap2010:WorkflowViewState.IdRef="Assign_2">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Int32">[total]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Int32">[count * 10]</InArgument>
          </Assign.Value>
        </Assign>
        <FlowStep.Next>
          <x:Reference>ThreeLog</x:Reference>
        </FlowStep.Next>
      </FlowStep>
      <FlowStep x:Name="ThreeLog" sap2010:WorkflowViewState.IdRef="FlowStep_4">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">200,550</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <ui:LogMessage Level="Info" Message="[&quot;three&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
      </FlowStep>
      <FlowStep x:Name="Four" sap2010:WorkflowViewState.IdRef="FlowStep_5">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">460,440</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <ui:LogMessage Level="Info" Message="[&quot;four&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
      </FlowStep>
      <FlowStep x:Name="Other" sap2010:WorkflowViewState.IdRef="FlowStep_6">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">720,440</av:Point>
            <av:Size x:Key="ShapeSize">200,52</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <ui:LogMessage Level="Info" Message="[&quot;other&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_4" />
      </FlowStep>
    </Flowchart>
    <ui:LogMessage Level="Info" Message="[&quot;total=&quot; &amp; total.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_5" />
