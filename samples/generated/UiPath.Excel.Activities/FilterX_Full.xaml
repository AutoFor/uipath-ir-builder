  <Sequence DisplayName="FilterX_Full" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt" />
    </Sequence.Variables>
    <ui:CopyFile Destination="output\FilterX_Full.xlsx" DisplayName="元のブックを output に写す" Overwrite="True" Path="data\excel\Sample.xlsx" sap2010:WorkflowViewState.IdRef="CopyFile_1" />
    <ueab:ExcelApplicationCard ResizeWindow="None" WorkbookPath="output\FilterX_Full.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:FilterX ClearFilter="False" ColumnName="Age" DisplayName="30 より大きい" HasHeaders="True" Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:C4&quot;)]" sap2010:WorkflowViewState.IdRef="FilterX_1">
              <ueab:FilterX.FilterArgument>
                <ns0:FilterArgument Mode="Advanced">
                  <ns0:FilterArgument.AdvancedFiltersArgument>
                    <ns0:AdvancedFilterArgument LogicalOperator="And">
                      <ns0:AdvancedFilterArgument.Condition1>
                        <ns0:AdvancedFilterCondition Operator="GT" Value="26" />
                      </ns0:AdvancedFilterArgument.Condition1>
                      <ns0:AdvancedFilterArgument.Condition2>
                        <ns0:AdvancedFilterCondition Operator="LT" Value="40" />
                      </ns0:AdvancedFilterArgument.Condition2>
                    </ns0:AdvancedFilterArgument>
                  </ns0:FilterArgument.AdvancedFiltersArgument>
                </ns0:FilterArgument>
              </ueab:FilterX.FilterArgument>
            </ueab:FilterX>
            <ueab:ReadRangeX Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:C4&quot;)]" SaveTo="[dt]" VisibleOnly="True" sap2010:WorkflowViewState.IdRef="ReadRangeX_1" />
            <ui:LogMessage Level="Info" Message="[&quot;行数: &quot; &amp; dt.Rows.Count.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
            <ui:LogMessage Level="Info" Message="[&quot;先頭: &quot; &amp; dt.Rows(0).Item(0).ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
            <ueab:FilterX ClearFilter="True" ColumnName="Age" DisplayName="解除" HasHeaders="True" Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:C4&quot;)]" sap2010:WorkflowViewState.IdRef="FilterX_2" />
            <ueab:ReadRangeX Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:C4&quot;)]" SaveTo="[dt]" VisibleOnly="True" sap2010:WorkflowViewState.IdRef="ReadRangeX_2" />
            <ui:LogMessage Level="Info" Message="[&quot;解除後: &quot; &amp; dt.Rows.Count.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
  </Sequence>
