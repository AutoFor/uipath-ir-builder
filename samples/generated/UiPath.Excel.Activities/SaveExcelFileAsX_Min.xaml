  <Sequence DisplayName="SaveExcelFileAsX_Min" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Object" Name="a1" />
      <Variable x:TypeArguments="x:Boolean" Name="ex" />
    </Sequence.Variables>
    <ui:CopyFile Destination="output\SaveExcelFileAsX_Min.xlsx" DisplayName="元のブックを output に写す" Overwrite="True" Path="data\excel\Sample.xlsx" sap2010:WorkflowViewState.IdRef="CopyFile_1" />
    <ueab:ExcelApplicationCard ResizeWindow="None" WorkbookPath="output\SaveExcelFileAsX_Min.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:WriteCellX Cell="[Excel.Sheet(&quot;Sheet1&quot;).Cell(&quot;E1&quot;)]" Value="[&quot;別名で保存&quot;]" sap2010:WorkflowViewState.IdRef="WriteCellX_1" />
            <ueab:SaveExcelFileAsX FilePath="output\SaveExcelFileAsX_Min.copy.xlsx" ReplaceExisting="True" SaveAsFileType="OpenXmlWorkbook" Workbook="[Excel]" sap2010:WorkflowViewState.IdRef="SaveExcelFileAsX_1" />
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
    <ui:PathExists Exists="[ex]" Path="output\SaveExcelFileAsX_Min.copy.xlsx" PathType="File" sap2010:WorkflowViewState.IdRef="PathExists_1" />
    <ui:LogMessage Level="Info" Message="[&quot;別名のファイルがある: &quot; &amp; ex.ToString()]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
    <ueab:ExcelApplicationCard ReadOnly="True" ResizeWindow="None" WorkbookPath="output\SaveExcelFileAsX_Min.copy.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_2">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <ueab:ReadCellValueX Cell="[Excel.Sheet(&quot;Sheet1&quot;).Cell(&quot;E1&quot;)]" GetFormattedText="True" sap2010:WorkflowViewState.IdRef="ReadCellValueX_1">
              <ueab:ReadCellValueX.SaveTo>
                <OutArgument x:TypeArguments="x:Object">[a1]</OutArgument>
              </ueab:ReadCellValueX.SaveTo>
            </ueab:ReadCellValueX>
            <ui:LogMessage Level="Info" Message="[&quot;別名の E1: [&quot; &amp; Convert.ToString(a1) &amp; &quot;]&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
  </Sequence>
