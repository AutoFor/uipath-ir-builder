  <Sequence DisplayName="CreateTableX_Min" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="tableName" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt" />
    </Sequence.Variables>
    <ui:CopyFile Destination="output\CreateTableX_Min.xlsx" DisplayName="元のブックを output に写す" Overwrite="True" Path="data\excel\Sample.xlsx" sap2010:WorkflowViewState.IdRef="CopyFile_1" />
    <ueab:ExcelApplicationCard ResizeWindow="None" WorkbookPath="output\CreateTableX_Min.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:CreateTableX HasHeaders="True" OutTableName="[tableName]" Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:C4&quot;)]" sap2010:WorkflowViewState.IdRef="CreateTableX_1" />
            <ui:LogMessage Level="Info" Message="[&quot;テーブル名: &quot; &amp; tableName]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
            <ueab:ReadRangeX Range="[Excel.Table(tableName)]" SaveTo="[dt]" sap2010:WorkflowViewState.IdRef="ReadRangeX_1" />
            <ui:LogMessage Level="Info" Message="[&quot;テーブルの行数: &quot; &amp; dt.Rows.Count.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
  </Sequence>
