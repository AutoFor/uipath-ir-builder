  <Sequence DisplayName="DeleteSheetX_Min" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Object" Name="a1" />
    </Sequence.Variables>
    <ui:CopyFile Destination="output\DeleteSheetX_Min.xlsx" DisplayName="元のブックを output に写す" Overwrite="True" Path="data\excel\Sample.xlsx" sap2010:WorkflowViewState.IdRef="CopyFile_1" />
    <ueab:ExcelApplicationCard ResizeWindow="None" WorkbookPath="output\DeleteSheetX_Min.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:DeleteSheetX Sheet="[Excel.Sheet(&quot;Sheet2&quot;)]" sap2010:WorkflowViewState.IdRef="DeleteSheetX_1" />
            <ueab:ReadCellValueX Cell="[Excel.Sheet(&quot;Sheet1&quot;).Cell(&quot;A1&quot;)]" GetFormattedText="True" sap2010:WorkflowViewState.IdRef="ReadCellValueX_1">
              <ueab:ReadCellValueX.SaveTo>
                <OutArgument x:TypeArguments="x:Object">[a1]</OutArgument>
              </ueab:ReadCellValueX.SaveTo>
            </ueab:ReadCellValueX>
            <ui:LogMessage Level="Info" Message="[&quot;Sheet1 の A1: [&quot; &amp; Convert.ToString(a1) &amp; &quot;]&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
            <TryCatch DisplayName="Sheet2 を読む" sap2010:WorkflowViewState.IdRef="TryCatch_1">
              <TryCatch.Try>
                <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <ueab:ReadCellValueX Cell="[Excel.Sheet(&quot;Sheet2&quot;).Cell(&quot;A1&quot;)]" GetFormattedText="True" sap2010:WorkflowViewState.IdRef="ReadCellValueX_2">
                    <ueab:ReadCellValueX.SaveTo>
                      <OutArgument x:TypeArguments="x:Object">[a1]</OutArgument>
                    </ueab:ReadCellValueX.SaveTo>
                  </ueab:ReadCellValueX>
                  <ui:LogMessage Level="Info" Message="[&quot;Sheet2 が残っている&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
                </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="s:Exception">
                  <ActivityAction x:TypeArguments="s:Exception">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
                    </ActivityAction.Argument>
                    <ui:LogMessage Level="Info" Message="[&quot;Sheet2 は無い&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
  </Sequence>
</Activity>
