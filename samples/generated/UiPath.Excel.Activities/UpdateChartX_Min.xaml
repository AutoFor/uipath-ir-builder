  <Sequence DisplayName="UpdateChartX_Min" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="ue:IChartRef" Name="ch" />
    </Sequence.Variables>
    <ui:CopyFile Destination="output\UpdateChartX_Min.xlsx" DisplayName="元のブックを output に写す" Overwrite="True" Path="data\excel\Sample.xlsx" sap2010:WorkflowViewState.IdRef="CopyFile_1" />
    <ueab:ExcelApplicationCard ResizeWindow="None" WorkbookPath="output\UpdateChartX_Min.xlsx" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1">
      <ueab:ExcelApplicationCard.Body>
        <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="Excel" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:InsertExcelChartX ChartCategory="Column" ChartHeight="300" ChartType="xlColumnClustered" ChartWidth="400" InsertedChart="[ch]" InsertIntoSheet="[Excel.Sheet(&quot;Sheet1&quot;)]" Left="300" Range="[Excel.Sheet(&quot;Sheet1&quot;).Range(&quot;A1:B4&quot;)]" Top="10" sap2010:WorkflowViewState.IdRef="InsertExcelChartX_1" />
            <ueab:UpdateChartX Chart="[ch]" sap2010:WorkflowViewState.IdRef="UpdateChartX_1">
              <ueab:UpdateChartX.Body>
                <ActivityAction>
                  <Sequence sap2010:WorkflowViewState.IdRef="Sequence_3">
                    <ns0:ModifyChartTitleModification ShowTitle="True" Title="年齢" sap2010:WorkflowViewState.IdRef="ModifyChartTitleModification_1" />
                  </Sequence>
                </ActivityAction>
              </ueab:UpdateChartX.Body>
            </ueab:UpdateChartX>
            <ui:LogMessage Level="Info" Message="[&quot;題名: &quot; &amp; ch.ChartInfo.Title]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
          </Sequence>
        </ActivityAction>
      </ueab:ExcelApplicationCard.Body>
    </ueab:ExcelApplicationCard>
