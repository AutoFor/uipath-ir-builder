<Activity mc:Ignorable="sap sap2010" x:Class="StudioStateMachine" mva:VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StateMachine DisplayName="General Business Process" InitialState="{x:Reference __ReferenceID0}" sap2010:WorkflowViewState.IdRef="StateMachine_1">
    <StateMachine.Variables>
      <Variable x:TypeArguments="x:Int32" Default="0" Name="n" />
    </StateMachine.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <av:Point x:Key="ShapeLocation">270,2.5</av:Point>
        <x:Double x:Key="StateContainerWidth">880</x:Double>
        <x:Double x:Key="StateContainerHeight">520</x:Double>
        <av:PointCollection x:Key="ConnectorLocation">300,77.5 300,107.5 300,124</av:PointCollection>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <State x:Name="__ReferenceID0" DisplayName="Initialization" sap2010:WorkflowViewState.IdRef="State_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <av:Point x:Key="ShapeLocation">200,124</av:Point>
          <av:Size x:Key="ShapeSize">114,61</av:Size>
          <x:Boolean x:Key="IsPinned">False</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <State.Entry>
        <ui:LogMessage DisplayName="開始" Level="Info" Message="[&quot;init&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
      </State.Entry>
      <State.Transitions>
        <Transition DisplayName="Successful" sap2010:WorkflowViewState.IdRef="Transition_1">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <av:PointCollection x:Key="ConnectorLocation">257,185 257,244</av:PointCollection>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Transition.To>
            <State x:Name="__ReferenceID1" DisplayName="Process Transaction" sap2010:WorkflowViewState.IdRef="State_2">
              <State.Variables>
                <Variable x:TypeArguments="x:String" Name="label" />
              </State.Variables>
              <State.Entry>
                <Sequence DisplayName="Process Transaction" sap2010:WorkflowViewState.IdRef="Sequence_1">
                  <Assign sap2010:WorkflowViewState.IdRef="Assign_1">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Int32">[n]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">[n + 1]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:LogMessage Level="Info" Message="[label &amp; n.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
                </Sequence>
              </State.Entry>
              <State.Transitions>
                <Transition DisplayName="Next" To="{x:Reference __ReferenceID1}" sap2010:WorkflowViewState.IdRef="Transition_2">
                  <Transition.Condition>
                    <mva:VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="n &lt; 3" />
                  </Transition.Condition>
                </Transition>
                <Transition DisplayName="Done" Condition="[n &gt;= 3]" sap2010:WorkflowViewState.IdRef="Transition_3">
                  <Transition.To>
                    <x:Reference>__ReferenceID2</x:Reference>
                  </Transition.To>
                  <Transition.Action>
                    <ui:LogMessage Level="Info" Message="[&quot;bye&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
                  </Transition.Action>
                </Transition>
              </State.Transitions>
            </State>
          </Transition.To>
        </Transition>
      </State.Transitions>
    </State>
    <x:Reference>__ReferenceID1</x:Reference>
    <State x:Name="__ReferenceID2" DisplayName="End Process" IsFinal="True" sap2010:WorkflowViewState.IdRef="State_3">
      <State.Entry>
        <ui:LogMessage Level="Info" Message="[&quot;done&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_4" />
      </State.Entry>
    </State>
  </StateMachine>
</Activity>
