<Activity mc:Ignorable="sap sap2010" x:Class="StudioStyle" VisualBasic.Settings="{x:Null}" sap:VirtualizedContainerService.HintSize="400,600" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Name" Type="InArgument(x:String)" sap2010:Annotation.AnnotationText="呼び出し元の名前" />
    <x:Property Name="out_Text" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>Custom.Namespace.Used.By.Expressions</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Main Sequence" sap:VirtualizedContainerService.HintSize="400,500" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Default="3" Name="count" />
      <Variable x:TypeArguments="x:String" Default="abc" Name="label" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="names" />
    </Sequence.Variables>
    <Assign DisplayName="代入（要素で書く）" sap2010:Annotation.AnnotationText="ここは後で直す" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[count]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[count + 1]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="ログ（要素で書く）" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_1">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <mva:VisualBasicValue x:TypeArguments="x:Object" ExpressionText="label &amp; count.ToString" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <If Condition="[count &gt; 1]" DisplayName="分岐" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <ui:LogMessage Level="Warn" Message="[&quot;大きい&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
      </If.Then>
    </If>
    <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Sub.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_A">[in_Name]</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_B">[out_Text]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
  </Sequence>
</Activity>
