{
  "workflow": "InvokeVBAX_Min",
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\InvokeVBAX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\InvokeVBAX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "InvokeVBAX",
          "props": {
            "Workbook": "Excel",
            "CodeFilePath": {
              "lit": "data\\excel\\vba\\AddNumbers.bas"
            },
            "EntryMethodName": {
              "lit": "Hello"
            }
          },
          "body": [
            {
              "act": "Sequence",
              "body": []
            }
          ]
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"実行した\""
          }
        }
      ]
    }
  ]
}
