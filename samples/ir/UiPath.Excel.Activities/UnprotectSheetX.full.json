{
  "workflow": "UnprotectSheetX_Full",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\UnprotectSheetX_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\UnprotectSheetX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "ProtectSheetX",
          "props": {
            "Sheet": "Excel.Sheet(\"Sheet1\")",
            "Password": {
              "lit": "pw123"
            }
          }
        },
        {
          "act": "UnprotectSheetX",
          "name": "パスワードで解除",
          "props": {
            "Sheet": "Excel.Sheet(\"Sheet1\")",
            "Password": {
              "lit": "pw123"
            },
            "IsPasswordHidden": false
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "Value": {
              "lit": "解除後に書いた"
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"E1: [\" & Convert.ToString(a1) & \"]\""
          }
        }
      ]
    }
  ]
}
