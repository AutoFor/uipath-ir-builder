{
  "workflow": "ExcelApplicationCard_Full",
  "variables": [
    {
      "name": "name",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "AutoSave": false,
        "CreateNewFile": false,
        "KeepExcelFileOpen": false,
        "ReadOnly": true,
        "ReadFormatting": "DisplayValue",
        "ResizeWindow": "None",
        "SensitivityOperation": "None",
        "Visible": true,
        "UseTemplate": false,
        "TemplatePath": {
          "lit": ""
        }
      },
      "body": [
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A3\")",
            "SaveTo": "name"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"A3: \" & name"
      }
    }
  ]
}
