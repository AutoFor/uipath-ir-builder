{
  "workflow": "FindReplaceValueX_Min",
  "variables": [
    {
      "name": "at",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "FindReplaceValueX",
          "props": {
            "WhereToSearch": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "ValueToFind": {
              "lit": "花子"
            },
            "Operation": "Find",
            "FoundAt": "at"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"見つかった場所: \" & at"
      }
    }
  ]
}
