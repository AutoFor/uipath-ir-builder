{
  "workflow": "InsertSheetX_Min",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\InsertSheetX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\InsertSheetX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "InsertSheetX",
          "props": {
            "Workbook": "Excel",
            "Name": {
              "lit": "Sheet3"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet3\").Cell(\"A1\")",
            "Value": {
              "lit": "新しいシート"
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet3\").Cell(\"A1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"Sheet3 の A1: [\" & Convert.ToString(a1) & \"]\""
          }
        }
      ]
    }
  ]
}
