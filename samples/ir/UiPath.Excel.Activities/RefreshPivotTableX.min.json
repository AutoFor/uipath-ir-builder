{
  "workflow": "RefreshPivotTableX_Min",
  "variables": [
    {
      "name": "t",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\RefreshPivotTableX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\RefreshPivotTableX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "CreatePivotTableXv2",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "DestinationRange": "Excel.Sheet(\"Sheet2\").Range(\"C3\")",
            "TableName": {
              "lit": "Pivot1"
            },
            "LayoutRowType": "Compact"
          },
          "body": [
            {
              "act": "Sequence",
              "body": [
                {
                  "act": "PivotTableFieldX",
                  "props": {
                    "FieldName": {
                      "lit": "Name"
                    },
                    "Type": "Row"
                  }
                },
                {
                  "act": "PivotTableFieldX",
                  "props": {
                    "FieldName": {
                      "lit": "Age"
                    },
                    "Type": "Value",
                    "Function": "Sum"
                  }
                }
              ]
            }
          ]
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B2\")",
            "Value": "100"
          }
        },
        {
          "act": "RefreshPivotTableX",
          "props": {
            "Table": "Excel.Sheet(\"Sheet2\").PivotTable(\"Pivot1\")",
            "LayoutRowType": "Compact"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet2\").Cell(\"D7\")",
            "SaveTo": "t"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"総計: [\" & Convert.ToString(t) & \"]\""
          }
        }
      ]
    }
  ]
}
