{
  "workflow": "ReadCellValueX_Full",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadCellValueX",
          "name": "式の結果を読む",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C2\")",
            "GetFormattedText": false,
            "SaveTo": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C2: \" & v.ToString"
      }
    }
  ]
}
