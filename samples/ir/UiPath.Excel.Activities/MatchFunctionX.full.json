{
  "workflow": "MatchFunctionX_Full",
  "variables": [
    {
      "name": "pos",
      "type": "Int32"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "MatchFunctionX",
          "name": "25 を探す",
          "props": {
            "InRange": "Excel.Sheet(\"Sheet1\").Range(\"B2:B4\")",
            "ValueToMatch": "25",
            "MatchFunctionType": "ExactlyEqual",
            "SaveTo": "pos"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"位置: \" & pos.ToString"
      }
    }
  ]
}
