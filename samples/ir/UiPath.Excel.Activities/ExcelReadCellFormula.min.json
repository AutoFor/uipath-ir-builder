{
  "workflow": "ExcelReadCellFormula_Min",
  "variables": [
    {
      "name": "f",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelReadCellFormula",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "C2"
            },
            "Formula": "f"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C2 の式: \" & f"
      }
    }
  ]
}
