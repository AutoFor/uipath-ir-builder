{
  "workflow": "ExcelForEachRowX_Min",
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelForEachRowX",
          "item": [
            "CurrentRow",
            "CurrentIndex"
          ],
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "HasHeaders": true
          },
          "body": [
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "CurrentIndex.ToString & \": \" & CurrentRow(\"Name\").ToString"
              }
            }
          ]
        }
      ]
    }
  ]
}
