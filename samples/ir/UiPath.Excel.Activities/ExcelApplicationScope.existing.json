{
  "workflow": "ExcelApplicationScope_Existing",
  "variables": [
    {
      "name": "v",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelApplicationScope",
          "name": "開いているブックを使う",
          "item": "InnerScope",
          "props": {
            "ExistingWorkbook": "ExcelWorkbookScope"
          },
          "body": [
            {
              "act": "ExcelReadCell",
              "props": {
                "SheetName": {
                  "lit": "Sheet1"
                },
                "Cell": {
                  "lit": "A3"
                },
                "Result": "v"
              }
            }
          ]
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"A3: \" & v"
      }
    }
  ]
}
