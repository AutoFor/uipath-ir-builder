{
  "workflow": "FillRangeX_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "v1",
      "type": "Object"
    },
    {
      "name": "v2",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\FillRangeX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteRangeX",
          "props": {
            "Destination": "Excel.Sheet(\"Sheet1\").Range(\"A1\")",
            "Source": "dt"
          }
        },
        {
          "act": "FillRangeX",
          "props": {
            "DestinationRange": "Excel.Sheet(\"Sheet1\").Range(\"C2:C4\")",
            "Value": {
              "lit": "済"
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C2\")",
            "SaveTo": "v1"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C4\")",
            "SaveTo": "v2"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C2=\" & CStr(v1) & \" C4=\" & CStr(v2)"
      }
    }
  ]
}
