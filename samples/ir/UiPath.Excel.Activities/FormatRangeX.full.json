{
  "workflow": "FormatRangeX_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "v1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\FormatRangeX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteRangeX",
          "props": {
            "Destination": "Excel.Sheet(\"Sheet1\").Range(\"A1\")",
            "Source": "dt"
          }
        },
        {
          "act": "FormatRangeX",
          "name": "数値を小数 2 桁・太字・中央にする",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"B2:B4\")"
          },
          "objs": {
            "Format": {
              "$type": "NumberFormat",
              "DecimalPlaces": 2,
              "UseThousandSeparator": true
            },
            "Font": {
              "FontFamilyName": {
                "lit": "Arial"
              },
              "Size": 14,
              "Style": "Bold",
              "UnderlineStyle": "None"
            },
            "Alignment": {
              "HorizontalAlignment": "xlHAlignCenter",
              "VerticalAlignment": "xlVAlignCenter",
              "WrapText": true
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B2\")",
            "SaveTo": "v1"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"B2=\" & CStr(v1)"
      }
    }
  ]
}
