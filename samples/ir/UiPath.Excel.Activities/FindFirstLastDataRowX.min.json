{
  "workflow": "FindFirstLastDataRowX_Min",
  "variables": [
    {
      "name": "first",
      "type": "Int32"
    },
    {
      "name": "last",
      "type": "Int32"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "FindFirstLastDataRowX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "ColumnName": {
              "lit": "Name"
            },
            "FirstRowIndex": "first",
            "LastRowIndex": "last"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"first=\" & first.ToString & \" last=\" & last.ToString"
      }
    }
  ]
}
