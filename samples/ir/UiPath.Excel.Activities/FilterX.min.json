{
  "workflow": "FilterX_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\FilterX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\FilterX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "FilterX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "ColumnName": {
              "lit": "Name"
            }
          },
          "objs": {
            "FilterArgument": {
              "Mode": "Basic",
              "BasicFiltersArgument": {
                "BasicFilters": [
                  {
                    "lit": "花子"
                  }
                ]
              }
            }
          }
        },
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "SaveTo": "dt",
            "VisibleOnly": true
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"行数: \" & dt.Rows.Count.ToString"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"先頭: \" & dt.Rows(0).Item(0).ToString"
          }
        }
      ]
    }
  ]
}
