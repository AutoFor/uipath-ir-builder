{
  "workflow": "ExcelCopyPasteRange_Min",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    },
    {
      "name": "w",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelCopyPasteRange_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelCopyPasteRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelCopyPasteRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "SourceRange": {
              "lit": "A1:C4"
            },
            "DestinationSheet": {
              "lit": "Sheet2"
            },
            "DestinationCell": {
              "lit": "B2"
            }
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "Cell": {
              "lit": "B2"
            },
            "Result": "v"
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "Cell": {
              "lit": "C3"
            },
            "Result": "w"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"Sheet2!B2: \" & Convert.ToString(v)"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"Sheet2!C3: \" & Convert.ToString(w)"
      }
    }
  ]
}
