{
  "workflow": "ExcelProcessScopeX_Min",
  "variables": [
    {
      "name": "a",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelProcessScopeX",
      "item": "ExcelProcessScopeTag",
      "body": [
        {
          "act": "ExcelApplicationCard",
          "item": "Excel",
          "props": {
            "WorkbookPath": {
              "lit": "data\\excel\\Sample.xlsx"
            },
            "ReadOnly": true
          },
          "body": [
            {
              "act": "ReadCellValueX",
              "props": {
                "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
                "SaveTo": "a"
              }
            }
          ]
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A2: [\" & Convert.ToString(a) & \"]\""
          }
        }
      ]
    }
  ]
}
