{
  "workflow": "ExcelAutoFillRange_Full",
  "variables": [
    {
      "name": "v",
      "type": "String"
    },
    {
      "name": "w",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelAutoFillRange_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelAutoFillRange_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelAutoFillRange",
          "name": "式を下に広げる",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "SourceRange": {
              "lit": "C2"
            },
            "FillRange": {
              "lit": "C2:C4"
            }
          }
        },
        {
          "act": "ExcelReadCellFormula",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "C4"
            },
            "Formula": "v"
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "C4"
            },
            "Result": "w"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C4 の式: \" & v"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C4: \" & Convert.ToString(w)"
      }
    }
  ]
}
