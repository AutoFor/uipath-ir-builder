{
  "workflow": "ExcelCopySheet_Min",
  "variables": [
    {
      "name": "v",
      "type": "String"
    },
    {
      "name": "w",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelCopySheet_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelCopySheet_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelCopySheet",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "DestinationSheetName": {
              "lit": "Sheet1コピー"
            }
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1コピー"
            },
            "Cell": {
              "lit": "A2"
            },
            "Result": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"コピー先 A2: \" & v"
      }
    }
  ]
}
