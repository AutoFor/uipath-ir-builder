{
  "workflow": "LookupX_Full",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "LookupX",
          "name": "次郎の年齢",
          "props": {
            "SourceRange": "Excel.Sheet(\"Sheet1\").Range(\"A1:A4\")",
            "Label": {
              "lit": "次郎"
            },
            "ResultRange": "Excel.Sheet(\"Sheet1\").Range(\"B1:B4\")",
            "Value": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"値: \" & CStr(v)"
      }
    }
  ]
}
