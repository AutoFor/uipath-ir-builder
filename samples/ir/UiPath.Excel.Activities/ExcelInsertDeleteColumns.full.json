{
  "workflow": "ExcelInsertDeleteColumns_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelInsertDeleteColumns_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelInsertDeleteColumns_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelInsertDeleteColumns",
          "name": "2 列目を消す",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Mode": "Remove",
            "Position": 2,
            "NoColumns": 1
          }
        },
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:C4"
            },
            "DataTable": "dt"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"見出し0: \" & dt.Columns(0).ColumnName"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"見出し1: \" & dt.Columns(1).ColumnName"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"見出し2: \" & dt.Columns(2).ColumnName"
      }
    }
  ]
}
