{
  "workflow": "GetSelectedRangeX_Full",
  "variables": [
    {
      "name": "rng",
      "type": "IReadRangeRef"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "SelectRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")"
          }
        },
        {
          "act": "GetSelectedRangeX",
          "name": "選択範囲を取る",
          "props": {
            "Workbook": "Excel",
            "Range": "rng"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"selected: \" & rng.Address"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"rows: \" & rng.RowCount.ToString"
      }
    }
  ]
}
