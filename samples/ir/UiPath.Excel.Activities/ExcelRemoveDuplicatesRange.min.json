{
  "workflow": "ExcelRemoveDuplicatesRange_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelRemoveDuplicatesRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A1"
            },
            "Text": {
              "lit": "x"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A2"
            },
            "Text": {
              "lit": "y"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A3"
            },
            "Text": {
              "lit": "x"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A4"
            },
            "Text": {
              "lit": "y"
            }
          }
        },
        {
          "act": "ExcelRemoveDuplicatesRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:A4"
            }
          }
        },
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:A4"
            },
            "DataTable": "dt",
            "AddHeaders": false
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"行数: \" & dt.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"1 行目: \" & dt.Rows(0).Item(0).ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"2 行目: \" & dt.Rows(1).Item(0).ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"3 行目: \" & dt.Rows(2).Item(0).ToString"
      }
    }
  ]
}
