{
  "workflow": "InsertRowsX_Min",
  "variables": [
    {
      "name": "a2",
      "type": "Object"
    },
    {
      "name": "a3",
      "type": "Object"
    },
    {
      "name": "a4",
      "type": "Object"
    },
    {
      "name": "a5",
      "type": "Object"
    },
    {
      "name": "a6",
      "type": "Object"
    },
    {
      "name": "a7",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\InsertRowsX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\InsertRowsX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A6\")",
            "Value": {
              "lit": "下の行"
            }
          }
        },
        {
          "act": "InsertRowsX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "NbOfRows": "1"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A5\")",
            "SaveTo": "a5"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A5: [\" & Convert.ToString(a5) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A6\")",
            "SaveTo": "a6"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A6: [\" & Convert.ToString(a6) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A7\")",
            "SaveTo": "a7"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A7: [\" & Convert.ToString(a7) & \"]\""
          }
        }
      ]
    }
  ]
}
