{
  "workflow": "ExcelSortTable_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelSortTable_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelSortTable_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelCreateTable",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:C4"
            },
            "TableName": {
              "lit": "PeopleTable"
            }
          }
        },
        {
          "act": "ExcelSortTable",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "TableName": {
              "lit": "PeopleTable"
            },
            "ColumnName": {
              "lit": "Age"
            },
            "Order": "Ascending"
          }
        },
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:C4"
            },
            "DataTable": "dt"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"1 行目: \" & dt.Rows(0).Item(\"Name\").ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"3 行目: \" & dt.Rows(2).Item(\"Name\").ToString"
      }
    }
  ]
}
