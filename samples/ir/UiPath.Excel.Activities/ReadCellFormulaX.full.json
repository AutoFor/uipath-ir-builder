{
  "workflow": "ReadCellFormulaX_Full",
  "variables": [
    {
      "name": "f",
      "type": "String"
    },
    {
      "name": "g",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadCellFormulaX",
          "name": "C3 の式",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C3\")",
            "SaveTo": "f"
          }
        },
        {
          "act": "ReadCellFormulaX",
          "name": "値のセルの式",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B3\")",
            "SaveTo": "g"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C3 の式: \" & f"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"B3 の式: \" & g"
      }
    }
  ]
}
