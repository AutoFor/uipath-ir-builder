{
  "workflow": "TextToColumnsX_Min",
  "variables": [
    {
      "name": "v1",
      "type": "Object"
    },
    {
      "name": "v2",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\TextToColumnsX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A1\")",
            "Value": {
              "lit": "太郎,30"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "Value": {
              "lit": "花子,25"
            }
          }
        },
        {
          "act": "TextToColumnsX",
          "props": {
            "SourceRange": "Excel.Sheet(\"Sheet1\").Range(\"A1:A2\")",
            "DestinationRange": "Excel.Sheet(\"Sheet1\").Range(\"C1\")",
            "ParsingType": "Delimited"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C2\")",
            "SaveTo": "v1"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"D2\")",
            "SaveTo": "v2"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"C2=\" & CStr(v1) & \" D2=\" & CStr(v2)"
      }
    }
  ]
}
