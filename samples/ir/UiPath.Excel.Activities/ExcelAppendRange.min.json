{
  "workflow": "ExcelAppendRange_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "back",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelAppendRange_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelAppendRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A2:C3"
            },
            "DataTable": "dt"
          }
        },
        {
          "act": "ExcelAppendRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "DataTable": "dt"
          }
        },
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:C5"
            },
            "DataTable": "back"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"行数: \" & back.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"最後の行: \" & back.Rows(back.Rows.Count - 1).Item(0).ToString"
      }
    }
  ]
}
