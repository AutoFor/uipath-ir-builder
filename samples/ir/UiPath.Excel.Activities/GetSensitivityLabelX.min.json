{
  "workflow": "GetSensitivityLabelX_Min",
  "variables": [
    {
      "name": "lbl",
      "type": "IExcelLabelObject"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "GetSensitivityLabelX",
          "props": {
            "Workbook": "Excel",
            "SensitivityLabel": "lbl"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"label is null: \" & (lbl Is Nothing).ToString",
          "cs": "\"label is null: \" + (lbl == null)"
        }
      }
    }
  ]
}
