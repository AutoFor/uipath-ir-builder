{
  "workflow": "ExcelLookUpRange_Min",
  "variables": [
    {
      "name": "v",
      "type": "String"
    },
    {
      "name": "w",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelLookUpRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A1"
            },
            "Text": {
              "lit": "10"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A2"
            },
            "Text": {
              "lit": "20"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A3"
            },
            "Text": {
              "lit": "30"
            }
          }
        },
        {
          "act": "ExcelLookUpRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:A3"
            },
            "Value": {
              "lit": "20"
            },
            "Result": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & v"
      }
    }
  ]
}
