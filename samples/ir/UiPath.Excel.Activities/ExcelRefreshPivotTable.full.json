{
  "workflow": "ExcelRefreshPivotTable_Full",
  "variables": [
    {
      "name": "r",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelRefreshPivotTable_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelRefreshPivotTable_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelCreateTable",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:C4"
            },
            "TableName": {
              "lit": "PeopleTable"
            }
          }
        },
        {
          "act": "ExcelCreatePivotTable",
          "name": "ピボットを作る",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "Range": {
              "lit": "A3"
            },
            "SourceTableName": {
              "lit": "PeopleTable"
            },
            "TableName": {
              "lit": "PeoplePivot"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A5"
            },
            "Text": {
              "lit": "四郎"
            }
          }
        },
        {
          "act": "ExcelRefreshPivotTable",
          "name": "元の表を変えたあとで更新する",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "TableName": {
              "lit": "PeoplePivot"
            }
          }
        },
        {
          "act": "ExcelGetTableRange",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "TableName": {
              "lit": "PeoplePivot"
            },
            "IsPivot": true,
            "Range": "r"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ピボットの範囲: \" & r"
      }
    }
  ]
}
