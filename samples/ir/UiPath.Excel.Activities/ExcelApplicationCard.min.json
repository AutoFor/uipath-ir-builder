{
  "workflow": "ExcelApplicationCard_Min",
  "variables": [
    {
      "name": "name",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        }
      },
      "body": [
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "SaveTo": "name"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"A2: \" & name"
      }
    }
  ]
}
