{
  "workflow": "ExcelGetWorkbookSheet_Min",
  "variables": [
    {
      "name": "sheets",
      "type": "List<String>"
    },
    {
      "name": "nm",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelGetWorkbookSheet",
          "props": {
            "Index": "0",
            "Sheet": "nm"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"sheet0=\" & nm"
      }
    }
  ]
}
