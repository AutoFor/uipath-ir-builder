{
  "workflow": "UpdateChartX_Min",
  "variables": [
    {
      "name": "ch",
      "type": "IChartRef"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\UpdateChartX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\UpdateChartX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "InsertExcelChartX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "InsertIntoSheet": "Excel.Sheet(\"Sheet1\")",
            "ChartCategory": "Column",
            "ChartType": "xlColumnClustered",
            "Left": 300,
            "Top": 10,
            "ChartWidth": 400,
            "ChartHeight": 300,
            "InsertedChart": "ch"
          }
        },
        {
          "act": "UpdateChartX",
          "props": {
            "Chart": "ch"
          },
          "body": [
            {
              "act": "Sequence",
              "body": [
                {
                  "act": "ModifyChartTitleModification",
                  "props": {
                    "ShowTitle": true,
                    "Title": {
                      "lit": "年齢"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"題名: \" & ch.ChartInfo.Title"
          }
        }
      ]
    }
  ]
}
