{
  "workflow": "RefreshDataConnectionsX_Min",
  "variables": [
    {
      "name": "a",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\RefreshDataConnectionsX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\RefreshDataConnectionsX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "RefreshDataConnectionsX",
          "props": {
            "Workbook": "Excel"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "SaveTo": "a"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A2: [\" & Convert.ToString(a) & \"]\""
          }
        }
      ]
    }
  ]
}
