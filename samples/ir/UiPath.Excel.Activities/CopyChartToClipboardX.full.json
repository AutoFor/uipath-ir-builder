{
  "workflow": "CopyChartToClipboardX_Full",
  "variables": [
    {
      "name": "ch",
      "type": "IChartRef"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\CopyChartToClipboardX_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\CopyChartToClipboardX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "InsertExcelChartX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "InsertIntoSheet": "Excel.Sheet(\"Sheet1\")",
            "ChartCategory": "Column",
            "ChartType": "xlColumnClustered",
            "Left": 300,
            "Top": 10,
            "ChartWidth": 400,
            "ChartHeight": 300,
            "InsertedChart": "ch"
          }
        },
        {
          "act": "CopyChartToClipboardX",
          "name": "画像に保存",
          "props": {
            "Chart": "ch",
            "Action": "SaveAsPicture",
            "FilePath": {
              "lit": "output\\CopyChartToClipboardX_Full.png"
            },
            "ReplaceFile": true
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"画像: \" & System.IO.File.Exists(\"output\\CopyChartToClipboardX_Full.png\").ToString"
      }
    }
  ]
}
