{
  "workflow": "ExcelAutoFillRange_Min",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    },
    {
      "name": "w",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelAutoFillRange_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelAutoFillRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "E1"
            },
            "Text": {
              "lit": "1"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "E2"
            },
            "Text": {
              "lit": "2"
            }
          }
        },
        {
          "act": "ExcelAutoFillRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "SourceRange": {
              "lit": "E1:E2"
            },
            "FillRange": {
              "lit": "E1:E5"
            }
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "E5"
            },
            "Result": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"E5: \" & Convert.ToString(v)"
      }
    }
  ]
}
