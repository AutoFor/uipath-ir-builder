{
  "workflow": "SaveExcelFileAsX_Min",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    },
    {
      "name": "ex",
      "type": "Boolean"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\SaveExcelFileAsX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\SaveExcelFileAsX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "Value": {
              "lit": "別名で保存"
            }
          }
        },
        {
          "act": "SaveExcelFileAsX",
          "props": {
            "Workbook": "Excel",
            "FilePath": {
              "lit": "output\\SaveExcelFileAsX_Min.copy.xlsx"
            },
            "SaveAsFileType": "OpenXmlWorkbook"
          }
        }
      ]
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\SaveExcelFileAsX_Min.copy.xlsx"
        },
        "Exists": "ex"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"別名のファイルがある: \" & ex.ToString()"
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\SaveExcelFileAsX_Min.copy.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"別名の E1: [\" & Convert.ToString(a1) & \"]\""
          }
        }
      ]
    }
  ]
}
