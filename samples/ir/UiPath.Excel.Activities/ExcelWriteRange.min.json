{
  "workflow": "ExcelWriteRange_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "back",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:B4"
            },
            "DataTable": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelWriteRange_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelWriteRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "DataTable": "dt"
          }
        },
        {
          "act": "ExcelReadRange",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "A1:B3"
            },
            "DataTable": "back",
            "AddHeaders": false
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"書いた行数: \" & back.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"最後の行: \" & back.Rows(2).Item(0).ToString & \" \" & back.Rows(2).Item(1).ToString"
      }
    }
  ]
}
