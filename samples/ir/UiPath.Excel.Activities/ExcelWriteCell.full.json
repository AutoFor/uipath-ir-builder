{
  "workflow": "ExcelWriteCell_Full",
  "variables": [
    {
      "name": "v",
      "type": "String"
    },
    {
      "name": "w",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelWriteCell_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelWriteCell_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelWriteCell",
          "name": "2 つ目のシートに書く",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "Cell": {
              "lit": "B2"
            },
            "Text": {
              "lit": "書いた"
            }
          }
        },
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A2"
            },
            "Text": {
              "lit": "上書き"
            }
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet2"
            },
            "Cell": {
              "lit": "B2"
            },
            "Result": "v"
          }
        },
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "A2"
            },
            "Result": "w"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"Sheet2!B2: \" & v"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"Sheet1!A2: \" & w"
      }
    }
  ]
}
