{
  "workflow": "UpdateChartX_Full",
  "variables": [
    {
      "name": "ch",
      "type": "IChartRef"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\UpdateChartX_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\UpdateChartX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "InsertExcelChartX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "InsertIntoSheet": "Excel.Sheet(\"Sheet1\")",
            "ChartCategory": "Column",
            "ChartType": "xlColumnClustered",
            "Left": 300,
            "Top": 10,
            "ChartWidth": 400,
            "ChartHeight": 300,
            "InsertedChart": "ch"
          }
        },
        {
          "act": "UpdateChartX",
          "name": "全部の変更",
          "props": {
            "Chart": "ch"
          },
          "body": [
            {
              "act": "Sequence",
              "body": [
                {
                  "act": "ChangeDataRangeModification",
                  "props": {
                    "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B3\")"
                  }
                },
                {
                  "act": "ModifyChartTitleModification",
                  "props": {
                    "ShowTitle": true,
                    "Title": {
                      "lit": "年齢"
                    }
                  }
                },
                {
                  "act": "UpdateAxisTitleModification",
                  "props": {
                    "Axis": "Vertical",
                    "ShowTitle": true,
                    "Title": {
                      "lit": "歳"
                    }
                  }
                },
                {
                  "act": "UpdateAxisBoundsModification",
                  "props": {
                    "Axis": "Vertical",
                    "MinBound": 0,
                    "MaxBound": 50
                  }
                },
                {
                  "act": "ShowHideLegendModification",
                  "props": {
                    "ShowLegend": false
                  }
                },
                {
                  "act": "ShowHideDataLabelsModification",
                  "props": {
                    "ShowDataLabels": true
                  }
                }
              ]
            }
          ]
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"題名: \" & ch.ChartInfo.Title"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"凡例: \" & ch.ChartInfo.HasLegend.ToString"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"ラベル: \" & ch.ChartInfo.HasDataLabels.ToString"
          }
        }
      ]
    }
  ]
}
