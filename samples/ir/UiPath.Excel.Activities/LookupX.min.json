{
  "workflow": "LookupX_Min",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\LookupX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A1\")",
            "Value": {
              "lit": "apple"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B1\")",
            "Value": {
              "lit": "りんご"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "Value": {
              "lit": "banana"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B2\")",
            "Value": {
              "lit": "バナナ"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A3\")",
            "Value": {
              "lit": "cherry"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B3\")",
            "Value": {
              "lit": "さくらんぼ"
            }
          }
        },
        {
          "act": "LookupX",
          "props": {
            "SourceRange": "Excel.Sheet(\"Sheet1\").Range(\"A1:B3\")",
            "Label": {
              "lit": "banana"
            },
            "Value": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"値: \" & CStr(v)"
      }
    }
  ]
}
