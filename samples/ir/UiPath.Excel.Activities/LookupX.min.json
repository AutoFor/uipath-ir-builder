{
  "workflow": "LookupX_Min",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "LookupX",
          "props": {
            "SourceRange": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "Label": {
              "lit": "花子"
            },
            "Value": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"値: \" & CStr(v)"
      }
    }
  ]
}
