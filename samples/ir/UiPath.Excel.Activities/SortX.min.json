{
  "workflow": "SortX_Min",
  "variables": [
    {
      "name": "a2",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\SortX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\SortX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "SortX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")"
          },
          "body": [
            {
              "act": "Sequence",
              "body": [
                {
                  "act": "SortColumnX",
                  "props": {
                    "ColumnName": {
                      "lit": "Age"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "SaveTo": "a2"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A2: [\" & Convert.ToString(a2) & \"]\""
          }
        }
      ]
    }
  ]
}
