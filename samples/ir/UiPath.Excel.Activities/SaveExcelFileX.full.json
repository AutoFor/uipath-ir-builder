{
  "workflow": "SaveExcelFileX_Full",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\SaveExcelFileX_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\SaveExcelFileX_Full.xlsx"
        },
        "AutoSave": false
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "Value": {
              "lit": "保存した"
            }
          }
        },
        {
          "act": "SaveExcelFileX",
          "name": "ここで保存",
          "props": {
            "Workbook": "Excel"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\SaveExcelFileX_Full.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"E1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"開き直した E1: [\" & Convert.ToString(a1) & \"]\""
          }
        }
      ]
    }
  ]
}
