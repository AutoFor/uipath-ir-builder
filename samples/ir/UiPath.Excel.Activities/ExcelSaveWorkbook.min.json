{
  "workflow": "ExcelSaveWorkbook_Min",
  "variables": [
    {
      "name": "v",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelSaveWorkbook_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelSaveWorkbook_Min.xlsx"
        },
        "ReadOnly": false,
        "AutoSave": false
      },
      "body": [
        {
          "act": "ExcelWriteCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "E1"
            },
            "Text": {
              "lit": "保存した"
            }
          }
        },
        {
          "act": "ExcelSaveWorkbook"
        }
      ]
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelSaveWorkbook_Min.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelReadCell",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "E1"
            },
            "Result": "v"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"E1: \" & Convert.ToString(v)"
      }
    }
  ]
}
