{
  "workflow": "GetCellColorX_Min",
  "variables": [
    {
      "name": "c",
      "type": "System.Drawing.Color"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "GetCellColorX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A1\")",
            "OutputColor": "c"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"RGB=\" & c.R.ToString & \",\" & c.G.ToString & \",\" & c.B.ToString"
      }
    }
  ]
}
