{
  "workflow": "DuplicateSheetX_Min",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    },
    {
      "name": "b2",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\DuplicateSheetX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\DuplicateSheetX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "DuplicateSheetX",
          "props": {
            "SheetToDuplicate": "Excel.Sheet(\"Sheet2\")",
            "NewSheetName": {
              "lit": "Sheet2コピー"
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet2コピー\").Cell(\"A1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"コピーの A1: [\" & Convert.ToString(a1) & \"]\""
          }
        }
      ]
    }
  ]
}
