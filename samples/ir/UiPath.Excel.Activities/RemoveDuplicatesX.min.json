{
  "workflow": "RemoveDuplicatesX_Min",
  "variables": [
    {
      "name": "a1",
      "type": "Object"
    },
    {
      "name": "a2",
      "type": "Object"
    },
    {
      "name": "a3",
      "type": "Object"
    },
    {
      "name": "a4",
      "type": "Object"
    },
    {
      "name": "a5",
      "type": "Object"
    },
    {
      "name": "b5",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\RemoveDuplicatesX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\RemoveDuplicatesX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A5\")",
            "Value": {
              "lit": "太郎"
            }
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B5\")",
            "Value": "30"
          }
        },
        {
          "act": "WriteCellX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C5\")",
            "Value": "60"
          }
        },
        {
          "act": "RemoveDuplicatesX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C5\")"
          },
          "lists": {
            "Columns": [
              {
                "lit": "Name"
              },
              {
                "lit": "Age"
              },
              {
                "lit": "Double"
              }
            ]
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A4\")",
            "SaveTo": "a4"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A4: [\" & Convert.ToString(a4) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A5\")",
            "SaveTo": "a5"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A5: [\" & Convert.ToString(a5) & \"]\""
          }
        }
      ]
    }
  ]
}
