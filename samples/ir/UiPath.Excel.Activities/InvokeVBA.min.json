{
  "workflow": "InvokeVBA_Min",
  "variables": [
    {
      "name": "res",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "InvokeVBA",
          "props": {
            "CodeFilePath": {
              "lit": "data\\excel\\ExcelD_Vba.txt"
            },
            "EntryMethodName": {
              "lit": "Main"
            },
            "OutputValue": "res"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"vba: \" & Convert.ToString(res)"
      }
    }
  ]
}
