{
  "workflow": "ClearRangeX_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "v1",
      "type": "Object"
    },
    {
      "name": "v2",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ClearRangeX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteRangeX",
          "props": {
            "Destination": "Excel.Sheet(\"Sheet1\").Range(\"A1\")",
            "Source": "dt"
          }
        },
        {
          "act": "ClearRangeX",
          "name": "データ行を消す",
          "props": {
            "TargetRange": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "HasHeaders": true
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A1\")",
            "SaveTo": "v1"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "SaveTo": "v2"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"A1=[\" & CStr(v1) & \"] A2=[\" & CStr(v2) & \"]\""
      }
    }
  ]
}
