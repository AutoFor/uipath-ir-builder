{
  "workflow": "ReadRangeX_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt",
            "VisibleOnly": false
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"行数: \" & dt.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"1行目: \" & dt.Rows(0).Item(\"Name\").ToString & \" \" & dt.Rows(0).Item(\"Age\").ToString"
      }
    }
  ]
}
