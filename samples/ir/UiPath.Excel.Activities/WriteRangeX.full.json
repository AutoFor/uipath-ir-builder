{
  "workflow": "WriteRangeX_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "back",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\WriteRangeX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteRangeX",
          "props": {
            "Destination": "Excel.Sheet(\"Sheet1\").Range(\"B2\")",
            "Source": "dt",
            "Append": false,
            "ExcludeHeaders": false,
            "IgnoreEmptySource": true
          }
        },
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"B2:C5\")",
            "SaveTo": "back"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"書いた行数: \" & back.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"最後の行: \" & back.Rows(2).Item(\"Name\").ToString & \" \" & back.Rows(2).Item(\"Age\").ToString"
      }
    }
  ]
}
