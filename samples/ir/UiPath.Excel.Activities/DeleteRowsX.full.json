{
  "workflow": "DeleteRowsX_Full",
  "variables": [
    {
      "name": "a2",
      "type": "Object"
    },
    {
      "name": "a3",
      "type": "Object"
    },
    {
      "name": "a4",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\DeleteRowsX_Full.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\DeleteRowsX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "DeleteRowsX",
          "name": "1行目と3行目を消す",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "DeleteRowsOption": "Specific",
            "RowPositions": {
              "lit": "1,3"
            },
            "HasHeaders": true
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A2\")",
            "SaveTo": "a2"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A2: [\" & Convert.ToString(a2) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A3\")",
            "SaveTo": "a3"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A3: [\" & Convert.ToString(a3) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A4\")",
            "SaveTo": "a4"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A4: [\" & Convert.ToString(a4) & \"]\""
          }
        }
      ]
    }
  ]
}
