{
  "workflow": "DeleteColumnX_Min",
  "variables": [
    {
      "name": "c1",
      "type": "Object"
    },
    {
      "name": "b1",
      "type": "Object"
    },
    {
      "name": "a1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\DeleteColumnX_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\DeleteColumnX_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "DeleteColumnX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:C4\")",
            "ColumnName": {
              "lit": "Double"
            }
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A1\")",
            "SaveTo": "a1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"A1: [\" & Convert.ToString(a1) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"B1\")",
            "SaveTo": "b1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"B1: [\" & Convert.ToString(b1) & \"]\""
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"C1\")",
            "SaveTo": "c1"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"C1: [\" & Convert.ToString(c1) & \"]\""
          }
        }
      ]
    }
  ]
}
