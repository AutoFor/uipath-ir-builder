{
  "workflow": "ExcelSetRangeColor_Min",
  "variables": [
    {
      "name": "c",
      "type": "System.Drawing.Color"
    }
  ],
  "body": [
    {
      "act": "CopyFile",
      "name": "元のブックを output に写す",
      "props": {
        "Path": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "Destination": {
          "lit": "output\\ExcelSetRangeColor_Min.xlsx"
        },
        "Overwrite": true
      }
    },
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "output\\ExcelSetRangeColor_Min.xlsx"
        }
      },
      "body": [
        {
          "act": "ExcelSetRangeColor",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Range": {
              "lit": "B2:B3"
            },
            "Color": "System.Drawing.Color.Yellow"
          }
        },
        {
          "act": "ExcelGetCellColor",
          "props": {
            "SheetName": {
              "lit": "Sheet1"
            },
            "Cell": {
              "lit": "B3"
            },
            "Color": "c"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"RGB=\" & c.R.ToString & \",\" & c.G.ToString & \",\" & c.B.ToString"
      }
    }
  ]
}
