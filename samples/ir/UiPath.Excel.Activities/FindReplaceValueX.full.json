{
  "workflow": "FindReplaceValueX_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    },
    {
      "name": "at",
      "type": "String"
    },
    {
      "name": "v1",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ReadRangeX",
          "props": {
            "Range": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "SaveTo": "dt"
          }
        }
      ]
    },
    {
      "act": "ExcelApplicationCard",
      "item": "Excel",
      "props": {
        "WorkbookPath": {
          "lit": "output\\FindReplaceValueX_Full.xlsx"
        }
      },
      "body": [
        {
          "act": "WriteRangeX",
          "props": {
            "Destination": "Excel.Sheet(\"Sheet1\").Range(\"A1\")",
            "Source": "dt"
          }
        },
        {
          "act": "FindReplaceValueX",
          "name": "花子を置き換える",
          "props": {
            "WhereToSearch": "Excel.Sheet(\"Sheet1\").Range(\"A1:B4\")",
            "ValueToFind": {
              "lit": "花子"
            },
            "Operation": "ReplaceAll",
            "ReplaceWith": {
              "lit": "花ちゃん"
            },
            "LookIn": "Values",
            "MatchCase": true,
            "MatchEntireCellContents": true,
            "FoundAt": "at"
          }
        },
        {
          "act": "ReadCellValueX",
          "props": {
            "Cell": "Excel.Sheet(\"Sheet1\").Cell(\"A3\")",
            "SaveTo": "v1"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"置き換えた場所: \" & at"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"A3=\" & CStr(v1)"
      }
    }
  ]
}
