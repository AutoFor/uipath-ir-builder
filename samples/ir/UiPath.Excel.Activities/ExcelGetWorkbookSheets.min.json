{
  "workflow": "ExcelGetWorkbookSheets_Min",
  "variables": [
    {
      "name": "sheets",
      "type": "List<String>"
    },
    {
      "name": "nm",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExcelApplicationScope",
      "item": "ExcelWorkbookScope",
      "props": {
        "WorkbookPath": {
          "lit": "data\\excel\\Sample.xlsx"
        },
        "ReadOnly": true
      },
      "body": [
        {
          "act": "ExcelGetWorkbookSheets",
          "props": {
            "Sheets": "sheets"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"count=\" & sheets.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"names=\" & String.Join(\",\", sheets)"
      }
    }
  ]
}
