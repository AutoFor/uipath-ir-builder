{
  "workflow": "ExtractDocumentDataWithDocumentData_Min",
  "arguments": [
    {
      "name": "in_Invoice",
      "dir": "In",
      "type": "IResource"
    }
  ],
  "variables": [
    {
      "name": "docData",
      "type": "UiPath.IntelligentOCR.StudioWeb.Activities.DataExtraction.IDocumentData(Of UiPath.IntelligentOCR.StudioWeb.Activities.DataExtraction.DictionaryData)"
    },
    {
      "name": "json",
      "type": "String"
    },
    {
      "name": "total",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ExtractDocumentDataWithDocumentData",
      "typeArg": "UiPath.IntelligentOCR.StudioWeb.Activities.DataExtraction.DictionaryData",
      "props": {
        "FileInput": "in_Invoice",
        "ProjectId": {
          "lit": "00000000-0000-0000-0000-000000000000"
        },
        "ProjectName": {
          "lit": "Predefined"
        },
        "ProjectTag": {
          "lit": "Production"
        },
        "ProjectVersionName": {
          "lit": "Production"
        },
        "ProjectVersionNumber": "0",
        "DocType": {
          "lit": "invoices"
        },
        "ModernDocumentTypeId": {
          "lit": "invoices"
        },
        "ModernDocumentTypeName": {
          "lit": "Invoices"
        },
        "ExtractorName": {
          "lit": "Invoices"
        },
        "GenerateData": "False",
        "ApplyAutoValidation": "False",
        "ActivityMajorVersion": "2",
        "TimeoutInSeconds": "3600",
        "ExtractionResults": "docData"
      }
    },
    {
      "act": "Assign",
      "props": {
        "To": "json",
        "Value": "String.Join(\" | \", docData.Data.GetFields().Select(Function(f) f.FieldName & \"=\" & If(f.Values IsNot Nothing AndAlso f.Values.Length > 0, f.Values(0).Value, \"\")))"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "json"
      }
    },
    {
      "act": "Assign",
      "props": {
        "To": "total",
        "Value": "docData.Data.GetFieldValue(\"Total Amount\").Value"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"TOTAL=\" & total"
      }
    }
  ]
}
