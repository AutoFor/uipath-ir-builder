{
  "workflow": "WaitAttribute_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "el",
      "type": "UiElement"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><div id='status'>pending</div><script>setTimeout(function(){document.getElementById('status').textContent='done'},1500)</script></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "WaitUiElementAppear",
          "name": "status の要素を得る",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='status' tag='DIV' />"
              }
            }
          },
          "props": {
            "FoundElement": "el"
          }
        },
        {
          "act": "WaitAttribute",
          "name": "innertext が done になるのを待つ（Classic・全部入り）",
          "props": {
            "Element": "el",
            "Attribute": {
              "lit": "innertext"
            },
            "AttributeValue": {
              "lit": "done"
            },
            "TimeoutMS": 10000,
            "ContinueOnError": false
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"待ち終わった\""
      }
    }
  ]
}
