{
  "workflow": "ExpandALVHierarchicalTable_Full",
  "variables": [],
  "body": [
    {
      "act": "OpenApplication",
      "name": "SAP Logon を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "saplogon.exe"
        },
        "Selector": {
          "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
        }
      },
      "body": [
        {
          "act": "ExpandALVHierarchicalTable",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<sap id='/app/con[0]/ses[0]/wnd[0]/shellcont/shell' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "ColumnNameLevel0": {
              "lit": "CARRID"
            },
            "ColumnValueLevel0": {
              "lit": "LH"
            },
            "ColumnNameLevel1": {
              "lit": "CONNID"
            },
            "ColumnValueLevel1": {
              "lit": "0400"
            },
            "FocusedColumn": {
              "lit": "PRICE"
            },
            "SelectLevel1": false,
            "ContinueOnError": false,
            "SendTelemetryOnlyOnFailure": false
          },
          "lists": {
            "AllColumns": [
              {
                "lit": "MATNR"
              },
              {
                "lit": "WERKS"
              }
            ],
            "ColumnsLevel0": [
              {
                "lit": "MATNR"
              }
            ],
            "ColumnsLevel1": [
              {
                "lit": "WERKS"
              }
            ]
          }
        }
      ]
    }
  ]
}
