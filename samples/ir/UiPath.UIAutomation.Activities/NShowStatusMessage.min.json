{
  "workflow": "NShowStatusMessage_Min",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-m2-form.html\")"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><div id='result'>ready</div></body></html>"
        }
      }
    },
    {
      "act": "NApplicationCard",
      "name": "UIA Test Form を開く",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "Url": "New Uri(htmlPath).AbsoluteUri",
          "BrowserType": "Edge",
          "Selector": {
            "lit": "<html app='msedge.exe' title='UIA Test Form' />"
          }
        }
      },
      "props": {
        "OpenMode": "Always",
        "CloseMode": "Always"
      },
      "body": [
        {
          "act": "NShowStatusWindow",
          "name": "ステータス ウィンドウを出す",
          "props": {
            "Title": {
              "lit": "uia-m2"
            },
            "Message": {
              "lit": "status window"
            }
          },
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl tag='BODY' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector"
            }
          }
        },
        {
          "act": "NShowStatusMessage",
          "name": "メッセージを出す",
          "props": {
            "Message": {
              "lit": "step 1"
            }
          },
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl tag='BODY' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector"
            }
          }
        },
        {
          "act": "NHideStatusWindow",
          "name": "ステータス ウィンドウを閉じる",
          "props": {},
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl tag='BODY' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector"
            }
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"status message ok\""
      }
    }
  ]
}
