{
  "workflow": "CellScope_Full",
  "variables": [],
  "body": [
    {
      "act": "OpenApplication",
      "name": "SAP Logon を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "saplogon.exe"
        },
        "Selector": {
          "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
        }
      },
      "body": [
        {
          "act": "CellScope",
          "item": "ContextTarget",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<sap id='/app/con[0]/ses[0]/wnd[0]/shellcont/shell' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "RowNumber": 2,
            "ColumnName": {
              "lit": "CARRID"
            },
            "ContinueOnError": false,
            "SendTelemetryOnlyOnFailure": false
          },
          "body": [
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "\"セルの中\""
              }
            }
          ],
          "lists": {
            "ColumnNames": [
              {
                "lit": "MATNR"
              },
              {
                "lit": "WERKS"
              }
            ]
          }
        }
      ]
    }
  ]
}
