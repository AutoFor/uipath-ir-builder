{
  "workflow": "NWindowOperation_Full",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-m3-note.txt\")"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-m3"
        }
      }
    },
    {
      "act": "NApplicationCard",
      "name": "メモ帳を開く",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:/Windows/System32/notepad.exe"
          },
          "Arguments": "notePath",
          "Selector": {
            "lit": "<wnd app='notepad.exe' title='uia-m3-note.txt*' />"
          }
        }
      },
      "props": {
        "OpenMode": "Always",
        "CloseMode": "Always"
      },
      "body": [
        {
          "act": "NWindowOperation",
          "name": "メモ帳を動かして大きさを変える（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<wnd app='notepad.exe' title='uia-m3-note.txt*' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='notepad.exe' title='uia-m3-note.txt*' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "Operation": "Move",
            "X": 100,
            "Y": 100,
            "Width": 700,
            "Height": 500,
            "Timeout": 20,
            "DelayBefore": 0.1,
            "DelayAfter": 0.3,
            "ContinueOnError": false,
            "HealingAgentBehavior": "Disabled"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"moved\""
          }
        }
      ]
    }
  ]
}
