{
  "workflow": "NWindowOperation_Full",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "テスト用のウィンドウを開く",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
          },
          "Arguments": {
            "lit": "-NoProfile -WindowStyle Hidden -Command \"Add-Type -AssemblyName System.Windows.Forms; $f=New-Object System.Windows.Forms.Form; $f.Text='UIA Window Test'; [System.Windows.Forms.Application]::Run($f)\""
          },
          "Selector": {
            "lit": "<wnd app='powershell.exe' title='UIA Window Test' />"
          }
        }
      },
      "props": {
        "OpenMode": "Always",
        "CloseMode": "Always"
      },
      "body": [
        {
          "act": "NWindowOperation",
          "name": "ウィンドウを動かして大きさを変える（全部入り）",
          "props": {
            "Operation": "Move",
            "X": 100,
            "Y": 100,
            "Width": 700,
            "Height": 500,
            "Timeout": 20,
            "DelayBefore": 0.1,
            "DelayAfter": 0.3,
            "ContinueOnError": false,
            "HealingAgentBehavior": "Disabled"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"moved\""
          }
        }
      ]
    }
  ]
}
