{
  "workflow": "NSAPTableCellScope_Min",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPTableCellScope",
          "name": "表のセル スコープ",
          "item": "ContextTarget",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/usr/cntlGRID1/shellcont/shell' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "RowType": "Index",
            "RowIndex": 0,
            "ColumnName": {
              "lit": "VBELN"
            }
          },
          "body": [
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "\"セルの中\""
              }
            }
          ]
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPTableCellScope 完了\""
          }
        }
      ]
    }
  ]
}
