{
  "workflow": "TypeSecureText_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "typed",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "Sequence",
          "name": "秘密の文字列を入れる",
          "variables": [
            {
              "name": "securePwd",
              "type": "SecureString",
              "default": "New System.Net.NetworkCredential(\"\", \"dummy-text\").SecurePassword"
            }
          ],
          "body": [
            {
              "act": "TypeSecureText",
              "name": "名前欄に入れる（Classic・全部入り）",
              "objs": {
                "Target": {
                  "Selector": {
                    "lit": "<webctrl id='name' tag='INPUT' />"
                  },
                  "TimeoutMS": 10000,
                  "WaitForReady": "INTERACTIVE"
                }
              },
              "props": {
                "SecureText": "securePwd",
                "SimulateType": true,
                "Activate": true,
                "AlterIfDisabled": true,
                "ClickBeforeTyping": true,
                "DeselectAfter": false,
                "EmptyField": true,
                "DelayBefore": 100,
                "DelayBetweenKeys": 20,
                "DelayMS": 300,
                "SendWindowMessages": false,
                "ContinueOnError": false
              }
            },
            {
              "act": "GetValue",
              "name": "入力を読む",
              "objs": {
                "Target": {
                  "Selector": {
                    "lit": "<webctrl id='name' tag='INPUT' />"
                  }
                }
              },
              "props": {
                "Value": "typed"
              }
            }
          ]
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & typed"
      }
    }
  ]
}
