{
  "workflow": "StartProcess_Full",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "StartProcess",
      "name": "メモ帳を起動する",
      "props": {
        "FileName": {
          "lit": "notepad.exe"
        },
        "Arguments": "notePath",
        "WorkingDirectory": "System.IO.Path.GetTempPath()",
        "StartType": "Asynchronously",
        "Timeout": 10000,
        "ContinueOnError": false
      }
    },
    {
      "act": "WindowScope",
      "name": "メモ帳のウィンドウに入って閉じる",
      "item": "ContextTarget",
      "props": {
        "Selector": {
          "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
        },
        "TimeoutMS": 15000
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"started\""
          }
        },
        {
          "act": "CloseWindow",
          "name": "メモ帳を閉じる",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            }
          }
        }
      ]
    }
  ]
}
