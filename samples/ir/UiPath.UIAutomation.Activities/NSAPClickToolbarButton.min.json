{
  "workflow": "NSAPClickToolbarButton_Min",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPClickToolbarButton",
          "name": "ツールバー ボタンをクリック",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/tbar[1]' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "Item": {
              "lit": "Save"
            }
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPClickToolbarButton 完了\""
          }
        }
      ]
    }
  ]
}
