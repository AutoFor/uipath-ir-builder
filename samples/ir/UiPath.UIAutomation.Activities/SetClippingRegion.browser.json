{
  "workflow": "SetClippingRegion_Browser",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "el",
      "type": "UiElement"
    },
    {
      "name": "result",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><div id='box' style='width:200px;height:50px;background:#ccf' onclick=\"document.getElementById('result').textContent=(event.offsetX<50?'left':'right')\">box</div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "WaitUiElementAppear",
          "name": "box の要素を得る",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='box' tag='DIV' />"
              }
            }
          },
          "props": {
            "FoundElement": "el"
          }
        },
        {
          "act": "SetClippingRegion",
          "name": "左上 30x30 だけに切る",
          "props": {
            "Element": "el",
            "Direction": "RECTANGLE",
            "Region": "New UiPath.Core.Region(New System.Drawing.Rectangle(0, 0, 30, 30))"
          }
        },
        {
          "act": "Click",
          "name": "切ったあとの中央を押す",
          "objs": {
            "Target": {
              "Element": "el"
            },
            "CursorPosition": {
              "Position": "Center",
              "OffsetX": 0,
              "OffsetY": 0
            }
          }
        },
        {
          "act": "GetValue",
          "name": "結果を読む",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='result' tag='DIV' />"
              }
            }
          },
          "props": {
            "Value": "result"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"押した位置: \" & result"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    }
  ]
}
