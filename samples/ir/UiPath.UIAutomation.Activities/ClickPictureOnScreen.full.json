{
  "workflow": "ClickPictureOnScreen_Full",
  "variables": [],
  "body": [
    {
      "act": "OpenApplication",
      "name": "SAP Logon を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "saplogon.exe"
        },
        "Selector": {
          "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
        }
      },
      "body": [
        {
          "act": "ClickPictureOnScreen",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<sap id='/app/con[0]/ses[0]/wnd[0]/shellcont/shell' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "ClickType": "CLICK_DOUBLE",
            "KeyModifiers": "Shift",
            "PictureOffsetX": 5,
            "PictureOffsetY": 5,
            "DelayBefore": 100,
            "DelayMS": 300,
            "SendWindowMessages": false,
            "ContinueOnError": false
          }
        }
      ]
    }
  ]
}
