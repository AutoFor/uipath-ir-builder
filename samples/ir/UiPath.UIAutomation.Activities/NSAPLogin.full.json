{
  "workflow": "NSAPLogin_Full",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPLogin",
          "name": "SAP にログイン（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/usr' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "Username": {
              "lit": "sap-user"
            },
            "Password": {
              "lit": "<パスワードを入れる>"
            },
            "IsSecure": false,
            "Client": {
              "lit": "100"
            },
            "Language": {
              "lit": "JA"
            },
            "Option": "Single",
            "Timeout": 30,
            "DelayBefore": 0.2,
            "DelayAfter": 0.2,
            "ContinueOnError": false,
            "HealingAgentBehavior": "SameAsCard",
            "Description": {
              "lit": "SAP 画面の操作"
            },
            "ForceRefreshView": true
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPLogin 完了（全部入り）\""
          }
        }
      ]
    }
  ]
}
