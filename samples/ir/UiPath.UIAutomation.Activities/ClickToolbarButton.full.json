{
  "workflow": "ClickToolbarButton_Full",
  "variables": [],
  "body": [
    {
      "act": "OpenApplication",
      "name": "SAP Logon を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "saplogon.exe"
        },
        "Selector": {
          "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
        }
      },
      "body": [
        {
          "act": "ClickToolbarButton",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<sap id='/app/con[0]/ses[0]/wnd[0]/tbar[1]' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "Item": {
              "lit": "Execute"
            },
            "AlterIfDisabled": false,
            "DelayBefore": 100,
            "DelayAfter": 100,
            "ContinueOnError": false
          }
        }
      ]
    }
  ]
}
