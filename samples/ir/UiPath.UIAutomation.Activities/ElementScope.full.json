{
  "workflow": "ElementScope_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "text",
      "type": "String"
    },
    {
      "name": "scopeEl",
      "type": "UiElement"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><div id='outer'><div id='inner'><span id='leaf'>leaf</span></div></div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "ElementScope",
          "name": "outer のスコープ（Classic・全部入り）",
          "item": "ContextTarget",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='outer' tag='DIV' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "UiElement": "scopeEl",
            "ContinueOnError": false
          },
          "body": [
            {
              "act": "GetValue",
              "name": "スコープの中で leaf を読む",
              "objs": {
                "Target": {
                  "Selector": {
                    "lit": "<webctrl id='leaf' tag='SPAN' />"
                  }
                }
              },
              "props": {
                "Value": "text"
              }
            }
          ]
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"スコープ内: \" & text"
      }
    }
  ]
}
