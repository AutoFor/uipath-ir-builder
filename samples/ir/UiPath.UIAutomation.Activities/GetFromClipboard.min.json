{
  "workflow": "GetFromClipboard_Min",
  "variables": [{ "name": "got", "type": "Object" }],
  "body": [
    { "act": "SetToClipboard", "name": "テスト用の文字列を入れる", "props": { "Text": { "lit": "uia-c5 get min" } } },
    { "act": "GetFromClipboard", "name": "クリップボードから読む", "props": { "Result": "got" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"クリップボード: \" & Convert.ToString(got)" } }
  ]
}
