{
  "workflow": "GoogleCloudOCR_Full",
  "variables": [
    {
      "name": "img",
      "type": "Image"
    },
    {
      "name": "txt",
      "type": "String"
    },
    {
      "name": "words",
      "type": "IEnumerable<KeyValuePair<Rectangle,String>>"
    },
    {
      "name": "ocrOut",
      "type": "OcrActivityResult"
    }
  ],
  "body": [
    {
      "act": "GoogleCloudOCR",
      "name": "GoogleCloudOCR（全部入り）",
      "props": {
        "Image": "img",
        "Text": "txt",
        "Result": "words",
        "Output": "ocrOut",
        "ComputeSkewAngle": true,
        "ExtractWords": true,
        "NoopExecution": false,
        "PredictionId": {
          "lit": "uia-c5"
        },
        "Profile": "Screen",
        "Scale": 1.5,
        "ApiKey": {
          "lit": "DUMMY-KEY-NOT-USED"
        },
        "DetectionMode": "DocumentTextDetection",
        "Language": {
          "lit": "ja"
        },
        "Region": "Global",
        "ResizeToApiLimits": true
      },
      "objs": {
        "FilterRegion": {
          "Rectangle": "10, 20, 300, 200"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"OCR: \" & txt"
      }
    }
  ]
}
