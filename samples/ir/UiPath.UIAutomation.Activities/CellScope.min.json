{
  "workflow": "CellScope_Min",
  "variables": [],
  "body": [
    {
      "act": "OpenApplication",
      "name": "SAP Logon を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "saplogon.exe"
        },
        "Selector": {
          "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
        }
      },
      "body": [
        {
          "act": "CellScope",
          "item": "ContextTarget",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<sap id='/app/con[0]/ses[0]/wnd[0]/shellcont/shell' />"
              }
            }
          },
          "props": {
            "RowNumber": 1,
            "ColumnName": {
              "lit": "CARRID"
            }
          },
          "body": [
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "\"セルの中\""
              }
            }
          ]
        }
      ]
    }
  ]
}
