{
  "workflow": "NSAPReadStatusbar_Full",
  "variables": [
    {
      "name": "sbType",
      "type": "String"
    },
    {
      "name": "sbText",
      "type": "String"
    },
    {
      "name": "sbId",
      "type": "String"
    },
    {
      "name": "sbNumber",
      "type": "String"
    },
    {
      "name": "sbData",
      "type": "String[]"
    }
  ],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPReadStatusbar",
          "name": "ステータス バーを読み取り（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/sbar' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "MessageType": "sbType",
            "MessageText": "sbText",
            "MessageId": "sbId",
            "MessageNumber": "sbNumber",
            "MessageData": "sbData",
            "Timeout": 30,
            "DelayBefore": 0.2,
            "DelayAfter": 0.2,
            "ContinueOnError": false,
            "HealingAgentBehavior": "SameAsCard",
            "Description": {
              "lit": "SAP 画面の操作"
            },
            "ForceRefreshView": true
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"ステータス: \" & sbType & \" \" & sbText & \" \" & sbId & \" \" & sbNumber & \" \" & sbData.Length.ToString()"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPReadStatusbar 完了（全部入り）\""
          }
        }
      ]
    }
  ]
}
