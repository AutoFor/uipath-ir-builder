{
  "workflow": "SaveImage_Min",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "img",
      "type": "UiPath.Core.Image"
    },
    {
      "name": "imgPath",
      "type": "String",
      "default": "\"output${n}.png\""
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body style='font-family:Arial'><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick='document.getElementById(\"result\").textContent=\"Hello, [\"+document.getElementById(\"name\").value+\"]\"'>Greet</button><label><input id='agree' type='checkbox'>agree</label><button id='hov' onmousemove='document.getElementById(\"result\").textContent=\"hov hover\"'>HoverMe</button><button id='hide' onclick='document.getElementById(\"box\").style.visibility=\"hidden\"'>Hide</button><button id='hidelater' onclick='setTimeout(function(){document.getElementById(\"box\").style.visibility=\"hidden\"},1500)'>HideLater</button><button id='show' onclick='setTimeout(function(){document.getElementById(\"box\").style.visibility=\"visible\"},1500)'>Show</button><div id='result'>ready</div><div id='box' onclick='document.getElementById(\"result\").textContent=\"box clicked\"' onmousemove='document.getElementById(\"result\").textContent=\"box hover\"' style='width:240px;height:140px;margin:20px;background:#e00000;border:20px solid #0000e0'></div><div id='ocr' onclick='document.getElementById(\"result\").textContent=\"ocr clicked\"' onmousemove='document.getElementById(\"result\").textContent=\"ocr hover\"' style='font:bold 72px Arial;margin:20px;display:inline-block'>HELLO42</div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "TakeScreenshot",
          "name": "四角を撮る（要素だけ）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='box' tag='DIV' />"
              }
            }
          },
          "props": {
            "Screenshot": "img"
          }
        },
        {
          "act": "SaveImage",
          "name": "画像を output に保存",
          "props": {
            "FileName": "imgPath",
            "Image": "img"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & (New System.IO.FileInfo(imgPath).Length > 0).ToString"
      }
    }
  ]
}
