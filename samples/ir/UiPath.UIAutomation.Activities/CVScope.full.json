{
  "workflow": "CVScope_Full",
  "variables": [],
  "body": [
    {
      "act": "CVScope",
      "name": "CV スコープ（全部入り）",
      "item": "CVSessionData",
      "objs": {
        "Target": {
          "Selector": {
            "lit": "<wnd app='notepad.exe' cls='Notepad' />"
          },
          "TimeoutMS": 20000,
          "WaitForReady": "INTERACTIVE"
        }
      },
      "props": {
        "CvMethod": "ElementDetection",
        "ApiKey": {
          "lit": "dummy-key"
        },
        "Server": {
          "lit": "https://cv.example.invalid"
        },
        "UseLocalServer": false,
        "DelayBefore": 100,
        "ContinueOnError": false
      },
      "slots": {
        "OCREngine": [
          {
            "act": "GoogleOCR",
            "name": "Google OCR",
            "props": {
              "Image": "Image"
            }
          }
        ]
      },
      "body": [
        {
          "act": "CvHighlightWithDescriptor",
          "name": "ハイライト",
          "props": {
            "Descriptor": "New UiPath.CV.CvDescriptor()"
          },
          "objs": {
            "DesignTimeDescriptor": {
              "Target": {
                "ElementType": "Button",
                "Text": "OK",
                "ImageAccuracy": 0.8,
                "TextAccuracy": 0.7,
                "UseFuzzy": true
              }
            }
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done\""
      }
    }
  ]
}
