{
  "workflow": "RestoreWindow_Full",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    },
    {
      "name": "win",
      "type": "Window"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "OpenApplication",
      "name": "メモ帳を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "notepad.exe"
        },
        "Arguments": "notePath",
        "Selector": {
          "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
        },
        "ApplicationWindow": "win"
      },
      "body": [
        {
          "act": "MinimizeWindow",
          "name": "MinimizeWindow",
          "props": {
            "Window": "win"
          }
        },
        {
          "act": "RestoreWindow",
          "name": "RestoreWindow",
          "props": {
            "Window": "win",
            "ContinueOnError": false
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"RestoreWindow done\""
          }
        },
        {
          "act": "CloseWindow",
          "name": "メモ帳を閉じる",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            }
          }
        }
      ]
    }
  ]
}
