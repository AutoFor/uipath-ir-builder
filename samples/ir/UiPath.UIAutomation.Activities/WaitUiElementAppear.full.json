{
  "workflow": "WaitUiElementAppear_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "found",
      "type": "UiElement"
    },
    {
      "name": "text",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><script>setTimeout(function(){var d=document.createElement('div');d.id='late';d.textContent='appeared';document.body.appendChild(d)},1500)</script></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "WaitUiElementAppear",
          "name": "late が出るのを待つ（Classic・全部入り）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='late' tag='DIV' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "FoundElement": "found",
            "WaitVisible": true,
            "WaitActive": true,
            "ContinueOnError": false
          }
        },
        {
          "act": "GetValue",
          "name": "見つけた要素の文字を読む",
          "objs": {
            "Target": {
              "Element": "found"
            }
          },
          "props": {
            "Value": "text"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"見つけた: \" & text"
      }
    }
  ]
}
