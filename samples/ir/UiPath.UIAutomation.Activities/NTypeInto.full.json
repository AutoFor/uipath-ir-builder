{
  "workflow": "NTypeInto_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "result",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div></body></html>"
        }
      }
    },
    {
      "act": "NApplicationCard",
      "name": "UIA Test Form を開く",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "Url": "New Uri(htmlPath).AbsoluteUri",
          "BrowserType": "Edge",
          "Selector": {
            "lit": "<html app='msedge.exe' title='UIA Test Form' />"
          }
        }
      },
      "props": {
        "OpenMode": "Always",
        "CloseMode": "Always"
      },
      "body": [
        {
          "act": "NTypeInto",
          "name": "名前を入力（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl id='name' tag='INPUT' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector",
              "WaitForReadyArgument": "Interactive",
              "ElementType": "InputBox"
            },
            "VerifyOptions": {
              "Mode": "Appears",
              "Target": {
                "FullSelectorArgument": {
                  "lit": "<webctrl id='name' tag='INPUT' />"
                },
                "ScopeSelectorArgument": {
                  "lit": "<html app='msedge.exe' title='UIA Test Form' />"
                },
                "SearchSteps": "Selector"
              },
              "Retry": false,
              "Timeout": 5
            }
          },
          "props": {
            "Text": "\"Ji\" & \"ro\"",
            "ClickBeforeMode": "Single",
            "EmptyFieldMode": "SingleLine",
            "ClipboardMode": "Never",
            "DelayBetweenKeys": 0.02,
            "DeselectAfter": false,
            "ActivateBefore": true,
            "AlterIfDisabled": false,
            "InteractionMode": "Simulate",
            "HealingAgentBehavior": "Disabled",
            "Timeout": 20,
            "DelayBefore": 0.1,
            "DelayAfter": 0.3,
            "ContinueOnError": false
          }
        },
        {
          "act": "NClick",
          "name": "Greet を押す",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl id='greet' tag='BUTTON' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector"
            }
          }
        },
        {
          "act": "NGetText",
          "name": "結果を読む",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<webctrl id='result' tag='DIV' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<html app='msedge.exe' title='UIA Test Form' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "TextString": "result"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & result"
      }
    }
  ]
}
