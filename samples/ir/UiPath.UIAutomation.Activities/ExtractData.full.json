{
  "workflow": "ExtractData_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "dt",
      "type": "DataTable",
      "default": "New System.Data.DataTable()"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><table id='tbl'><tr><td>a1</td><td>b1</td></tr><tr><td>a2</td><td>b2</td></tr><tr><td>a3</td><td>b3</td></tr></table></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "ExtractData",
          "name": "表を取り出す（Classic・全部入り）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='tbl' tag='TABLE' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "ExtractMetadata": {
              "lit": "<extract><row exact=\"1\"><webctrl tag=\"TR\" /><column exact=\"1\" name=\"Col1\"><webctrl tag=\"TD\" tableCol=\"1\" /><text /></column><column exact=\"1\" name=\"Col2\"><webctrl tag=\"TD\" tableCol=\"2\" /><text /></column></row></extract>"
            },
            "DataTable": "dt",
            "MaxNumberOfResults": 100,
            "NextLinkSelector": {
              "lit": ""
            },
            "DelayBetweenPagesMS": 300,
            "SimulateClick": true,
            "SendWindowMessages": false,
            "ContinueOnError": false
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"行数: \" & dt.Rows.Count.ToString & \" 先頭: \" & dt.Rows(0)(0).ToString"
      }
    }
  ]
}
