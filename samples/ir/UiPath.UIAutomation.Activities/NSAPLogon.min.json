{
  "workflow": "NSAPLogon_Min",
  "variables": [],
  "body": [
    {
      "act": "NSAPLogon",
      "name": "SAP Logon",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "Arguments": {
            "lit": "SAP"
          },
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never",
        "ConnectionName": {
          "lit": "SAP"
        },
        "ConnectionId": {
          "lit": "sap-connection-id"
        }
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPLogon の中\""
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"NSAPLogon 完了\""
      }
    }
  ]
}
