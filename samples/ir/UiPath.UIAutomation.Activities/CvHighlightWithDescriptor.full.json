{
  "workflow": "CvHighlightWithDescriptor_Full",
  "variables": [],
  "body": [
    {
      "act": "CVScope",
      "name": "CV スコープ",
      "item": "CVSessionData",
      "objs": {
        "Target": {
          "Selector": {
            "lit": "<wnd app='notepad.exe' cls='Notepad' />"
          }
        }
      },
      "body": [
        {
          "act": "CvHighlightWithDescriptor",
          "name": "CvHighlightWithDescriptor（全部入り）",
          "objs": {
            "DesignTimeDescriptor": {
              "Target": {
                "ElementType": "Button",
                "Text": "OK",
                "ImageAccuracy": 0.8,
                "TextAccuracy": 0.7,
                "UseFuzzy": true
              }
            }
          },
          "props": {
            "Descriptor": "New UiPath.CV.CvDescriptor()",
            "Color": "Gold",
            "HighlightTime": 1500,
            "ScrollDirection": "Down",
            "DelayBefore": 100,
            "DelayMS": 200,
            "NumberOfScrolls": 3,
            "DelayScreenshotAfterScroll": 300,
            "TimeoutMS": 15000,
            "ContinueOnError": false
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done\""
      }
    }
  ]
}
