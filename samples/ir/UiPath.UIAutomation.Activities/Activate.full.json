{
  "workflow": "Activate_Full",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "Sequence",
      "name": "メモ帳を起動して入る",
      "body": [
        {
          "act": "StartProcess",
          "name": "メモ帳を起動する",
          "props": {
            "FileName": {
              "lit": "notepad.exe"
            },
            "Arguments": "notePath"
          }
        },
        {
          "act": "WindowScope",
          "name": "メモ帳を開く（Classic）",
          "item": "ContextTarget",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            },
            "TimeoutMS": 15000
          },
          "body": [
            {
              "act": "Activate",
              "name": "メモ帳をアクティブにする",
              "objs": {
                "Target": {
                  "Selector": {
                    "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
                  },
                  "TimeoutMS": 10000,
                  "WaitForReady": "INTERACTIVE"
                }
              },
              "props": {
                "DelayBefore": 200,
                "DelayMS": 200,
                "ContinueOnError": false
              }
            },
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "\"activated\""
              }
            },
            {
              "act": "CloseWindow",
              "name": "メモ帳を閉じる",
              "props": {
                "Selector": {
                  "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
