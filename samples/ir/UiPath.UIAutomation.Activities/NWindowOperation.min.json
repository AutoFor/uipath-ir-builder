{
  "workflow": "NWindowOperation_Min",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "テスト用のウィンドウを開く",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
          },
          "Arguments": {
            "lit": "-NoProfile -WindowStyle Hidden -Command \"Add-Type -AssemblyName System.Windows.Forms; $f=New-Object System.Windows.Forms.Form; $f.Text='UIA Window Test'; [System.Windows.Forms.Application]::Run($f)\""
          },
          "Selector": {
            "lit": "<wnd app='powershell.exe' title='UIA Window Test' />"
          }
        }
      },
      "props": {
        "OpenMode": "Always",
        "CloseMode": "Always"
      },
      "body": [
        {
          "act": "NWindowOperation",
          "name": "ウィンドウを最大化する",
          "props": {
            "Operation": "Maximize"
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"maximized\""
          }
        }
      ]
    }
  ]
}
