{
  "workflow": "CopySelectedText_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "copied",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><input id='sel' type='text' value='copyme' onfocus=\"this.select()\"></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "SetFocus",
          "name": "sel にフォーカス（選択される）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='sel' tag='INPUT' />"
              }
            }
          }
        },
        {
          "act": "CopySelectedText",
          "name": "選択中の文字を取る（Classic・全部入り）",
          "props": {
            "Result": "copied",
            "TimeoutMS": 5000,
            "SendWindowMessages": false,
            "ContinueOnError": false
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & copied"
      }
    }
  ]
}
