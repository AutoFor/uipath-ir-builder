{
  "workflow": "CvGetTextWithDescriptor_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "CVScope",
      "name": "CV スコープ",
      "item": "CVSessionData",
      "objs": {
        "Target": {
          "Selector": {
            "lit": "<wnd app='notepad.exe' cls='Notepad' />"
          }
        }
      },
      "body": [
        {
          "act": "CvGetTextWithDescriptor",
          "name": "CvGetTextWithDescriptor（最小）",
          "objs": {
            "DesignTimeDescriptor": {
              "Target": {
                "ElementType": "Button",
                "Text": "OK",
                "ImageAccuracy": 0.8,
                "TextAccuracy": 0.7,
                "UseFuzzy": true
              }
            }
          },
          "props": {
            "Descriptor": "New UiPath.CV.CvDescriptor()",
            "Result": "txt"
          }
        }
      ],
      "slots": {
        "OCREngine": [
          {
            "act": "GoogleOCR",
            "name": "Google OCR",
            "props": {
              "Image": "Image"
            }
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"テキスト: \" & txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done\""
      }
    }
  ]
}
