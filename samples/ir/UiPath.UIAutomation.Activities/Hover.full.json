{
  "workflow": "Hover_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "result",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><div id='hov' onmouseover=\"this.textContent='hovered'\">hover me</div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "Hover",
          "name": "先に別の場所へカーソルを動かす",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl tag='H1' />"
              }
            }
          }
        },
        {
          "act": "Hover",
          "name": "hov に乗せる（Classic・全部入り）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='hov' tag='DIV' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            },
            "CursorPosition": {
              "Position": "Center",
              "OffsetX": 0,
              "OffsetY": 0
            }
          },
          "props": {
            "CursorMotionType": "Smooth",
            "SimulateHover": false,
            "SendWindowMessages": false,
            "DelayBefore": 100,
            "DelayMS": 300,
            "ContinueOnError": false
          }
        },
        {
          "act": "GetValue",
          "name": "結果を読む",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='hov' tag='DIV' />"
              }
            }
          },
          "props": {
            "Value": "result"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & result"
      }
    }
  ]
}
