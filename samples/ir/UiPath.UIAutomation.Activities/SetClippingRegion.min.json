{
  "workflow": "SetClippingRegion_Min",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    },
    {
      "name": "el",
      "type": "UiElement"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "OpenApplication",
      "name": "メモ帳を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "FileName": {
          "lit": "notepad.exe"
        },
        "Arguments": "notePath",
        "Selector": {
          "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
        }
      },
      "body": [
        {
          "act": "SetClippingRegion",
          "name": "クリップ領域を決める",
          "props": {
            "Element": "el",
            "Direction": "RECTANGLE",
            "Region": "New UiPath.Core.Region(New System.Drawing.Rectangle(0, 0, 50, 50))"
          }
        },
        {
          "act": "CloseWindow",
          "name": "メモ帳を閉じる",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            }
          }
        }
      ]
    }
  ]
}
