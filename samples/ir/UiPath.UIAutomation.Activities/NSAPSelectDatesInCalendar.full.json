{
  "workflow": "NSAPSelectDatesInCalendar_Full",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPSelectDatesInCalendar",
          "name": "カレンダから日付を選択（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/usr/cntlCAL/shellcont/shell' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "SelectType": "Range",
            "Date": {
              "vb": "New DateTime(2026, 10, 30)",
              "cs": "new DateTime(2026, 10, 30)"
            },
            "StartDate": {
              "vb": "New DateTime(2026, 10, 1)",
              "cs": "new DateTime(2026, 10, 1)"
            },
            "EndDate": {
              "vb": "New DateTime(2026, 10, 31)",
              "cs": "new DateTime(2026, 10, 31)"
            },
            "Year": 2026,
            "Week": 44,
            "Timeout": 30,
            "DelayBefore": 0.2,
            "DelayAfter": 0.2,
            "ContinueOnError": false,
            "HealingAgentBehavior": "SameAsCard",
            "Description": {
              "lit": "SAP 画面の操作"
            },
            "ForceRefreshView": true
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPSelectDatesInCalendar 完了（全部入り）\""
          }
        }
      ]
    }
  ]
}
