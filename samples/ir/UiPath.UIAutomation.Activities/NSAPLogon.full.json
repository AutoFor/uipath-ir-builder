{
  "workflow": "NSAPLogon_Full",
  "variables": [],
  "body": [
    {
      "act": "NSAPLogon",
      "name": "SAP Logon（全部入り）",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "Arguments": {
            "lit": "SAP"
          },
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never",
        "AttachMode": "ByInstance",
        "Timeout": 30,
        "Retries": 1,
        "DelayBetweenRetries": 1,
        "InteractionMode": "Simulate",
        "WindowResize": "None",
        "ConnectionName": {
          "lit": "SAP"
        },
        "ConnectionId": {
          "lit": "sap-connection-id"
        },
        "IsAuthenticationRequired": false,
        "IsIndicateOnDesktopEnabled": false,
        "ContinueOnError": false,
        "HealingAgentBehavior": "Disabled",
        "Description": {
          "lit": "SAP Logon を使う"
        }
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPLogon の中（全部入り）\""
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"NSAPLogon 完了（全部入り）\""
      }
    }
  ]
}
