{
  "workflow": "WindowScope_Min",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "StartProcess",
      "name": "メモ帳を起動する",
      "props": {
        "FileName": {
          "lit": "notepad.exe"
        },
        "Arguments": "notePath"
      }
    },
    {
      "act": "WindowScope",
      "name": "メモ帳のウィンドウに入る",
      "item": "ContextTarget",
      "props": {
        "Selector": {
          "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
        }
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"in scope\""
          }
        },
        {
          "act": "CloseWindow",
          "name": "メモ帳を閉じる",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            }
          }
        }
      ]
    }
  ]
}
