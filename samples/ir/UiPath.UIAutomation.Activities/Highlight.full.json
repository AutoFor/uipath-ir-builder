{
  "workflow": "Highlight_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "t0",
      "type": "DateTime"
    },
    {
      "name": "sec",
      "type": "Double"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "Assign",
          "props": {
            "To": "t0",
            "Value": "DateTime.Now"
          }
        },
        {
          "act": "Highlight",
          "name": "Greet を強調（Classic・全部入り）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='greet' tag='BUTTON' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "Color": "Gold",
            "HighlightTime": 3000,
            "ContinueOnError": false
          }
        },
        {
          "act": "Assign",
          "props": {
            "To": "sec",
            "Value": "(DateTime.Now - t0).TotalSeconds"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"3秒近くかかった: \" & (sec >= 2.5).ToString"
      }
    }
  ]
}
