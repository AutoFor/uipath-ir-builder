{
  "workflow": "CvExtractDataTableWithDescriptor_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CVScope",
      "name": "CV スコープ",
      "item": "CVSessionData",
      "objs": {
        "Target": {
          "Selector": {
            "lit": "<wnd app='notepad.exe' cls='Notepad' />"
          }
        }
      },
      "body": [
        {
          "act": "CvExtractDataTableWithDescriptor",
          "name": "CvExtractDataTableWithDescriptor（全部入り）",
          "objs": {
            "DesignTimeDescriptor": {
              "Target": {
                "ElementType": "Button",
                "Text": "OK",
                "ImageAccuracy": 0.8,
                "TextAccuracy": 0.7,
                "UseFuzzy": true
              }
            }
          },
          "props": {
            "Descriptor": "New UiPath.CV.CvDescriptor()",
            "Result": "dt",
            "AddHeaders": true,
            "IgnoreEmptyRows": false,
            "RefreshBefore": true,
            "Scroll": false,
            "ScrollDirection": "None",
            "MaxTableScrollHeightInPixels": 30000,
            "DelayBefore": 100,
            "DelayMS": 200,
            "NumberOfScrolls": 3,
            "DelayScreenshotAfterScroll": 300,
            "TimeoutMS": 15000,
            "ContinueOnError": false
          }
        }
      ],
      "slots": {
        "OCREngine": [
          {
            "act": "GoogleOCR",
            "name": "Google OCR",
            "props": {
              "Image": "Image"
            }
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"行数: \" & dt.Rows.Count.ToString"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done\""
      }
    }
  ]
}
