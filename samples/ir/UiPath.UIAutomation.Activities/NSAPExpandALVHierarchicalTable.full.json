{
  "workflow": "NSAPExpandALVHierarchicalTable_Full",
  "variables": [],
  "body": [
    {
      "act": "NApplicationCard",
      "name": "SAP セッションを使う",
      "item": "WSSessionData",
      "objs": {
        "TargetApp": {
          "FilePath": {
            "lit": "C:\\Program Files (x86)\\SAP\\FrontEnd\\SAPgui\\saplogon.exe"
          },
          "Selector": {
            "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
          }
        }
      },
      "props": {
        "OpenMode": "IfNotOpen",
        "CloseMode": "Never"
      },
      "body": [
        {
          "act": "NSAPExpandALVHierarchicalTable",
          "name": "ALV 階層テーブルを展開（全部入り）",
          "objs": {
            "Target": {
              "FullSelectorArgument": {
                "lit": "<sap id='wnd[0]/usr/cntlGRID1/shellcont/shell' />"
              },
              "ScopeSelectorArgument": {
                "lit": "<wnd app='saplogon.exe' cls='SAP_FRONTEND_SESSION' />"
              },
              "SearchSteps": "Selector"
            }
          },
          "props": {
            "ColumnNameLevel0": {
              "lit": "VBELN"
            },
            "ColumnValueLevel0": {
              "lit": "0000001000"
            },
            "ColumnNameLevel1": {
              "lit": "POSNR"
            },
            "ColumnValueLevel1": {
              "lit": "000010"
            },
            "FocusedColumn": {
              "lit": "VBELN"
            },
            "SelectLevel1": true,
            "Timeout": 30,
            "DelayBefore": 0.2,
            "DelayAfter": 0.2,
            "ContinueOnError": false,
            "HealingAgentBehavior": "SameAsCard",
            "Description": {
              "lit": "SAP 画面の操作"
            },
            "ForceRefreshView": true
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"NSAPExpandALVHierarchicalTable 完了（全部入り）\""
          }
        }
      ]
    }
  ]
}
