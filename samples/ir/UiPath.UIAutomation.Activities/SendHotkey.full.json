{
  "workflow": "SendHotkey_Full",
  "variables": [
    {
      "name": "htmlPath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-test-form.html\")"
    },
    {
      "name": "result",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "テスト用の HTML を書く",
      "props": {
        "FileName": "htmlPath",
        "Text": {
          "lit": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UIA Test Form</title></head><body><h1>UIA Test Form</h1><input id='name' type='text' value=''><button id='greet' onclick=\"document.getElementById('result').textContent='Hello, ['+document.getElementById('name').value+']'\">Greet</button><label><input id='agree' type='checkbox'>agree</label><div id='result'>ready</div><input id='box' type='text' onkeydown=\"document.getElementById('result').textContent='key:'+(event.ctrlKey?'ctrl+':'')+event.key\"></body></html>"
        }
      }
    },
    {
      "act": "OpenBrowser",
      "name": "UIA Test Form を開く（Classic）",
      "item": "ContextTarget",
      "props": {
        "Url": "New Uri(htmlPath).AbsoluteUri",
        "BrowserType": "Edge"
      },
      "body": [
        {
          "act": "SendHotkey",
          "name": "Ctrl+A を送る（Classic・全部入り）",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='box' tag='INPUT' />"
              },
              "TimeoutMS": 10000,
              "WaitForReady": "INTERACTIVE"
            }
          },
          "props": {
            "Key": {
              "lit": "a"
            },
            "SpecialKey": false,
            "KeyModifiers": "Ctrl",
            "Activate": true,
            "ClickBeforeTyping": true,
            "EmptyField": false,
            "DelayBefore": 100,
            "DelayBetweenKeys": 50,
            "DelayMS": 300,
            "SendWindowMessages": false,
            "ContinueOnError": false
          }
        },
        {
          "act": "GetValue",
          "name": "結果を読む",
          "objs": {
            "Target": {
              "Selector": {
                "lit": "<webctrl id='result' tag='DIV' />"
              }
            }
          },
          "props": {
            "Value": "result"
          }
        },
        {
          "act": "CloseTab",
          "name": "タブを閉じる"
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & result"
      }
    }
  ]
}
