{
  "workflow": "MinimizeWindow_Min",
  "variables": [
    {
      "name": "notePath",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uia-c3-note.txt\")"
    },
    {
      "name": "win",
      "type": "Window"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "メモ帳に開かせるファイルを書く",
      "props": {
        "FileName": "notePath",
        "Text": {
          "lit": "uia-c3"
        }
      }
    },
    {
      "act": "Sequence",
      "name": "メモ帳を起動して入る",
      "body": [
        {
          "act": "StartProcess",
          "name": "メモ帳を起動する",
          "props": {
            "FileName": {
              "lit": "notepad.exe"
            },
            "Arguments": "notePath"
          }
        },
        {
          "act": "WindowScope",
          "name": "メモ帳を開く（Classic）",
          "item": "ContextTarget",
          "props": {
            "Selector": {
              "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
            },
            "TimeoutMS": 15000,
            "ApplicationWindow": "win"
          },
          "body": [
            {
              "act": "MinimizeWindow",
              "name": "MinimizeWindow",
              "props": {
                "Window": "win"
              }
            },
            {
              "act": "RestoreWindow",
              "name": "RestoreWindow",
              "props": {
                "Window": "win"
              }
            },
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": "\"MinimizeWindow done\""
              }
            },
            {
              "act": "CloseWindow",
              "name": "メモ帳を閉じる",
              "props": {
                "Selector": {
                  "lit": "<wnd app='notepad.exe' title='uia-c3-note.txt*' />"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
