{
  "workflow": "CvClickWithDescriptor_Full",
  "variables": [],
  "body": [
    {
      "act": "CVScope",
      "name": "CV スコープ",
      "item": "CVSessionData",
      "objs": {
        "Target": {
          "Selector": {
            "lit": "<wnd app='notepad.exe' cls='Notepad' />"
          }
        }
      },
      "body": [
        {
          "act": "CvClickWithDescriptor",
          "name": "CvClickWithDescriptor（全部入り）",
          "objs": {
            "DesignTimeDescriptor": {
              "Target": {
                "ElementType": "Button",
                "Text": "OK",
                "ImageAccuracy": 0.8,
                "TextAccuracy": 0.7,
                "UseFuzzy": true
              }
            },
            "CursorPosition": {
              "Position": "Center",
              "OffsetX": 0,
              "OffsetY": 0
            }
          },
          "props": {
            "Descriptor": "New UiPath.CV.CvDescriptor()",
            "ClickType": "CLICK_DOUBLE",
            "MouseButton": "BTN_LEFT",
            "KeyModifiers": "None",
            "CursorMotionType": "Smooth",
            "SimulateClick": false,
            "SendWindowMessages": false,
            "AlterIfDisabled": true,
            "UnblockInput": false,
            "ScrollDirection": "Down",
            "DelayBefore": 100,
            "DelayMS": 200,
            "NumberOfScrolls": 3,
            "DelayScreenshotAfterScroll": 300,
            "TimeoutMS": 15000,
            "ContinueOnError": false
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done\""
      }
    }
  ]
}
