{
  "workflow": "SapApplicationScope_Min",
  "variables": [
    {
      "name": "server",
      "type": "String",
      "default": "\"sap.example.com\""
    }
  ],
  "body": [
    {
      "act": "SapApplicationScope",
      "props": {
        "AppServer": "server",
        "Client": {
          "lit": "100"
        },
        "SystemNumber": {
          "lit": "00"
        },
        "User": {
          "lit": "robot"
        },
        "Password": "New System.Net.NetworkCredential(\"\", \"dummy\").SecurePassword",
        "Language": {
          "lit": "JA"
        }
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"接続先: \" & server"
          }
        }
      ]
    }
  ]
}
