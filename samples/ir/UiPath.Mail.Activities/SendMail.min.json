{
  "workflow": "SendMail_Min",
  "variables": [
    {
      "name": "mailTo",
      "type": "String",
      "default": "\"someone@example.com\""
    }
  ],
  "body": [
    {
      "act": "UiPath.Mail.SMTP.Activities.SendMail",
      "props": {
        "Server": {
          "lit": "smtp.example.com"
        },
        "Port": 587,
        "To": "mailTo",
        "Subject": {
          "lit": "件名"
        },
        "Body": "\"本文 \" & mailTo",
        "Email": {
          "lit": "robot@example.com"
        },
        "Password": {
          "lit": "dummy"
        },
        "SecureConnection": "StartTls"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"送った: \" & mailTo"
      }
    }
  ]
}
