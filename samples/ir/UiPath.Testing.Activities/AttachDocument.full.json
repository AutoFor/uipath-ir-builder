{
  "workflow": "AttachDocument_Full",
  "variables": [ { "name": "path", "type": "String", "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uta-attach.txt\")" } ],
  "body": [
    { "act": "WriteTextFile", "name": "添付するファイルを書く", "props": { "FileName": "path", "Text": { "lit": "attach" } } },
    {
      "act": "AttachDocument",
      "name": "ファイルを添付",
      "props": {
        "ContinueOnError": false,
        "FilePath": "path",
        "Tags": { "vb": "New String() {\"ir\", \"sample\"}", "cs": "new string[] { \"ir\", \"sample\" }" }
      }
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"添付した\"" } }
  ]
}
