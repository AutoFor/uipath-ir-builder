{
  "workflow": "CreateComparisonRule_Min",
  "variables": [
    { "name": "rule", "type": "UiPath.Testing.Activities.Models.ComparisonRule" },
    { "name": "same", "type": "Boolean" },
    { "name": "outPath", "type": "String", "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uta-compare-rule.html\")" }
  ],
  "body": [
    {
      "act": "CreateComparisonRule",
      "name": "ワイルドカードの規則",
      "props": {
        "ComparisonRuleType": "WildcardRule",
        "RuleName": { "lit": "files" },
        "Pattern": { "lit": "file_*" },
        "ComparisonRule": "rule"
      }
    },
    {
      "act": "CompareText",
      "name": "規則つきで比べる",
      "props": {
        "BaselineText": { "lit": "see file_01" },
        "TargetText": { "lit": "see file_99" },
        "ComparisonType": "Word",
        "RulesList": { "vb": "New List(Of UiPath.Testing.Activities.Models.ComparisonRule) From {rule}", "cs": "new List<UiPath.Testing.Activities.Models.ComparisonRule> { rule }" },
        "OutputFilePath": "outPath",
        "ContinueOnFailure": true,
        "Result": "same"
      }
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "vb": "\"same=\" & same.ToString", "cs": "\"same=\" + same.ToString()" } } }
  ]
}
