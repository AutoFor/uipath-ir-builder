{
  "workflow": "CompareText_Min",
  "variables": [
    { "name": "same", "type": "Boolean" },
    { "name": "outPath", "type": "String", "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uta-compare-text.html\")" }
  ],
  "body": [
    {
      "act": "CompareText",
      "name": "行ごとに比べる",
      "props": {
        "BaselineText": { "lit": "a" },
        "TargetText": { "lit": "a" },
        "ComparisonType": "Line",
        "OutputFilePath": "outPath",
        "Result": "same"
      }
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "vb": "\"same=\" & same.ToString", "cs": "\"same=\" + same.ToString()" } } }
  ]
}
