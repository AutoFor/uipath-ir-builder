{
  "workflow": "ComparePdfDocuments_Full",
  "variables": [
    {
      "name": "a",
      "type": "ILocalResource"
    },
    {
      "name": "b",
      "type": "ILocalResource"
    },
    {
      "name": "rule",
      "type": "UiPath.Testing.Activities.Models.ComparisonRule"
    },
    {
      "name": "withRule",
      "type": "Boolean"
    },
    {
      "name": "plain",
      "type": "Boolean"
    },
    {
      "name": "diffs",
      "type": "IEnumerable<UiPath.Testing.Activities.Models.Difference>"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "元の PDF を書く",
      "props": {
        "FileName": {
          "lit": "output\\uta-base.pdf"
        },
        "Text": {
          "lit": "%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>\nendobj\n4 0 obj\n<< /Length 45 >>\nstream\nBT /F1 14 Tf 72 760 Td (Order 123 done) Tj ET\nendstream\nendobj\n5 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\nxref\n0 6\n0000000000 65535 f \n0000000009 00000 n \n0000000058 00000 n \n0000000115 00000 n \n0000000241 00000 n \n0000000336 00000 n \ntrailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n406\n%%EOF\n"
        },
        "Encoding": {
          "lit": "us-ascii"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "name": "数字だけ違う PDF を書く",
      "props": {
        "FileName": {
          "lit": "output\\uta-target.pdf"
        },
        "Text": {
          "lit": "%PDF-1.4\n1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>\nendobj\n4 0 obj\n<< /Length 45 >>\nstream\nBT /F1 14 Tf 72 760 Td (Order 789 done) Tj ET\nendstream\nendobj\n5 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\nxref\n0 6\n0000000000 65535 f \n0000000009 00000 n \n0000000058 00000 n \n0000000115 00000 n \n0000000241 00000 n \n0000000336 00000 n \ntrailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n406\n%%EOF\n"
        },
        "Encoding": {
          "lit": "us-ascii"
        }
      }
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\uta-base.pdf"
        },
        "PathType": "File",
        "Resource": "a"
      }
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\uta-target.pdf"
        },
        "PathType": "File",
        "Resource": "b"
      }
    },
    {
      "act": "CreateComparisonRule",
      "name": "数字を無視する規則",
      "props": {
        "ComparisonRuleType": "RegexRule",
        "RuleName": {
          "lit": "numbers"
        },
        "Pattern": {
          "lit": "\\d+"
        },
        "UsePlaceholder": true,
        "ComparisonRule": "rule"
      }
    },
    {
      "act": "ComparePdfDocuments",
      "name": "規則つきで比べる",
      "props": {
        "BaselinePath": "a",
        "TargetPath": "b",
        "ComparisonType": "Word",
        "OutputFolderPath": {
          "lit": "output"
        },
        "RulesList": {
          "vb": "New List(Of UiPath.Testing.Activities.Models.ComparisonRule) From {rule}",
          "cs": "new List<UiPath.Testing.Activities.Models.ComparisonRule> { rule }"
        },
        "IncludeImages": false,
        "IgnoreIdenticalItems": true,
        "IgnoreImagesLocation": false,
        "ContinueOnFailure": true,
        "Result": "withRule"
      }
    },
    {
      "act": "ComparePdfDocuments",
      "name": "規則なしで比べる",
      "props": {
        "BaselinePath": "a",
        "TargetPath": "b",
        "ComparisonType": "Word",
        "OutputFolderPath": {
          "lit": "output"
        },
        "IncludeImages": false,
        "ContinueOnFailure": true,
        "Result": "plain",
        "Differences": "diffs"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"withRule=\" & withRule.ToString & \" plain=\" & plain.ToString & \" diffs=\" & diffs.Count.ToString",
          "cs": "\"withRule=\" + withRule.ToString() + \" plain=\" + plain.ToString() + \" diffs=\" + diffs.Count().ToString()"
        }
      }
    }
  ]
}
