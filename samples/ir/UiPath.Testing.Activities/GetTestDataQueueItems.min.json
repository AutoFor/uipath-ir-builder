{
  "workflow": "GetTestDataQueueItems_Min",
  "variables": [ { "name": "items", "type": "List<UiPath.Testing.Core.TestDataQueueItem>" } ],
  "body": [
    {
      "act": "GetTestDataQueueItems",
      "name": "テストデータの一覧を取る",
      "props": { "QueueName": { "lit": "IRTestDataQueue" }, "TestDataQueueItems": "items" }
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "vb": "\"件数=\" & items.Count.ToString", "cs": "\"件数=\" + items.Count.ToString()" } } }
  ]
}
