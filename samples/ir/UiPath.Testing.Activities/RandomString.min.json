{
  "workflow": "RandomString_Min",
  "variables": [ { "name": "s", "type": "String" } ],
  "body": [
    { "act": "RandomString", "name": "大文字 8 文字", "props": { "Case": "UpperCase", "Length": 8, "Output": "s" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "vb": "\"length=\" & s.Length.ToString & \" upper=\" & (s = s.ToUpper()).ToString", "cs": "\"length=\" + s.Length + \" upper=\" + (s == s.ToUpper())" } } }
  ]
}
