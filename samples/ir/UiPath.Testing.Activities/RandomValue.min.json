{
  "workflow": "RandomValue_Min",
  "variables": [
    {
      "name": "path",
      "type": "String",
      "default": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"uta-random-value.txt\")"
    },
    {
      "name": "v",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "name": "値の一覧を書く",
      "props": {
        "FileName": "path",
        "Text": {
          "vb": "\"color\" & Environment.NewLine & \"red\"",
          "cs": "\"color\" + Environment.NewLine + \"red\""
        }
      }
    },
    {
      "act": "RandomValue",
      "name": "一覧から選ぶ",
      "props": {
        "FilePath": "path",
        "Value": "v"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"value=\" & v",
          "cs": "\"value=\" + v"
        }
      }
    }
  ]
}
