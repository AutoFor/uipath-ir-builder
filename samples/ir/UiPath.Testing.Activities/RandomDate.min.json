{
  "workflow": "RandomDate_Min",
  "variables": [ { "name": "d", "type": "DateTime" } ],
  "body": [
    { "act": "RandomDate", "name": "2020 年の日付", "props": { "MinDate": "New DateTime(2020, 1, 1)", "MaxDate": "New DateTime(2020, 12, 31)", "Output": "d" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "vb": "\"year=\" & d.Year.ToString", "cs": "\"year=\" + d.Year" } } }
  ]
}
