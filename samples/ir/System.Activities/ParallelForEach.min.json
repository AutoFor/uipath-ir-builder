{
  "workflow": "ParallelForEach_Min",
  "variables": [
    {
      "name": "names",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\", \"c\"}"
    }
  ],
  "body": [
    {
      "act": "System.Activities.Statements.ParallelForEach",
      "typeArg": "String",
      "item": "it",
      "props": {
        "Values": "names"
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"item=\" & it"
          }
        }
      ]
    }
  ]
}
