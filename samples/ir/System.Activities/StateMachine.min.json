{
  "workflow": "StateMachine_Min",
  "body": [
    {
      "act": "StateMachine",
      "stateMachine": {
        "initial": "Start",
        "states": [
          {
            "id": "Start",
            "entry": [
              {
                "act": "LogMessage",
                "props": {
                  "Level": "Info",
                  "Message": {
                    "lit": "start"
                  }
                }
              }
            ],
            "transitions": [
              {
                "to": "Done"
              }
            ]
          },
          {
            "id": "Done",
            "final": true,
            "entry": [
              {
                "act": "LogMessage",
                "props": {
                  "Level": "Info",
                  "Message": {
                    "lit": "done"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
