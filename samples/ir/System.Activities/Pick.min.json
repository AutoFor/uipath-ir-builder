{
  "workflow": "Pick_Min",
  "body": [
    {
      "act": "Pick",
      "branches": [
        {
          "trigger": [
            {
              "act": "Delay",
              "props": {
                "Duration": "TimeSpan.FromMilliseconds(10)"
              }
            }
          ],
          "action": [
            {
              "act": "LogMessage",
              "props": {
                "Level": "Info",
                "Message": {
                  "lit": "picked"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
