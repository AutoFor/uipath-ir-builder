{
  "workflow": "ParallelForEach_Full",
  "variables": [
    {
      "name": "names",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\", \"c\"}"
    },
    {
      "name": "done",
      "type": "Int32",
      "default": "0"
    }
  ],
  "body": [
    {
      "act": "System.Activities.Statements.ParallelForEach",
      "name": "2つ終わったら止める",
      "typeArg": "String",
      "item": "it",
      "props": {
        "Values": "names",
        "CompletionCondition": "done >= 2"
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"item\""
          }
        },
        {
          "act": "Assign",
          "props": {
            "To": "done",
            "Value": "done + 1"
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"done=\" & done.ToString"
      }
    }
  ]
}
