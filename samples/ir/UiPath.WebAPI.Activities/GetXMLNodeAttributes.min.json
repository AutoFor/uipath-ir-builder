{
  "workflow": "GetXMLNodeAttributes_Min",
  "variables": [
    {
      "name": "doc",
      "type": "System.Xml.Linq.XDocument"
    },
    {
      "name": "attrs",
      "type": "IEnumerable<System.Xml.Linq.XAttribute>"
    }
  ],
  "body": [
    {
      "act": "DeserializeXml",
      "props": {
        "XMLString": {
          "lit": "<root><item id=\"1\" kind=\"a\">A</item><item id=\"2\">B</item></root>"
        },
        "XMLDocument": "doc"
      }
    },
    {
      "act": "GetXMLNodeAttributes",
      "props": {
        "ExistingXMLNode": "doc.Root.Elements().First()",
        "Attributes": "attrs"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"attrs=\" & String.Join(\",\", attrs.Select(Function(a) a.Name.LocalName & \"=\" & a.Value))"
      }
    }
  ]
}
