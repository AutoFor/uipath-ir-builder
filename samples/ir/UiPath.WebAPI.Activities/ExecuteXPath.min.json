{
  "workflow": "ExecuteXPath_Min",
  "variables": [
    {
      "name": "res",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "ExecuteXPath",
      "props": {
        "XMLString": {
          "lit": "<root><item id=\"1\" kind=\"a\">A</item><item id=\"2\">B</item></root>"
        },
        "XPathExpression": {
          "lit": "count(/root/item)"
        },
        "Result": "res"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"count=\" & res.ToString"
      }
    }
  ]
}
