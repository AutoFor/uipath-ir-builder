{
  "workflow": "DeserializeXml_Min",
  "variables": [
    {
      "name": "doc",
      "type": "System.Xml.Linq.XDocument"
    }
  ],
  "body": [
    {
      "act": "DeserializeXml",
      "props": {
        "XMLString": {
          "lit": "<root><item id=\"1\" kind=\"a\">A</item><item id=\"2\">B</item></root>"
        },
        "XMLDocument": "doc"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"root=\" & doc.Root.Name.LocalName & \", items=\" & doc.Root.Elements().Count().ToString"
      }
    }
  ]
}
