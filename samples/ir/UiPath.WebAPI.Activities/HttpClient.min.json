{
  "workflow": "HttpClient_Min",
  "variables": [
    {
      "name": "body",
      "type": "String"
    },
    {
      "name": "code",
      "type": "Int32"
    }
  ],
  "body": [
    {
      "act": "HttpClient",
      "props": {
        "EndPoint": {
          "lit": "https://example.com/"
        },
        "Method": "GET",
        "Result": "body",
        "StatusCode": "code"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"status=\" & code.ToString"
      }
    }
  ]
}
