{
  "workflow": "Office365ApplicationScope_Min",
  "variables": [
    {
      "name": "tenant",
      "type": "String",
      "default": "\"contoso.onmicrosoft.com\""
    }
  ],
  "body": [
    {
      "act": "Office365ApplicationScope",
      "props": {
        "AuthenticationType": "ApplicationIdAndSecret",
        "ApplicationId": {
          "lit": "00000000-0000-0000-0000-000000000000"
        },
        "ApplicationSecret": {
          "lit": "dummy"
        },
        "Tenant": "tenant",
        "Services": "Mail"
      },
      "body": [
        {
          "act": "GetMail",
          "props": {
            "Account": {
              "lit": "robot@contoso.onmicrosoft.com"
            },
            "MailFolder": {
              "lit": "Inbox"
            },
            "Top": 1
          }
        },
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "\"tenant=\" & tenant"
          }
        }
      ]
    }
  ]
}
