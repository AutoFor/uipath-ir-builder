{
  "workflow": "CreateExternalTask_Min",
  "variables": [
    { "name": "task", "type": "ExternalTaskData" },
    { "name": "action", "type": "String" }
  ],
  "body": [
    { "act": "CreateExternalTask", "props": { "TaskTitle": { "lit": "外部システムで処理" }, "TaskPriority": "Low", "TaskOutput": "task" } },
    { "act": "WaitForExternalTaskAndResume", "props": { "TaskInput": "task", "TaskAction": "action" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"結果: \" & action" } }
  ]
}
