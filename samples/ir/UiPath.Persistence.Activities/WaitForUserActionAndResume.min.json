{
  "workflow": "WaitForUserActionAndResume_Min",
  "variables": [
    {
      "name": "task",
      "type": "UserActionData"
    },
    {
      "name": "action",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "CreateUserAction",
      "props": {
        "TaskTitle": {
          "lit": "アプリで確認"
        },
        "TaskPriority": "Medium",
        "TaskOutput": "task",
        "SolutionApp": {
          "lit": "uipath-ir-test-approval"
        }
      },
      "objs": {
        "CurrentAppTaskState": {}
      }
    },
    {
      "act": "WaitForUserActionAndResume",
      "props": {
        "TaskInput": "task",
        "TaskAction": "action"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & action"
      }
    }
  ]
}
