{
  "workflow": "FormTaskTenantCheck_Full",
  "arguments": [
    {
      "name": "in_InvoiceNo",
      "dir": "In",
      "type": "String"
    }
  ],
  "variables": [
    {
      "name": "marker",
      "type": "String"
    },
    {
      "name": "task",
      "type": "FormTaskData"
    },
    {
      "name": "action",
      "type": "String"
    },
    {
      "name": "comment",
      "type": "String"
    },
    {
      "name": "note",
      "type": "String"
    },
    {
      "name": "layoutTask",
      "type": "FormTaskData"
    },
    {
      "name": "layoutAction",
      "type": "String"
    },
    {
      "name": "layoutComment",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "Assign",
      "props": {
        "To": "marker",
        "Value": {
          "lit": "wait-before"
        }
      }
    },
    {
      "act": "Assign",
      "props": {
        "To": "note",
        "Value": {
          "lit": "note-initial"
        }
      }
    },
    {
      "act": "CreateFormTask",
      "name": "GenerateInputFields のフォーム",
      "props": {
        "TaskTitle": "\"uipath-ir-test-generated \" & in_InvoiceNo",
        "TaskPriority": "Low",
        "Labels": {
          "lit": "uipath-ir-test"
        },
        "ExternalTag": "in_InvoiceNo",
        "GenerateInputFields": true,
        "FormLayout": {
          "lit": "[{\"type\":\"textfield\",\"key\":\"InvoiceNo\",\"label\":\"請求書\",\"input\":true,\"disabled\":true},{\"type\":\"textfield\",\"key\":\"Comment\",\"label\":\"コメント\",\"input\":true},{\"type\":\"textfield\",\"key\":\"Note\",\"label\":\"メモ\",\"input\":true},{\"type\":\"button\",\"action\":\"event\",\"label\":\"Approve\",\"key\":\"approve\",\"event\":\"Approve\",\"theme\":\"primary\",\"input\":false,\"tableView\":false},{\"type\":\"button\",\"action\":\"event\",\"label\":\"Reject\",\"key\":\"reject\",\"event\":\"Reject\",\"theme\":\"danger\",\"input\":false,\"tableView\":false}]"
        },
        "TaskOutput": "task"
      },
      "dicts": {
        "FormData": [
          {
            "name": "InvoiceNo",
            "dir": "In",
            "type": "String",
            "value": "in_InvoiceNo"
          },
          {
            "name": "Comment",
            "dir": "Out",
            "type": "String",
            "value": "comment"
          },
          {
            "name": "Note",
            "dir": "InOut",
            "type": "String",
            "value": "note"
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"created1 id=\" & Convert.ToString(task.Id) & \" status=\" & Convert.ToString(task.Status)"
      }
    },
    {
      "act": "WaitForFormTaskAndResume",
      "name": "1つ目を待つ",
      "props": {
        "TaskInput": "task",
        "TaskAction": "action",
        "TaskOutput": "task",
        "StatusMessage": {
          "lit": "uipath-ir-test 1"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"resume1 action=\" & action & \" comment=\" & comment & \" note=\" & note & \" marker=\" & marker & \" in=\" & in_InvoiceNo"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"resume1 task.Action=\" & task.Action & \" status=\" & Convert.ToString(task.Status) & \" data=\" & Convert.ToString(task.Data)"
      }
    },
    {
      "act": "CreateFormTask",
      "name": "FormLayout のフォーム",
      "props": {
        "TaskTitle": "\"uipath-ir-test-layout \" & in_InvoiceNo",
        "TaskPriority": "Low",
        "GenerateInputFields": false,
        "FormLayout": {
          "lit": "[{\"type\":\"textfield\",\"key\":\"Comment\",\"label\":\"コメント\",\"input\":true},{\"type\":\"button\",\"action\":\"event\",\"label\":\"Approve\",\"key\":\"approve\",\"event\":\"Approve\",\"theme\":\"primary\",\"input\":false,\"tableView\":false}]"
        },
        "TaskOutput": "layoutTask"
      },
      "dicts": {
        "FormData": [
          {
            "name": "Comment",
            "dir": "Out",
            "type": "String",
            "value": "layoutComment"
          }
        ]
      }
    },
    {
      "act": "WaitForFormTaskAndResume",
      "name": "2つ目を待つ",
      "props": {
        "TaskInput": "layoutTask",
        "TaskAction": "layoutAction",
        "TaskOutput": "layoutTask"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"resume2 action=\" & layoutAction & \" comment=\" & layoutComment & \" marker=\" & marker & \" data=\" & Convert.ToString(layoutTask.Data)"
      }
    }
  ]
}
