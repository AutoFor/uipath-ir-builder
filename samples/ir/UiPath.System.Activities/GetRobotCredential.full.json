{
  "workflow": "GetRobotCredential_Full",
  "variables": [
    {
      "name": "user",
      "type": "String"
    },
    {
      "name": "pass",
      "type": "SecureString"
    }
  ],
  "body": [
    {
      "act": "GetRobotCredential",
      "name": "資格情報を取得",
      "props": {
        "AssetName": {
          "lit": "IRCredential"
        },
        "CacheStrategy": "Execution",
        "FolderPath": {
          "lit": "Shared"
        },
        "Password": "pass",
        "TimeoutMS": 30000,
        "Username": "user"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ユーザー: \" & user"
      }
    }
  ]
}
