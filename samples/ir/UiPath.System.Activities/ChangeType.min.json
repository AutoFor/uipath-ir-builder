{
  "workflow": "ChangeType_Min",
  "variables": [
    { "name": "src", "type": "String", "default": "\"42\"" },
    { "name": "num", "type": "Int32" }
  ],
  "body": [
    { "act": "ChangeType", "typeArg": "Int32", "props": { "SourceValue": "src", "ConvertedValue": "num" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "(num + 1).ToString" } }
  ]
}
