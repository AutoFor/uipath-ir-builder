{
  "workflow": "ReadStorageText_Min",
  "variables": [
    {
      "name": "text",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "ReadStorageText",
      "props": {
        "StorageBucketName": {
          "lit": "ir-bucket"
        },
        "Path": {
          "lit": "ir/hello.txt"
        },
        "Result": "text"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"内容: \" & text"
      }
    }
  ]
}
