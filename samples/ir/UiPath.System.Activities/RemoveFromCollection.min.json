{
  "workflow": "RemoveFromCollection_Min",
  "variables": [
    {
      "name": "items",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\", \"c\"}"
    }
  ],
  "body": [
    {
      "act": "RemoveFromCollection",
      "typeArg": "String",
      "props": {
        "Collection": "items",
        "Item": {
          "lit": "b"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "String.Join(\",\", items)"
      }
    }
  ]
}
