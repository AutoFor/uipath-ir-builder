{
  "workflow": "GetRobotCredential_Min",
  "variables": [
    {
      "name": "user",
      "type": "String"
    },
    {
      "name": "pass",
      "type": "SecureString"
    }
  ],
  "body": [
    {
      "act": "GetRobotCredential",
      "props": {
        "AssetName": {
          "lit": "IRCredential"
        },
        "Password": "pass",
        "Username": "user"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ユーザー: \" & user"
      }
    }
  ]
}
