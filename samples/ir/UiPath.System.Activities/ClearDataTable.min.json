{
  "workflow": "ClearDataTable_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable",
      "default": "New DataTable()"
    }
  ],
  "body": [
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Alice\", 30}",
          "cs": "new object[] {\"Alice\", 30}"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Bob\", 25}",
          "cs": "new object[] {\"Bob\", 25}"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Carol\", 35}",
          "cs": "new object[] {\"Carol\", 35}"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Bob\", 25}",
          "cs": "new object[] {\"Bob\", 25}"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    },
    {
      "act": "ClearDataTable",
      "props": {
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & dt.Columns.Count.ToString",
          "cs": "\"columns=\" + dt.Columns.Count"
        }
      }
    }
  ]
}
