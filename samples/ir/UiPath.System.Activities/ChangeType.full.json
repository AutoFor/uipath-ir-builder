{
  "workflow": "ChangeType_Full",
  "variables": [
    { "name": "n", "type": "Int32", "default": "7" },
    { "name": "asText", "type": "String" },
    { "name": "flagText", "type": "String", "default": "\"True\"" },
    { "name": "flag", "type": "Boolean" }
  ],
  "body": [
    { "act": "ChangeType", "name": "数値を文字列に", "typeArg": "String", "props": { "SourceValue": "n", "ConvertedValue": "asText" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"文字列: \" & asText" } },
    { "act": "ChangeType", "name": "文字列を真偽値に", "typeArg": "Boolean", "props": { "SourceValue": "flagText", "ConvertedValue": "flag" } },
    { "act": "If", "props": { "Condition": "flag" }, "then": [{ "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "真偽値: True" } } }], "else": [{ "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "真偽値: False" } } }] }
  ]
}
