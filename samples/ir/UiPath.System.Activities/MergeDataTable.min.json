{
  "workflow": "MergeDataTable_Min",
  "variables": [
    {
      "name": "dest",
      "type": "DataTable",
      "default": "New DataTable()"
    },
    {
      "name": "src",
      "type": "DataTable",
      "default": "New DataTable()"
    }
  ],
  "body": [
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "dest"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "dest"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Alice\", 30}",
          "cs": "new object[] {\"Alice\", 30}"
        },
        "DataTable": "dest"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Bob\", 25}",
          "cs": "new object[] {\"Bob\", 25}"
        },
        "DataTable": "dest"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "src"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "src"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Carol\", 35}",
          "cs": "new object[] {\"Carol\", 35}"
        },
        "DataTable": "src"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Dave\", 40}",
          "cs": "new object[] {\"Dave\", 40}"
        },
        "DataTable": "src"
      }
    },
    {
      "act": "MergeDataTable",
      "props": {
        "Source": "src",
        "Destination": "dest"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dest.Rows.Count.ToString",
          "cs": "\"rows=\" + dest.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"names=\" & String.Join(\",\", dest.Rows.Cast(Of DataRow).Select(Function(r) r(\"Name\").ToString))",
          "cs": "\"names=\" + string.Join(\",\", dest.Rows.Cast<DataRow>().Select(r => r[\"Name\"].ToString()))"
        }
      }
    }
  ]
}
