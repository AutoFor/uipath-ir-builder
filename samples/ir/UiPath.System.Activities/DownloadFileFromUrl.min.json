{
  "workflow": "DownloadFileFromUrl_Min",
  "variables": [
    {
      "name": "res",
      "type": "ILocalResource"
    }
  ],
  "body": [
    {
      "act": "DownloadFileFromUrl",
      "props": {
        "Url": {
          "lit": "https://example.com/"
        },
        "ResponseAttachment": "res"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "System.IO.File.Exists(res.LocalPath).ToString()"
      }
    }
  ]
}
