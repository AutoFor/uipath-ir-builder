{
  "workflow": "AppendLine_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\AppendLine_Min.txt"
        },
        "Text": {
          "lit": "first"
        }
      }
    },
    {
      "act": "AppendLine",
      "props": {
        "FileName": {
          "lit": "output\\AppendLine_Min.txt"
        },
        "Text": {
          "lit": "second"
        }
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\AppendLine_Min.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt.Replace(Environment.NewLine, \"|\")"
      }
    }
  ]
}
