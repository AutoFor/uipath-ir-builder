{
  "workflow": "AddDataColumn_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable",
      "default": "New DataTable()"
    }
  ],
  "body": [
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & dt.Columns.Count.ToString",
          "cs": "\"columns=\" + dt.Columns.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"column1=\" & dt.Columns(1).ColumnName & \":\" & dt.Columns(1).DataType.Name",
          "cs": "\"column1=\" + dt.Columns[1].ColumnName + \":\" + dt.Columns[1].DataType.Name"
        }
      }
    }
  ]
}
