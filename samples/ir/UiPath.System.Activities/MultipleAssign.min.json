{
  "workflow": "MultipleAssign_Min",
  "variables": [{ "name": "a", "type": "Int32" }, { "name": "b", "type": "Int32" }],
  "body": [
    { "act": "MultipleAssign", "assigns": [{ "to": "a", "value": "1" }, { "to": "b", "value": "2" }] },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"a=\" & a.ToString & \", b=\" & b.ToString" } }
  ]
}
