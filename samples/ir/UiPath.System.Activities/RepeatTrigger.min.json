{
  "workflow": "RepeatTrigger_Min",
  "body": [
    {
      "act": "TriggerScope",
      "name": "トリガーの範囲",
      "props": {},
      "slots": {
        "Triggers": [
          {
            "act": "RepeatTrigger",
            "props": {
              "Interval": "TimeSpan.FromSeconds(1)"
            }
          }
        ],
        "Action": [
          {
            "act": "LogMessage",
            "props": {
              "Level": "Info",
              "Message": {
                "lit": "発火した"
              }
            }
          },
          {
            "act": "StopTriggers",
            "props": {
              "ShouldStop": "stp"
            }
          }
        ]
      },
      "variables": [
        {
          "name": "stp",
          "type": "Boolean"
        }
      ],
      "item": "args"
    }
  ]
}
