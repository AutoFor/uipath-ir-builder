{
  "workflow": "GetProcesses_Min",
  "variables": [
    {
      "name": "procs",
      "type": "Collection<Process>"
    }
  ],
  "body": [
    {
      "act": "GetProcesses",
      "props": {
        "Processes": "procs"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"any=\" & (procs.Count > 0).ToString"
      }
    }
  ]
}
