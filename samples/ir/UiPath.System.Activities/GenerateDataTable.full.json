{
  "workflow": "GenerateDataTable_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "GenerateDataTable",
      "name": "文字列から表を作る",
      "props": {
        "Input": {
          "lit": "Name;Age;Note\nAlice;30;\"x;y\"\nBob;25"
        },
        "ColumnSeparators": {
          "lit": ";"
        },
        "NewLineSeparator": {
          "lit": "\n"
        },
        "CSVParsing": true,
        "AutoDetectTypes": true,
        "PreserveStrings": false,
        "PreserveNewLines": false,
        "AllowMisalignedColumns": true,
        "UseColumnHeader": true,
        "UseRowHeader": false,
        "ContinueOnError": false,
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & dt.Columns.Count.ToString",
          "cs": "\"columns=\" + dt.Columns.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"note0=\" & dt.Rows(0)(\"Note\").ToString",
          "cs": "\"note0=\" + dt.Rows[0][\"Note\"].ToString()"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"Age.Type=\" & dt.Columns(\"Age\").DataType.Name",
          "cs": "\"Age.Type=\" + dt.Columns[\"Age\"].DataType.Name"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"name1=\" & dt.Rows(1)(\"Name\").ToString",
          "cs": "\"name1=\" + dt.Rows[1][\"Name\"].ToString()"
        }
      }
    }
  ]
}
