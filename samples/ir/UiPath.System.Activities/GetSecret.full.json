{
  "workflow": "GetSecret_Full",
  "variables": [
    {
      "name": "secret",
      "type": "SecureString"
    }
  ],
  "body": [
    {
      "act": "GetSecret",
      "name": "シークレットを取得",
      "props": {
        "AssetName": {
          "lit": "IRSecret"
        },
        "FolderPath": {
          "lit": "Shared"
        },
        "Secret": "secret",
        "TimeoutMS": 30000
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"シークレットを取得した\""
      }
    }
  ]
}
