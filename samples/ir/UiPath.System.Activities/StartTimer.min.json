{
  "workflow": "StartTimer_Min",
  "variables": [
    {
      "name": "t",
      "type": "Timer"
    }
  ],
  "body": [
    {
      "act": "StartTimer",
      "props": {
        "Timer": "t"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"タイマーを開始: \" & (t IsNot Nothing).ToString"
      }
    }
  ]
}
