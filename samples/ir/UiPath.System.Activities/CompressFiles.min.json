{
  "workflow": "CompressFiles_Min",
  "variables": [
    {
      "name": "ex",
      "type": "Boolean"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CompressFiles_Min.a.txt"
        },
        "Text": {
          "lit": "aaa"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CompressFiles_Min.b.txt"
        },
        "Text": {
          "lit": "bbb"
        }
      }
    },
    {
      "act": "CompressFiles",
      "props": {
        "CompressedFileName": {
          "lit": "output\\CompressFiles_Min.zip"
        }
      },
      "lists": {
        "ContentToArchive": [
          {
            "lit": "output\\CompressFiles_Min.a.txt"
          },
          {
            "lit": "output\\CompressFiles_Min.b.txt"
          }
        ]
      }
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\CompressFiles_Min.zip"
        },
        "PathType": "File",
        "Exists": "ex"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "ex.ToString()"
      }
    }
  ]
}
