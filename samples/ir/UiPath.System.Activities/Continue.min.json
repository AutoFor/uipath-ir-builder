{
  "workflow": "Continue_Min",
  "variables": [{ "name": "items", "type": "List<String>", "default": "New List(Of String) From {\"a\", \"b\", \"c\"}" }],
  "body": [
    {
      "act": "ForEach", "typeArg": "String", "item": "it", "props": { "Values": "items" },
      "body": [
        { "act": "If", "props": { "Condition": "it = \"b\"" }, "then": [{ "act": "Continue" }] },
        { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"要素: \" & it" } }
      ]
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "ループの後" } } }
  ]
}
