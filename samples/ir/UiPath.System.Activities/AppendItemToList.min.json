{
  "workflow": "AppendItemToList_Min",
  "variables": [
    {
      "name": "names",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\"}"
    }
  ],
  "body": [
    {
      "act": "AppendItemToList",
      "typeArg": "String",
      "props": {
        "List": "names",
        "ItemToAppend": {
          "lit": "b"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "String.Join(\",\", names)"
      }
    }
  ]
}
