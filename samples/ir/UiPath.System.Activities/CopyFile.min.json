{
  "workflow": "CopyFile_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\CopyFile_Min.dst.txt"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CopyFile_Min.src.txt"
        },
        "Text": {
          "lit": "copy me"
        }
      }
    },
    {
      "act": "CopyFile",
      "props": {
        "Path": {
          "lit": "output\\CopyFile_Min.src.txt"
        },
        "Destination": {
          "lit": "output\\CopyFile_Min.dst.txt"
        }
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CopyFile_Min.dst.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt"
      }
    }
  ]
}
