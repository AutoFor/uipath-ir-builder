{
  "workflow": "IfElseIfV2_Min",
  "variables": [
    {
      "name": "label",
      "type": "String",
      "default": "\"none\""
    },
    {
      "name": "count",
      "type": "Int32",
      "default": "2"
    }
  ],
  "body": [
    {
      "act": "IfElseIfV2",
      "name": "大きさで分ける",
      "props": {
        "Condition": "count + 3 > 4"
      },
      "then": [
        {
          "act": "Assign",
          "props": {
            "To": "label",
            "Value": "\"big: \" & count.ToString & \" label\""
          }
        }
      ],
      "else": [
        {
          "act": "Assign",
          "props": {
            "To": "label",
            "Value": {
              "lit": "small"
            }
          }
        }
      ]
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"結果: \" & label"
      }
    }
  ]
}
