{
  "workflow": "JoinDataTables_Min",
  "variables": [
    {
      "name": "a",
      "type": "DataTable",
      "default": "New DataTable()"
    },
    {
      "name": "b",
      "type": "DataTable",
      "default": "New DataTable()"
    },
    {
      "name": "res",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "a"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "a"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Alice\", 30}",
          "cs": "new object[] {\"Alice\", 30}"
        },
        "DataTable": "a"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Bob\", 25}",
          "cs": "new object[] {\"Bob\", 25}"
        },
        "DataTable": "a"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Carol\", 35}",
          "cs": "new object[] {\"Carol\", 35}"
        },
        "DataTable": "a"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "b"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "City"
        },
        "DataTable": "b"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Alice\", \"Tokyo\"}",
          "cs": "new object[] {\"Alice\", \"Tokyo\"}"
        },
        "DataTable": "b"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Bob\", \"Osaka\"}",
          "cs": "new object[] {\"Bob\", \"Osaka\"}"
        },
        "DataTable": "b"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Dave\", \"Nagoya\"}",
          "cs": "new object[] {\"Dave\", \"Nagoya\"}"
        },
        "DataTable": "b"
      }
    },
    {
      "act": "JoinDataTables",
      "props": {
        "DataTable1": "a",
        "DataTable2": "b",
        "OutputDataTable": "res"
      },
      "lists": {
        "Arguments": [
          {
            "Column1": {
              "lit": "Name"
            },
            "Operator": "EQ",
            "Column2": {
              "lit": "Name"
            }
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & res.Rows.Count.ToString",
          "cs": "\"rows=\" + res.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"city0=\" & res.Rows(0)(3).ToString",
          "cs": "\"city0=\" + res.Rows[0][3].ToString()"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"city1=\" & res.Rows(1)(3).ToString",
          "cs": "\"city1=\" + res.Rows[1][3].ToString()"
        }
      }
    }
  ]
}
