{
  "workflow": "UpdateListItem_Min",
  "variables": [
    {
      "name": "names",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\", \"c\"}"
    }
  ],
  "body": [
    {
      "act": "UpdateListItem",
      "typeArg": "String",
      "props": {
        "List": "names",
        "ItemIndex": "1",
        "Value": {
          "lit": "B"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "String.Join(\",\", names)"
      }
    }
  ]
}
