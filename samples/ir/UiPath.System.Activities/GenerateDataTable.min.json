{
  "workflow": "GenerateDataTable_Min",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "GenerateDataTable",
      "props": {
        "Input": {
          "lit": "Name,Age\nAlice,30\nBob,25"
        },
        "UseColumnHeader": true,
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & String.Join(\",\", dt.Columns.Cast(Of DataColumn).Select(Function(c) c.ColumnName))",
          "cs": "\"columns=\" + string.Join(\",\", dt.Columns.Cast<DataColumn>().Select(c => c.ColumnName))"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"name=\" & dt.Rows(1)(\"Name\").ToString",
          "cs": "\"name=\" + dt.Rows[1][\"Name\"].ToString()"
        }
      }
    }
  ]
}
