{
  "workflow": "SplitText_Min",
  "variables": [
    {
      "name": "parts",
      "type": "IEnumerable<String>"
    }
  ],
  "body": [
    {
      "act": "SplitText",
      "props": {
        "Source": {
          "lit": "a,b,c"
        },
        "Separator": {
          "lit": ","
        },
        "Results": "parts"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "String.Join(\"|\", parts)",
          "cs": "string.Join(\"|\", parts)"
        }
      }
    }
  ]
}
