{
  "workflow": "CombineText_Min",
  "variables": [
    {
      "name": "parts",
      "type": "List<String>"
    },
    {
      "name": "r",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "Assign",
      "typeArg": "List<String>",
      "props": {
        "To": "parts",
        "Value": {
          "vb": "New List(Of String) From {\"a\", \"b\", \"c\"}",
          "cs": "new List<string> { \"a\", \"b\", \"c\" }"
        }
      }
    },
    {
      "act": "CombineText",
      "props": {
        "Source": "parts",
        "Separator": {
          "lit": "-"
        },
        "Result": "r"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "r"
      }
    }
  ]
}
