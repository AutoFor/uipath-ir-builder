{
  "workflow": "SetSecret_Secure",
  "variables": [
    {
      "name": "ssec",
      "type": "SecureString",
      "default": "New System.Net.NetworkCredential(\"\", \"s3\").SecurePassword"
    }
  ],
  "body": [
    {
      "act": "SetSecret",
      "props": {
        "AssetName": {
          "lit": "IRSecret"
        },
        "FolderPath": {
          "lit": "Shared"
        },
        "SecureSecretValue": "ssec",
        "TimeoutMS": 30000
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"シークレットを設定した\""
      }
    }
  ]
}
