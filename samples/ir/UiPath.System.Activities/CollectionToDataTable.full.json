{
  "workflow": "CollectionToDataTable_Full",
  "variables": [
    {
      "name": "items",
      "type": "List<Int32>",
      "default": "New List(Of Integer) From {10, 20}"
    },
    {
      "name": "dt",
      "type": "DataTable"
    }
  ],
  "body": [
    {
      "act": "CollectionToDataTable",
      "name": "コレクションを表にする",
      "typeArg": "Int32",
      "props": {
        "Collection": "items",
        "DataTable": "dt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & dt.Columns.Count.ToString",
          "cs": "\"columns=\" + dt.Columns.Count"
        }
      }
    }
  ]
}
