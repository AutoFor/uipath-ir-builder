{
  "workflow": "DownloadStorageFile_Min",
  "variables": [
    {
      "name": "file",
      "type": "ILocalResource"
    }
  ],
  "body": [
    {
      "act": "DownloadStorageFile",
      "props": {
        "StorageBucketName": {
          "lit": "ir-bucket"
        },
        "Path": {
          "lit": "ir/report.txt"
        },
        "Result": "file"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ダウンロードした: \" & file.LocalPath"
      }
    }
  ]
}
