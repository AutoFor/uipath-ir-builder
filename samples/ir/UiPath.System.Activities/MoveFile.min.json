{
  "workflow": "MoveFile_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    },
    {
      "name": "srcEx",
      "type": "Boolean"
    }
  ],
  "body": [
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\MoveFile_Min.dst.txt"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\MoveFile_Min.src.txt"
        },
        "Text": {
          "lit": "move me"
        }
      }
    },
    {
      "act": "MoveFile",
      "props": {
        "Path": {
          "lit": "output\\MoveFile_Min.src.txt"
        },
        "Destination": {
          "lit": "output\\MoveFile_Min.dst.txt"
        }
      }
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\MoveFile_Min.src.txt"
        },
        "PathType": "File",
        "Exists": "srcEx"
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\MoveFile_Min.dst.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "srcEx.ToString()"
      }
    }
  ]
}
