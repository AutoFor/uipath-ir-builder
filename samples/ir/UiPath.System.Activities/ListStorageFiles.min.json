{
  "workflow": "ListStorageFiles_Min",
  "variables": [
    {
      "name": "files",
      "type": "IEnumerable<StorageFileInfo>"
    }
  ],
  "body": [
    {
      "act": "ListStorageFiles",
      "props": {
        "StorageBucketName": {
          "lit": "ir-bucket"
        },
        "Directory": {
          "lit": "/"
        },
        "Result": "files"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ファイル数: \" & files.Count().ToString"
      }
    }
  ]
}
