{
  "workflow": "ForEachFileX_Min",
  "variables": [],
  "body": [
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\ForEachFileX_Min.d"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "CreateDirectory",
      "props": {
        "Path": {
          "lit": "output\\ForEachFileX_Min.d"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\ForEachFileX_Min.d\\b.txt"
        },
        "Text": {
          "lit": "b"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\ForEachFileX_Min.d\\a.txt"
        },
        "Text": {
          "lit": "a"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\ForEachFileX_Min.d\\c.log"
        },
        "Text": {
          "lit": "c"
        }
      }
    },
    {
      "act": "ForEachFileX",
      "item": [
        "CurrentFile",
        "CurrentIndex"
      ],
      "props": {
        "Folder": {
          "lit": "output\\ForEachFileX_Min.d"
        }
      },
      "body": [
        {
          "act": "LogMessage",
          "props": {
            "Level": "Info",
            "Message": "CurrentFile.Name"
          }
        }
      ]
    }
  ]
}
