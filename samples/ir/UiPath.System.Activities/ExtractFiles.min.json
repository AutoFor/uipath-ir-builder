{
  "workflow": "ExtractFiles_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\ExtractFiles_Min.a.txt"
        },
        "Text": {
          "lit": "extract me"
        }
      }
    },
    {
      "act": "CompressFiles",
      "props": {
        "CompressedFileName": {
          "lit": "output\\ExtractFiles_Min.zip"
        }
      },
      "lists": {
        "ContentToArchive": [
          {
            "lit": "output\\ExtractFiles_Min.a.txt"
          }
        ]
      }
    },
    {
      "act": "ExtractFiles",
      "props": {
        "FileToExtract": {
          "lit": "output\\ExtractFiles_Min.zip"
        },
        "DestinationFolder": {
          "lit": "output\\ExtractFiles_Min"
        }
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\ExtractFiles_Min\\ExtractFiles_Min\\ExtractFiles_Min.a.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt"
      }
    }
  ]
}
