{
  "workflow": "InvokeComMethod_Min",
  "variables": [
    {
      "name": "res",
      "type": "Object"
    }
  ],
  "body": [
    {
      "act": "InvokeComMethod",
      "props": {
        "ProgID": {
          "lit": "Scripting.FileSystemObject"
        },
        "MethodName": {
          "lit": "GetBaseName"
        },
        "Result": "res"
      },
      "dicts": {
        "Arguments": [
          {
            "name": "path",
            "dir": "In",
            "type": "String",
            "value": {
              "lit": "C:/dir/sample.txt"
            }
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "res.ToString()"
      }
    }
  ]
}
