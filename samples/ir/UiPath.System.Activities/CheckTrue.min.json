{
  "workflow": "CheckTrue_Min",
  "body": [
    {
      "act": "TryCatch",
      "body": [
        { "act": "CheckTrue", "props": { "Expression": "1 + 1 = 2" } },
        { "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "チェックを通った" } } },
        { "act": "CheckTrue", "props": { "Expression": "1 + 1 = 3" } },
        { "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "ここには来ない" } } }
      ],
      "catches": [{ "type": "Exception", "var": "ex", "body": [{ "act": "LogMessage", "props": { "Level": "Info", "Message": { "lit": "例外が出た" } } }] }]
    }
  ]
}
