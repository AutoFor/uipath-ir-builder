{
  "workflow": "ExistsInCollection_Min",
  "variables": [
    {
      "name": "items",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\"}"
    },
    {
      "name": "found",
      "type": "Boolean"
    }
  ],
  "body": [
    {
      "act": "ExistsInCollection",
      "typeArg": "String",
      "props": {
        "Collection": "items",
        "Item": {
          "lit": "b"
        },
        "Exists": "found"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"found=\" & found.ToString"
      }
    }
  ]
}
