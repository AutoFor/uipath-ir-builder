{
  "workflow": "GetUsernamePasswordX_Full",
  "variables": [
    {
      "name": "cred",
      "type": "PasswordCredentials"
    }
  ],
  "body": [
    {
      "act": "GetUsernamePasswordX",
      "name": "ユーザー名とパスワードを取得",
      "props": {
        "AutosubmitTimeoutSeconds": "10",
        "Credential": "cred",
        "CredentialName": {
          "lit": "IRCredential"
        },
        "CredentialsSource": "Orchestrator",
        "OrchestratorCredentialName": {
          "lit": "IRCredential"
        },
        "OrchestratorFolderPath": {
          "lit": "Shared"
        },
        "TimeoutInSeconds": "30"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ユーザー: \" & cred.Username"
      }
    }
  ]
}
