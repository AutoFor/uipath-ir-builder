{
  "workflow": "InvokeVBScript_Min",
  "variables": [
    {
      "name": "outText",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"irb-vbs-min.vbs\")",
        "Text": {
          "lit": "WScript.Echo \"hello from vbs\""
        }
      }
    },
    {
      "act": "InvokeVBScript",
      "props": {
        "FileName": "System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"irb-vbs-min.vbs\")",
        "Result": "outText"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "outText.Trim()"
      }
    }
  ]
}
