{
  "workflow": "CopyFolderX_Min",
  "variables": [
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\CopyFolderX_Min.src"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\CopyFolderX_Min.dst"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "CreateDirectory",
      "props": {
        "Path": {
          "lit": "output\\CopyFolderX_Min.src"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CopyFolderX_Min.src\\a.txt"
        },
        "Text": {
          "lit": "copy folder"
        }
      }
    },
    {
      "act": "CreateDirectory",
      "props": {
        "Path": {
          "lit": "output\\CopyFolderX_Min.dst"
        }
      }
    },
    {
      "act": "CopyFolderX",
      "props": {
        "From": {
          "lit": "output\\CopyFolderX_Min.src"
        },
        "To": {
          "lit": "output\\CopyFolderX_Min.dst"
        }
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\CopyFolderX_Min.dst\\CopyFolderX_Min.src\\a.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt"
      }
    }
  ]
}
