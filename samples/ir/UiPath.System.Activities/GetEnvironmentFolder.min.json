{
  "workflow": "GetEnvironmentFolder_Min",
  "variables": [
    {
      "name": "folder",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "GetEnvironmentFolder",
      "props": {
        "SpecialFolder": "Desktop",
        "FolderPath": "folder"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "System.IO.Path.GetFileName(folder)"
      }
    }
  ]
}
