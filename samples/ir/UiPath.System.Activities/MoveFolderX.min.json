{
  "workflow": "MoveFolderX_Min",
  "variables": [
    {
      "name": "ex",
      "type": "Boolean"
    },
    {
      "name": "txt",
      "type": "String"
    }
  ],
  "body": [
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\MoveFolderX_Min.src"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "Delete",
      "props": {
        "Path": {
          "lit": "output\\MoveFolderX_Min.dst"
        },
        "ContinueOnError": true
      }
    },
    {
      "act": "CreateDirectory",
      "props": {
        "Path": {
          "lit": "output\\MoveFolderX_Min.src"
        }
      }
    },
    {
      "act": "WriteTextFile",
      "props": {
        "FileName": {
          "lit": "output\\MoveFolderX_Min.src\\a.txt"
        },
        "Text": {
          "lit": "move folder"
        }
      }
    },
    {
      "act": "CreateDirectory",
      "props": {
        "Path": {
          "lit": "output\\MoveFolderX_Min.dst"
        }
      }
    },
    {
      "act": "MoveFolderX",
      "props": {
        "From": {
          "lit": "output\\MoveFolderX_Min.src"
        },
        "To": {
          "lit": "output\\MoveFolderX_Min.dst"
        }
      }
    },
    {
      "act": "ReadTextFile",
      "props": {
        "FileName": {
          "lit": "output\\MoveFolderX_Min.dst\\MoveFolderX_Min.src\\a.txt"
        },
        "Content": "txt"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "txt"
      }
    },
    {
      "act": "PathExists",
      "props": {
        "Path": {
          "lit": "output\\MoveFolderX_Min.src"
        },
        "PathType": "Folder",
        "Exists": "ex"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "ex.ToString()"
      }
    }
  ]
}
