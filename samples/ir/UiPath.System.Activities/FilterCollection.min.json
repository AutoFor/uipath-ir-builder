{
  "workflow": "FilterCollection_Min",
  "variables": [
    { "name": "numbers", "type": "List<Int32>", "default": "New List(Of Int32) From {1, 5, 8, 12}" },
    { "name": "filtered", "type": "List<Int32>" }
  ],
  "body": [
    {
      "act": "FilterCollection",
      "typeArg": "Int32",
      "props": { "Collection": "numbers", "FilterAction": "KeepMatchingElementsOnly", "Result": "filtered" },
      "objs": {
        "Filter": {
          "LogicalOperator": "And",
          "Filters": [
            { "$typeArg": "Int32", "Criteria": { "lit": "CurrentItem" }, "Operator": { "$type": "GreaterThanOperator" }, "Value": 5 }
          ]
        }
      }
    },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"filtered=\" & String.Join(\",\", filtered)" } },
    { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"source=\" & String.Join(\",\", numbers)" } }
  ]
}
