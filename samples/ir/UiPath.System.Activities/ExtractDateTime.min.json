    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "ds.First().ToString(\"yyyy-MM-dd\")",
          "cs": "ds.First().ToString(\"yyyy-MM-dd\")"
        }
      }
    }
  ]
