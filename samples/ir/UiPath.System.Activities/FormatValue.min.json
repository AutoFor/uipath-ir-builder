{
  "workflow": "FormatValue_Min",
  "variables": [
    {
      "name": "gv",
      "type": "GenericValue"
    }
  ],
  "body": [
    {
      "act": "Assign",
      "typeArg": "GenericValue",
      "props": {
        "To": "gv",
        "Value": "1234567.891"
      }
    },
    {
      "act": "FormatValue",
      "props": {
        "Value": "gv"
      },
      "objs": {
        "Format": {
          "DecimalDigits": 2,
          "DecimalSeparator": {
            "lit": "."
          },
          "GroupSeparator": {
            "lit": ","
          }
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "gv.ToString"
      }
    }
  ]
}
