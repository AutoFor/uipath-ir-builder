{
  "workflow": "ReadListItem_Full",
  "variables": [
    {
      "name": "names",
      "type": "List<String>",
      "default": "New List(Of String) From {\"a\", \"b\", \"c\"}"
    },
    {
      "name": "got",
      "type": "String"
    },
    {
      "name": "at",
      "type": "Int32",
      "default": "2"
    }
  ],
  "body": [
    {
      "act": "ReadListItem",
      "name": "位置で読む",
      "typeArg": "String",
      "props": {
        "List": "names",
        "ItemIndex": "at",
        "Value": "got"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"got=\" & got"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "String.Join(\",\", names)"
      }
    }
  ]
}
