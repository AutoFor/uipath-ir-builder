{
  "workflow": "KillProcess_Min",
  "variables": [
    {
      "name": "sleeper",
      "type": "Process"
    }
  ],
  "body": [
    {
      "act": "Assign",
      "name": "ping を起動",
      "typeArg": "Process",
      "props": {
        "To": "sleeper",
        "Value": {
          "vb": "System.Diagnostics.Process.Start(New System.Diagnostics.ProcessStartInfo(\"ping.exe\", \"-n 60 127.0.0.1\") With {.UseShellExecute = False, .CreateNoWindow = True})",
          "cs": "System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(\"ping.exe\", \"-n 60 127.0.0.1\") { UseShellExecute = false, CreateNoWindow = true })"
        }
      }
    },
    {
      "act": "KillProcess",
      "props": {
        "Process": "sleeper"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"exited=\" & sleeper.WaitForExit(5000).ToString"
      }
    }
  ]
}
