{
  "workflow": "AppendItemToCollection_Min",
  "variables": [
    {
      "name": "items",
      "type": "List<String>",
      "default": "New List(Of String)"
    }
  ],
  "body": [
    {
      "act": "AppendItemToCollection",
      "typeArg": "String",
      "props": {
        "Collection": "items"
      },
      "lists": {
        "Items": [
          {
            "lit": "apple"
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "String.Join(\",\", items)"
      }
    }
  ]
}
