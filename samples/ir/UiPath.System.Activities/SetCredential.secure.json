{
  "workflow": "SetCredential_Secure",
  "variables": [
    {
      "name": "spw",
      "type": "SecureString",
      "default": "New System.Net.NetworkCredential(\"\", \"pw\").SecurePassword"
    }
  ],
  "body": [
    {
      "act": "SetCredential",
      "props": {
        "CredentialName": {
          "lit": "IRCredential"
        },
        "FolderPath": {
          "lit": "Shared"
        },
        "SecurePassword": "spw",
        "TimeoutMS": 30000,
        "UserName": {
          "lit": "user1"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"資格情報を設定した\""
      }
    }
  ]
}
