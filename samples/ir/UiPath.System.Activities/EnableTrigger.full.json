{
  "workflow": "EnableTrigger_Full",
  "body": [
    {
      "act": "TriggerScope",
      "name": "トリガーの範囲",
      "props": {},
      "slots": {
        "Triggers": [
          {
            "act": "RepeatTrigger",
            "props": {
              "Interval": "TimeSpan.FromSeconds(1)",
              "TriggerId": "ir-repeat"
            }
          }
        ],
        "Action": [
          {
            "act": "LogMessage",
            "props": {
              "Level": "Info",
              "Message": {
                "lit": "発火した"
              }
            }
          },
          {
            "act": "StopTriggers",
            "props": {
              "ShouldStop": "stp"
            }
          }
        ]
      },
      "variables": [
        {
          "name": "stp",
          "type": "Boolean"
        }
      ],
      "item": "args"
    },
    {
      "act": "EnableTrigger",
      "name": "EnableTrigger(全部入り)",
      "props": {
        "TriggerId": "ir-repeat"
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "lit": "切り替えた"
        }
      }
    }
  ]
}
