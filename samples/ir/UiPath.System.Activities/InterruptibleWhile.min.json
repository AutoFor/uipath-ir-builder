{
  "workflow": "InterruptibleWhile_Min",
  "variables": [{ "name": "i", "type": "Int32" }],
  "body": [
    {
      "act": "InterruptibleWhile", "props": { "Condition": "i < 3" },
      "body": [
        { "act": "Assign", "props": { "To": "i", "Value": "i + 1" } },
        { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"i=\" & i.ToString" } }
      ]
    }
  ]
}
