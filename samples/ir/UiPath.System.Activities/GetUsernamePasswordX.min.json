{
  "workflow": "GetUsernamePasswordX_Min",
  "variables": [
    {
      "name": "cred",
      "type": "PasswordCredentials"
    }
  ],
  "body": [
    {
      "act": "GetUsernamePasswordX",
      "props": {
        "AutosubmitTimeoutSeconds": "10",
        "Credential": "cred",
        "CredentialName": {
          "lit": "IRCredential"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"ユーザー: \" & cred.Username"
      }
    }
  ]
}
