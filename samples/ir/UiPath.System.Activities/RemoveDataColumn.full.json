{
  "workflow": "RemoveDataColumn_Full",
  "variables": [
    {
      "name": "dt",
      "type": "DataTable",
      "default": "New DataTable()"
    }
  ],
  "body": [
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Name"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "Int32",
      "props": {
        "ColumnName": {
          "lit": "Age"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Note"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "City"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataColumn",
      "typeArg": "String",
      "props": {
        "ColumnName": {
          "lit": "Zip"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "AddDataRow",
      "props": {
        "ArrayRow": {
          "vb": "New Object() {\"Alice\", 30, \"n\", \"Tokyo\", \"100\"}",
          "cs": "new object[] {\"Alice\", 30, \"n\", \"Tokyo\", \"100\"}"
        },
        "DataTable": "dt"
      }
    },
    {
      "act": "RemoveDataColumn",
      "name": "列名で消す",
      "props": {
        "DataTable": "dt",
        "ColumnName": {
          "lit": "Note"
        }
      }
    },
    {
      "act": "RemoveDataColumn",
      "name": "列番号で消す",
      "props": {
        "DataTable": "dt",
        "ColumnIndex": 1
      }
    },
    {
      "act": "RemoveDataColumn",
      "name": "DataColumn で消す",
      "props": {
        "DataTable": "dt",
        "ColumnName": {
          "lit": "Zip"
        },
        "Column": {
          "vb": "dt.Columns(\"Zip\")",
          "cs": "dt.Columns[\"Zip\"]"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"columns=\" & String.Join(\",\", dt.Columns.Cast(Of DataColumn).Select(Function(c) c.ColumnName))",
          "cs": "\"columns=\" + string.Join(\",\", dt.Columns.Cast<DataColumn>().Select(c => c.ColumnName))"
        }
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": {
          "vb": "\"rows=\" & dt.Rows.Count.ToString",
          "cs": "\"rows=\" + dt.Rows.Count"
        }
      }
    }
  ]
}
