{
  "workflow": "FormTriggerActivity_Component",
  "variables": [
    {
      "name": "stp",
      "type": "Boolean"
    },
    {
      "name": "n",
      "type": "Int32"
    },
    {
      "name": "scr",
      "type": "ExecuteScriptResult[]"
    }
  ],
  "body": [
    {
      "act": "ShowFormActivity",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "部品"
        }
      }
    },
    {
      "act": "ExecuteScriptActivity",
      "name": "3 秒後にボタンを押して年齢を変える（人の操作の代わり）",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "部品"
        },
        "Source": {
          "lit": "setTimeout(function () { document.querySelector('button[name=\"data[greet]\"]').click(); var a = document.querySelector('input[name=\"data[age]\"]'); a.focus(); a.value = '21'; a.dispatchEvent(new Event('input', { bubbles: true })); a.blur(); }, 3000)"
        },
        "Result": "scr"
      }
    },
    {
      "act": "TriggerScope",
      "item": "args",
      "props": {
        "SchedulingMode": "Sequential"
      },
      "slots": {
        "Triggers": [
          {
            "act": "FormTriggerActivity",
            "typeArg": "FormInfoTriggerEventArgs",
            "name": "あいさつするが押された",
            "props": {
              "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
              "Event": "click.greet",
              "Tag": {
                "lit": "部品"
              }
            }
          },
          {
            "act": "FormTriggerActivity",
            "typeArg": "NumberTriggerEventArgs",
            "name": "年齢が変わった",
            "props": {
              "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
              "Event": "changed.age",
              "Tag": {
                "lit": "部品"
              }
            }
          },
          {
            "act": "RepeatTrigger",
            "name": "来なかったときに止める",
            "props": {
              "Interval": "TimeSpan.FromSeconds(20)"
            }
          }
        ],
        "Action": [
          {
            "act": "If",
            "props": {
              "Condition": "TypeOf args Is UiPath.Forms.Activities.NumberTriggerEventArgs"
            },
            "then": [
              {
                "act": "LogMessage",
                "props": {
                  "Level": "Info",
                  "Message": "\"年齢が変わった: \" & CType(args, UiPath.Forms.Activities.NumberTriggerEventArgs).Value.ToString()"
                }
              }
            ],
            "else": [
              {
                "act": "If",
                "props": {
                  "Condition": "TypeOf args Is UiPath.Forms.Activities.FormInfoTriggerEventArgs"
                },
                "then": [
                  {
                    "act": "LogMessage",
                    "props": {
                      "Level": "Info",
                      "Message": "\"押された: \" & CType(args, UiPath.Forms.Activities.FormInfoTriggerEventArgs).InstanceName"
                    }
                  }
                ],
                "else": [
                  {
                    "act": "LogMessage",
                    "props": {
                      "Level": "Warn",
                      "Message": {
                        "lit": "部品のイベントが来なかった"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "act": "Assign",
            "typeArg": "Int32",
            "props": {
              "To": "n",
              "Value": "n + 1"
            }
          },
          {
            "act": "If",
            "props": {
              "Condition": "n >= 2 OrElse TypeOf args Is UiPath.Platform.Triggers.TriggerArgs AndAlso Not TypeOf args Is UiPath.Forms.Activities.FormTriggerArgsWrapper"
            },
            "then": [
              {
                "act": "StopTriggers",
                "props": {
                  "ShouldStop": "stp"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "act": "CloseFormActivity",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "部品"
        }
      }
    }
  ]
}