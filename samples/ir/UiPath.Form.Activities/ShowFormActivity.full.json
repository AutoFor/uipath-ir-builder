{
  "workflow": "ShowFormActivity_Full",
  "variables": [
    {
      "name": "name",
      "type": "String",
      "default": "\"次郎\""
    },
    {
      "name": "age",
      "type": "Double"
    },
    {
      "name": "agree",
      "type": "Boolean"
    },
    {
      "name": "shown",
      "type": "Nullable<Boolean>"
    }
  ],
  "body": [
    {
      "act": "ShowFormActivity",
      "name": "フォームを表示",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "全部入り"
        },
        "IsAsync": "True",
        "Title": {
          "lit": "あいさつ（全部入り）"
        },
        "Width": "480",
        "Height": "360",
        "Left": "100",
        "Top": "80",
        "ShowMargin": "True",
        "ShowInTaskbar": "True",
        "TopMost": "False",
        "WindowState": "Normal",
        "Result": "shown"
      },
      "dicts": {
        "Arguments": [
          {
            "name": "name",
            "dir": "InOut",
            "type": "String",
            "value": "name"
          },
          {
            "name": "age",
            "dir": "In",
            "type": "Double",
            "value": "42"
          },
          {
            "name": "agree",
            "dir": "Out",
            "type": "Boolean",
            "value": "agree"
          }
        ]
      }
    },
    {
      "act": "GetFormFieldsActivity",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "全部入り"
        }
      },
      "dicts": {
        "Arguments": [
          {
            "name": "age",
            "dir": "Out",
            "type": "Double",
            "value": "age"
          }
        ]
      }
    },
    {
      "act": "LogMessage",
      "props": {
        "Level": "Info",
        "Message": "\"名前: \" & name & \" 年齢: \" & age.ToString()"
      }
    },
    {
      "act": "CloseFormActivity",
      "props": {
        "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a01",
        "InstanceName": {
          "lit": "全部入り"
        }
      }
    }
  ]
}
