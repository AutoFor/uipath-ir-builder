{
  "workflow": "FormTriggerActivity_Min",
  "variables": [
    { "name": "stp", "type": "Boolean" }
  ],
  "body": [
    { "act": "ShowFormActivity", "props": { "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a02" } },
    { "act": "SetFormFieldsActivity", "props": { "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a02" },
      "dicts": { "Arguments": [ { "name": "name", "dir": "In", "type": "String", "value": { "lit": "花子" } } ] } },
    { "act": "ExecuteScriptActivity", "props": { "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a02",
      "Source": { "lit": "setTimeout(function () { document.querySelector('button').click(); }, 3000)" } } },
    { "act": "TriggerScope", "item": "args", "props": {},
      "slots": {
        "Triggers": [
          { "act": "FormTriggerActivity", "typeArg": "MessageTriggerEventArgs",
            "props": { "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a02", "Event": "form.message", "MessageId": { "lit": "ok" } } }
        ],
        "Action": [
          { "act": "LogMessage", "props": { "Level": "Info", "Message": "\"メッセージ: \" & CType(args, UiPath.Forms.Activities.MessageTriggerEventArgs).Data" } },
          { "act": "StopTriggers", "props": { "ShouldStop": "stp" } }
        ]
      } },
    { "act": "CloseFormActivity", "props": { "FormId": "6f0c2a3e-9b1d-4c58-a7e2-1f3b5d7c9a02" } }
  ]
}
